<!DOCTYPE html> <html lang="en"> <head>
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png?v=2">
 <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Deposit Methods</title> <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

 <style>
  body { background:radial-gradient(ellipse at 15% 0%,#172554 0,#0b1220 38%,#070b14 100%)!important; }
  .admin-page-wrap { min-width:0; width:100%; }
  @media(max-width:1023px){ .admin-page-wrap { padding-bottom:5.25rem!important; } }
</style>
  <link rel="stylesheet" href="/css/stocker-light-theme.css">
  <link rel="stylesheet" href="/css/global-equinox-gold.css">
</head> <body class="admin-layout min-h-screen text-white">
<header class="sticky top-0 z-30 flex min-h-16 items-center justify-between border-b border-slate-700/40 bg-slate-950/75 px-4 backdrop-blur-xl sm:px-6">
  <div class="flex min-w-0 items-center gap-3"><button id="admin-menu-toggle" type="button" onclick="adminSetSidebar(true)" class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-slate-200 lg:hidden" aria-label="Open admin menu"><i data-lucide="menu" class="h-5 w-5"></i></button><span class="truncate text-sm font-semibold text-slate-100">Global Equinox Trade <span class="font-normal text-slate-500">/ Admin</span></span></div>
  <a href="/admin" class="hidden rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300 hover:text-white sm:inline-flex">Admin overview</a>
</header>
<%- include('sidebar', { currentPath: '/admin/deposit-methods' }) %>
<div class="admin-page-wrap">
  <div class="w-full bg-slate-900 border-b border-slate-800 p-4 flex items-center justify-between"> <div> <p class="text-sm font-semibold">Deposit methods</p> <p class="text-xs text-slate-400">Add, rename or enable and disable methods</p> </div> <a href="/admin" class="bg-slate-800 px-4 py-2 rounded text-sm"> Back to dashboard </a> </div> <div class="max-w-4xl mx-auto p-6 space-y-6">
<!-- Add new -->
<section class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
  <p class="text-sm font-semibold mb-3">Add new method</p>
  <form action="/admin/deposit-methods/add" method="POST" class="flex gap-3 text-sm">
    <input
      type="text"
      name="name"
      placeholder="Method name, example: CashApp"
      required
      class="flex-1 px-3 py-2 rounded-lg bg-slate-800 border border-slate-700">
    <button class="px-4 py-2 rounded-lg bg-blue-600 font-semibold">
      Add
    </button>
  </form>
</section>

<!-- List methods -->
<section class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg text-xs">
  <p class="text-sm font-semibold mb-4">Existing methods</p>

  <% if (!methods || methods.length === 0) { %>
    <p class="text-slate-500">No methods yet.</p>
  <% } else { %>
    <div class="space-y-3">
      <% methods.forEach(m => { %>
        <div class="flex items-center gap-3 border border-slate-800 rounded-xl px-3 py-3 bg-slate-950/60">

          <form action="/admin/deposit-methods/edit" method="POST" class="flex-1 flex flex-col sm:flex-row gap-3">
  <input type="hidden" name="id" value="<%= m.id %>">

  <input
    type="text"
    name="name"
    value="<%= m.name %>"
    class="flex-1 px-3 py-2 rounded-lg bg-slate-800 border border-slate-700">

  <input
    type="text"
    name="details"
    placeholder="Wallet address or payment details"
    value="<%= m.details %>"
    class="flex-1 px-3 py-2 rounded-lg bg-slate-800 border border-slate-700">

  <label class="flex items-center gap-1 text-slate-300">
    <input
      type="checkbox"
      name="enabled"
      <%= m.enabled === false ? '' : 'checked' %>>
    <span>Enabled</span>
  </label>

  <button class="px-3 py-2 rounded-lg bg-blue-600">
    Save
  </button>
</form>

          <form action="/admin/deposit-methods/delete" method="POST">
            <input type="hidden" name="id" value="<%= m.id %>">
            <button
              class="px-3 py-2 rounded-lg bg-red-600"
              onclick="return confirm('Delete this method?')">
              Delete
            </button>
          </form>

        </div>
      <% }) %>
    </div>
  <% } %>

</section>

</div> 
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

</div>
<script>document.addEventListener("DOMContentLoaded",function(){if(typeof lucide!=="undefined")lucide.createIcons();});</script>
</body> </html>