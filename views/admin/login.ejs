<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Login</title>
  
  <!-- Font Awesome for eye icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <script src="https://cdn.tailwindcss.com"></script>
  
  <style>
    .password-toggle {
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .password-toggle:hover {
      opacity: 0.8;
    }
  </style>
</head>

<body class="bg-gray-900 text-white flex items-center justify-center h-screen px-4">
  <div class="w-full max-w-md bg-gray-800 p-8 rounded-xl shadow-xl border border-gray-700">
    
    <div class="flex flex-col items-center mb-8">
      <img src="/temp/custom/img/logo.png" width="80" class="mb-4">
      <h2 class="text-center text-2xl font-semibold">Admin Login</h2>
      <p class="text-gray-400 text-sm mt-2">Secure administrator access</p>
    </div>

    <form action="/admin-login" method="POST">

      <div class="mb-6">
        <label class="block mb-2 text-sm font-medium">Username</label>
        <input 
          type="text" 
          name="username" 
          class="w-full p-3 bg-gray-700 rounded-lg outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 border border-gray-600"
          placeholder="Enter admin username"
          required
          autocomplete="username"
          autofocus
        >
      </div>

      <div class="mb-8">
        <label class="block mb-2 text-sm font-medium">Password</label>
        <div class="relative">
          <input 
            type="password" 
            name="password" 
            id="adminPassword"
            class="w-full p-3 bg-gray-700 rounded-lg outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 border border-gray-600 pr-12"
            placeholder="Enter admin password"
            required
            autocomplete="current-password"
          >
          <button 
            type="button"
            id="toggleAdminPassword"
            class="password-toggle absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400 hover:text-gray-300 focus:outline-none"
            aria-label="Toggle password visibility"
          >
            <i class="far fa-eye" id="adminEyeIcon"></i>
          </button>
        </div>
        <div class="flex justify-end mt-2">
          <a href="/contact" class="text-sm text-blue-400 hover:text-blue-300 transition">Forgot password?</a>
        </div>
      </div>

      <div class="flex items-center mb-6">
        <input 
          type="checkbox" 
          id="adminRemember"
          name="remember"
          class="h-4 w-4 rounded border-gray-600 bg-gray-700 text-blue-600 focus:ring-blue-500 focus:ring-offset-gray-800"
        >
        <label for="adminRemember" class="ml-2 text-sm text-gray-300">Keep me logged in</label>
      </div>

      <button 
        type="submit"
        class="w-full bg-blue-600 hover:bg-blue-700 p-3 rounded-lg text-center font-semibold transition duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-gray-800"
      >
        <i class="fas fa-sign-in-alt mr-2"></i>
        Login to Admin Panel
      </button>

    </form>

    <div class="mt-6 pt-6 border-t border-gray-700">
      <p class="text-center text-sm text-gray-400">
        <i class="fas fa-shield-alt mr-1"></i>
        For authorized personnel only
      </p>
      <p class="text-center text-xs text-gray-500 mt-2">
        All activities are logged and monitored
      </p>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    // Admin password toggle functionality
    document.addEventListener('DOMContentLoaded', function() {
      const toggleAdminPassword = document.getElementById('toggleAdminPassword');
      const adminPasswordInput = document.getElementById('adminPassword');
      const adminEyeIcon = document.getElementById('adminEyeIcon');
      
      if (toggleAdminPassword && adminPasswordInput) {
        toggleAdminPassword.addEventListener('click', function() {
          const type = adminPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
          adminPasswordInput.setAttribute('type', type);
          
          if (type === 'text') {
            adminEyeIcon.classList.remove('fa-eye');
            adminEyeIcon.classList.add('fa-eye-slash');
            this.setAttribute('aria-label', 'Hide password');
          } else {
            adminEyeIcon.classList.remove('fa-eye-slash');
            adminEyeIcon.classList.add('fa-eye');
            this.setAttribute('aria-label', 'Show password');
          }
        });
        
        // Keyboard accessibility
        toggleAdminPassword.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.click();
          }
        });
        
        // Security warning for password visibility
        adminPasswordInput.addEventListener('input', function() {
          if (this.getAttribute('type') === 'text' && this.value.length > 0) {
            console.warn('Admin password is visible on screen');
          }
        });
      }
      
      // Auto-focus username field
      const usernameInput = document.querySelector('input[name="username"]');
      if (usernameInput && !usernameInput.value) {
        usernameInput.focus();
      }
    });
  </script>

  <% if (toast) { %>
  <script>
    Swal.fire({
      icon: '<%= toast.type %>',
      title: '<%= toast.message %>',
      toast: true,
      position: 'top',
      showConfirmButton: false,
      timer: 2500,
      background: '#1f2937',
      color: '#fff',
      iconColor: '<%= toast.type === "success" ? "#10b981" : toast.type === "error" ? "#ef4444" : toast.type === "warning" ? "#f59e0b" : "#3b82f6" %>',
      customClass: {
        popup: 'border border-gray-600'
      }
    })
  </script>
  <% } %>
</body>
</html>
