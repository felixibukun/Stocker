<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=yes">
  <title>Users | Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <style>
    body {
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    button, a {
      min-height: 44px;
      min-width: 44px;
    }

    .break-all { word-break: break-all; }

    ::-webkit-scrollbar { height: 8px; width: 8px; }
    ::-webkit-scrollbar-track { background: #0b0f1a; }
    ::-webkit-scrollbar-thumb { background: rgba(99,102,241,0.3); border-radius: 999px; }

    .row-hover { transition: background-color .15s ease; }
    .row-hover:hover { background-color: rgba(255,255,255,0.03); }
  </style>
</head>

<body class="bg-[#0b0f1a] text-slate-200 min-h-screen">

  <div class="sticky top-0 z-10 backdrop-blur bg-[#0b0f1a]/80 border-b border-white/10 px-4 sm:px-8 py-4 sm:py-5 flex justify-between items-center">
    <div>
      <h1 class="text-xl sm:text-2xl font-semibold tracking-tight">Users</h1>
      <p class="text-xs text-slate-500 mt-0.5"><%= users ? users.length : 0 %> account<%= users && users.length === 1 ? '' : 's' %></p>
    </div>
    <a href="/admin" class="text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 transition flex items-center gap-1.5">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Back</span>
    </a>
  </div>

  <div class="p-4 sm:p-8 max-w-[1500px] mx-auto">

    <% if (!users || users.length === 0) { %>
      <div class="text-center py-16 bg-white/5 border border-white/10 rounded-2xl">
        <i data-lucide="users" class="w-10 h-10 mx-auto text-slate-600 mb-3"></i>
        <p class="text-slate-400">No users found</p>
      </div>
    <% } %>

    <!-- Mobile: stacked cards -->
    <div class="md:hidden space-y-3">
      <% users.forEach(u => { %>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-base font-semibold text-white truncate"><%= u.name %></p>
              <p class="text-sm text-slate-400">@<%= u.username %></p>
            </div>
            <span class="text-[11px] px-2 py-1 rounded-full bg-slate-800 text-slate-400 shrink-0">ID <%= u.id %></span>
          </div>

          <div class="mt-3 pt-3 border-t border-white/10 space-y-1.5 text-sm">
            <p class="text-slate-500 break-all"><%= u.email %></p>
            <div class="flex items-center justify-between gap-2">
              <span class="text-slate-500 text-xs uppercase tracking-wide">Phone</span>
              <span class="text-slate-300"><%= u.phone || 'N/A' %></span>
            </div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-slate-500 text-xs uppercase tracking-wide">Country</span>
              <span class="text-slate-300"><%= u.country %></span>
            </div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-slate-500 text-xs uppercase tracking-wide">Balance</span>
              <span class="text-emerald-400 font-medium">$<%= Number(u.balance || 0).toFixed(2) %></span>
            </div>
          </div>

          <div class="mt-3 pt-3 border-t border-white/10">
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-slate-500 text-xs uppercase tracking-wide">Signal</span>
              <form action="/admin/user/<%= u.id %>/signal" method="POST" class="flex items-center gap-1.5">
                <button name="action" value="decrease" class="px-2 py-1.5 text-xs rounded bg-red-500/20 text-red-300 hover:bg-red-500/30 flex items-center justify-center">
                  <i data-lucide="minus" class="w-3 h-3"></i>
                </button>
                <span class="px-2.5 py-1.5 text-xs rounded bg-slate-700 text-slate-200 font-semibold min-w-[48px] text-center">
                  <%= u.signalLevel %>%
                </span>
                <button name="action" value="increase" class="px-2 py-1.5 text-xs rounded bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 flex items-center justify-center">
                  <i data-lucide="plus" class="w-3 h-3"></i>
                </button>
              </form>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <form action="/admin/user/<%= u.id %>/login" method="POST" class="flex-1">
                <button type="submit" class="w-full px-3 py-2 rounded-md text-xs bg-blue-500/20 text-blue-300 hover:bg-blue-500/30 transition flex items-center justify-center gap-1.5">
                  <i data-lucide="log-in" class="w-3.5 h-3.5"></i>
                  <span>Open</span>
                </button>
              </form>
              <a href="/admin/user/<%= u.id %>/balance" class="flex-1 px-3 py-2 rounded-md text-xs bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 transition flex items-center justify-center gap-1.5">
                <i data-lucide="dollar-sign" class="w-3.5 h-3.5"></i>
                <span>Balance</span>
              </a>
              <form action="/admin/user/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Delete this user and all related data?')">
                <button class="p-2.5 rounded-md bg-red-500/20 hover:bg-red-500/30 transition flex items-center justify-center">
                  <i data-lucide="trash-2" class="w-4 h-4 text-red-400"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Desktop: table -->
    <div class="hidden md:block bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[980px] text-left">
          <thead>
            <tr class="border-b border-white/10 bg-white/[0.02]">
              <th class="px-4 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-400">Name</th>
              <th class="px-4 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-400">Contact</th>
              <th class="px-4 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-400">Location</th>
              <th class="px-4 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-400">Balance</th>
              <th class="px-4 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-400">Signal</th>
              <th class="px-4 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-400 text-right">Action</th>
            </tr>
          </thead>

          <tbody>
            <% users.forEach(u => { %>
              <tr class="border-b border-white/5 align-top row-hover">
                <td class="px-4 py-4">
                  <div class="font-semibold text-white"><%= u.name %></div>
                  <div class="text-xs text-slate-500 mt-0.5">@<%= u.username %> &middot; ID <%= u.id %></div>
                </td>

                <td class="px-4 py-4">
                  <div class="text-slate-300 text-sm break-all"><%= u.email %></div>
                  <div class="text-xs text-slate-500 mt-0.5"><%= u.phone || 'N/A' %></div>
                </td>

                <td class="px-4 py-4 text-slate-300 text-sm">
                  <%= u.country || 'N/A' %>
                </td>

                <td class="px-4 py-4">
                  <span class="text-emerald-400 font-medium">$<%= Number(u.balance || 0).toFixed(2) %></span>
                </td>

                <td class="px-4 py-4">
                  <form action="/admin/user/<%= u.id %>/signal" method="POST" class="flex items-center gap-1.5">
                    <button name="action" value="decrease" class="px-2 py-1 text-xs rounded bg-red-500/20 text-red-300 hover:bg-red-500/30 flex items-center justify-center">
                      <i data-lucide="minus" class="w-3 h-3"></i>
                    </button>
                    <span class="px-2 py-1 text-xs rounded bg-slate-700 text-slate-200 font-semibold min-w-[45px] text-center">
                      <%= u.signalLevel %>%
                    </span>
                    <button name="action" value="increase" class="px-2 py-1 text-xs rounded bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 flex items-center justify-center">
                      <i data-lucide="plus" class="w-3 h-3"></i>
                    </button>
                  </form>
                </td>

                <td class="px-4 py-4">
                  <div class="flex flex-wrap items-center justify-end gap-2">
                    <form action="/admin/user/<%= u.id %>/login" method="POST">
                      <button type="submit" class="px-3 py-1.5 rounded-md text-xs bg-blue-500/20 text-blue-300 hover:bg-blue-500/30 transition flex items-center gap-1.5">
                        <i data-lucide="log-in" class="w-3.5 h-3.5"></i>
                        <span>Open</span>
                      </button>
                    </form>
                    <a href="/admin/user/<%= u.id %>/balance" class="px-3 py-1.5 rounded-md text-xs bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 transition flex items-center gap-1.5">
                      <i data-lucide="dollar-sign" class="w-3.5 h-3.5"></i>
                      <span>Balance</span>
                    </a>
                    <form action="/admin/user/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Delete this user and all related data?')">
                      <button class="p-2 rounded-md bg-red-500/20 hover:bg-red-500/30 transition flex items-center justify-center">
                        <i data-lucide="trash-2" class="w-4 h-4 text-red-400"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
</body>
</html>
