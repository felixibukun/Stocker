<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png?v=2">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KYC Requests</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<style>
  body { background:radial-gradient(ellipse at 15% 0%,#172554 0,#0b1220 38%,#070b14 100%)!important; }
  .admin-page-wrap { min-width:0; width:100%; }
  @media(max-width:1023px){ .admin-page-wrap { padding-bottom:5.25rem!important; } }
</style>
  <link rel="stylesheet" href="/css/stocker-light-theme.css">
  <link rel="stylesheet" href="/css/global-equinox-gold.css">
</head>

<body class="admin-layout min-h-screen text-white">
<header class="sticky top-0 z-30 flex min-h-16 items-center justify-between border-b border-slate-700/40 bg-slate-950/75 px-4 backdrop-blur-xl sm:px-6">
  <div class="flex min-w-0 items-center gap-3"><button id="admin-menu-toggle" type="button" onclick="adminSetSidebar(true)" class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-slate-200 lg:hidden" aria-label="Open admin menu"><i data-lucide="menu" class="h-5 w-5"></i></button><span class="truncate text-sm font-semibold text-slate-100">Global Equinox Trade <span class="font-normal text-slate-500">/ Admin</span></span></div>
  <a href="/admin" class="hidden rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300 hover:text-white sm:inline-flex">Admin overview</a>
</header>
<%- include('sidebar', { currentPath: '/admin/kyc' }) %>
<div class="admin-page-wrap">

<div class="w-full bg-slate-900 border-b border-slate-800 p-4 flex items-center justify-between">
  <div>
    <p class="text-sm font-semibold">KYC requests</p>
    <p class="text-xs text-slate-400">Review and approve user verification</p>
  </div>
  <a href="/admin" class="bg-slate-800 px-4 py-2 rounded text-sm">
    Back to dashboard
  </a>
</div>

<div class="p-6 max-w-6xl mx-auto">

  <div class="mb-4 text-xs text-slate-400">
    Total requests:
    <span class="text-slate-100 font-semibold"><%= kycRequests.length %></span>
    · Pending:
    <span class="text-amber-400 font-semibold">
      <%= kycRequests.filter(r => r.status === 'pending').length %>
    </span>
  </div>

  <div class="overflow-x-auto bg-slate-900 border border-slate-800 rounded-2xl shadow-lg text-xs">
    <table class="w-full text-left">
      <thead class="bg-slate-800 text-slate-300">
        <tr>
          <th class="px-4 py-3">User</th>
          <th class="px-4 py-3">Document</th>
          <th class="px-4 py-3">Number</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Action</th>
          <th class="px-4 py-3">ID images</th>
        </tr>
      </thead>

      <tbody>
        <% if (!kycRequests || kycRequests.length === 0) { %>
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-slate-500">No KYC requests found.</td>
          </tr>
        <% } else { %>
        <% kycRequests.forEach(r => { %>
          <tr class="border-t border-slate-800">

            <td class="px-4 py-3"><%= r.userName %></td>

            <td class="px-4 py-3"><%= r.documentType %></td>

            <td class="px-4 py-3"><%= r.documentNumber %></td>

            <td class="px-4 py-3">
              <% if (r.status === 'approved') { %>
                <span class="text-emerald-400 font-semibold">Approved</span>
              <% } else if (r.status === 'rejected') { %>
                <span class="text-red-400 font-semibold">Rejected</span>
              <% } else { %>
                <span class="text-amber-400 font-semibold">Pending</span>
              <% } %>
            </td>

            <td class="px-4 py-3">
              <%= (r.createdAt || r.date) ? new Date(r.createdAt || r.date).toLocaleString() : 'N/A' %>
            </td>

            <td class="px-4 py-3">
              <% if (r.status === 'pending') { %>
                <div class="flex gap-2">
                  <form action="/admin/kyc/approve" method="POST">
                    <input type="hidden" name="id" value="<%= r.id %>">
                    <button class="px-3 py-1 rounded bg-emerald-600 text-white">
                      Approve
                    </button>
                  </form>

                  <form action="/admin/kyc/reject" method="POST">
                    <input type="hidden" name="id" value="<%= r.id %>">
                    <button class="px-3 py-1 rounded bg-red-600 text-white">
                      Reject
                    </button>
                  </form>
                </div>
              <% } else { %>
                <span class="text-slate-500">No actions</span>
              <% } %>
            </td>

            <td class="px-4 py-3">
              <div class="flex flex-col gap-1">
                <% if (r.idFront) { %>
                  <a href="/uploads/<%= r.idFront %>" target="_blank" class="text-blue-400">
                    View front
                  </a>
                <% } %>

                <% if (r.idBack) { %>
                  <a href="/uploads/<%= r.idBack %>" target="_blank" class="text-blue-400">
                    View back
                  </a>
                <% } %>
              </div>
            </td>

          </tr>
        <% }) %>
        <% } %>
      </tbody>

    </table>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>


</div>
<script>document.addEventListener("DOMContentLoaded",function(){if(typeof lucide!=="undefined")lucide.createIcons();});</script>
</body>
</html>
