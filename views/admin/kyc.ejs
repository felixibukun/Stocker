<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>KYC Requests</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-950 text-white min-h-screen">

<div class="w-full bg-slate-900 border-b border-slate-800 p-4 flex items-center justify-between">
  <div>
    <p class="text-sm font-semibold">KYC requests</p>
    <p class="text-xs text-slate-400">Review and approve user verification</p>
  </div>
  <a href="/admin" class="bg-slate-800 px-4 py-2 rounded text-sm">
    Back to dashboard
  </a>
</div>

<div class="p-6 max-w-6xl mx-auto">

  <div class="mb-4 text-xs text-slate-400">
    Total requests:
    <span class="text-slate-100 font-semibold"><%= kycRequests.length %></span>
    · Pending:
    <span class="text-amber-400 font-semibold">
      <%= kycRequests.filter(r => r.status === 'pending').length %>
    </span>
  </div>

  <div class="overflow-x-auto bg-slate-900 border border-slate-800 rounded-2xl shadow-lg text-xs">
    <table class="w-full text-left">
      <thead class="bg-slate-800 text-slate-300">
        <tr>
          <th class="px-4 py-3">User</th>
          <th class="px-4 py-3">Document</th>
          <th class="px-4 py-3">Number</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Action</th>
          <th class="px-4 py-3">ID images</th>
        </tr>
      </thead>

      <tbody>
        <% if (!kycRequests || kycRequests.length === 0) { %>
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-slate-500">No KYC requests found.</td>
          </tr>
        <% } else { %>
        <% kycRequests.forEach(r => { %>
          <tr class="border-t border-slate-800">

            <td class="px-4 py-3"><%= r.userName %></td>

            <td class="px-4 py-3"><%= r.documentType %></td>

            <td class="px-4 py-3"><%= r.documentNumber %></td>

            <td class="px-4 py-3">
              <% if (r.status === 'approved') { %>
                <span class="text-emerald-400 font-semibold">Approved</span>
              <% } else if (r.status === 'rejected') { %>
                <span class="text-red-400 font-semibold">Rejected</span>
              <% } else { %>
                <span class="text-amber-400 font-semibold">Pending</span>
              <% } %>
            </td>

            <td class="px-4 py-3">
              <%= (r.createdAt || r.date) ? new Date(r.createdAt || r.date).toLocaleString() : 'N/A' %>
            </td>

            <td class="px-4 py-3">
              <% if (r.status === 'pending') { %>
                <div class="flex gap-2">
                  <form action="/admin/kyc/approve" method="POST">
                    <input type="hidden" name="id" value="<%= r.id %>">
                    <button class="px-3 py-1 rounded bg-emerald-600 text-white">
                      Approve
                    </button>
                  </form>

                  <form action="/admin/kyc/reject" method="POST">
                    <input type="hidden" name="id" value="<%= r.id %>">
                    <button class="px-3 py-1 rounded bg-red-600 text-white">
                      Reject
                    </button>
                  </form>
                </div>
              <% } else { %>
                <span class="text-slate-500">No actions</span>
              <% } %>
            </td>

            <td class="px-4 py-3">
              <div class="flex flex-col gap-1">
                <% if (r.idFront) { %>
                  <a href="/uploads/<%= r.idFront %>" target="_blank" class="text-blue-400">
                    View front
                  </a>
                <% } %>

                <% if (r.idBack) { %>
                  <a href="/uploads/<%= r.idBack %>" target="_blank" class="text-blue-400">
                    View back
                  </a>
                <% } %>
              </div>
            </td>

          </tr>
        <% }) %>
        <% } %>
      </tbody>

    </table>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

</body>
</html>
