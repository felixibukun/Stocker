<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Database Recovery</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<style>
  body { background:radial-gradient(ellipse at 15% 0%,#172554 0,#0b1220 38%,#070b14 100%)!important; }
  .admin-page-wrap { min-width:0; width:100%; }
  @media(max-width:1023px){ .admin-page-wrap { padding-bottom:5.25rem!important; } }
</style>
</head>
<body class="admin-layout min-h-screen text-white">
<%- include('sidebar', { currentPath: '/admin/database/recovery' }) %>
<header class="sticky top-0 z-30 flex min-h-16 items-center justify-between border-b border-slate-700/40 bg-slate-950/75 px-4 backdrop-blur-xl sm:px-6">
  <div class="flex min-w-0 items-center gap-3"><button id="admin-menu-toggle" type="button" onclick="adminSetSidebar(true)" class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-slate-200 lg:hidden" aria-label="Open admin menu"><i data-lucide="menu" class="h-5 w-5"></i></button><span class="truncate text-sm font-semibold text-slate-100">Global Equinox Trade <span class="font-normal text-slate-500">/ Admin</span></span></div>
  <a href="/admin" class="hidden rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300 hover:text-white sm:inline-flex">Admin overview</a>
</header>

  <div class="admin-page-wrap min-h-screen lg:ml-0">

    <main class="mx-auto w-full max-w-[1500px] p-4 sm:p-6 lg:p-10">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl font-semibold">Database Recovery</h1>
          <p class="text-sm text-slate-400">Check JSON database status and restore from available backups.</p>
        </div>
        <a href="/admin" class="px-4 py-2 rounded bg-slate-800 text-sm hover:bg-slate-700">Back</a>
      </div>

      <div class="overflow-x-auto border border-slate-800 rounded-lg">
        <table class="w-full text-sm">
          <thead class="bg-slate-900 text-slate-400">
            <tr>
              <th class="text-left px-4 py-3">Database</th>
              <th class="text-left px-4 py-3">Status</th>
              <th class="text-right px-4 py-3">Size</th>
              <th class="text-left px-4 py-3">Backup</th>
              <th class="text-right px-4 py-3">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <% databases.forEach(db => { %>
              <tr class="bg-slate-950">
                <td class="px-4 py-3 font-medium"><%= db.name %></td>
                <td class="px-4 py-3"><%= db.status %></td>
                <td class="px-4 py-3 text-right"><%= db.size ? db.size + ' bytes' : '-' %></td>
                <td class="px-4 py-3"><%= db.backupExists ? 'Available' : 'Missing' %></td>
                <td class="px-4 py-3 text-right">
                  <% if (db.backupExists) { %>
                    <form action="/admin/database/restore" method="POST" onsubmit="return confirm('Restore <%= db.name %> from backup?')">
                      <input type="hidden" name="database" value="<%= db.name %>">
                      <button class="px-3 py-2 rounded bg-amber-600 text-xs font-semibold hover:bg-amber-700">Restore</button>
                    </form>
                  <% } else { %>
                    <span class="text-xs text-slate-500">No backup</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

<script>document.addEventListener("DOMContentLoaded",function(){if(typeof lucide!=="undefined")lucide.createIcons();});</script>
</body>
</html>
