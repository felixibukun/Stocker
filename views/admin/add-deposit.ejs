<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png?v=2">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Deposit</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<style>
  body { background:radial-gradient(ellipse at 15% 0%,#172554 0,#0b1220 38%,#070b14 100%)!important; }
  .admin-page-wrap { min-width:0; width:100%; }
  @media(max-width:1023px){ .admin-page-wrap { padding-bottom:5.25rem!important; } }
</style>
  <link rel="stylesheet" href="/css/stocker-light-theme.css">
  <link rel="stylesheet" href="/css/global-equinox-gold.css">
</head>

<body class="admin-layout min-h-screen text-white">
<header class="sticky top-0 z-30 flex min-h-16 items-center justify-between border-b border-slate-700/40 bg-slate-950/75 px-4 backdrop-blur-xl sm:px-6">
  <div class="flex min-w-0 items-center gap-3"><button id="admin-menu-toggle" type="button" onclick="adminSetSidebar(true)" class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-slate-200 lg:hidden" aria-label="Open admin menu"><i data-lucide="menu" class="h-5 w-5"></i></button><span class="truncate text-sm font-semibold text-slate-100">Global Equinox Trade <span class="font-normal text-slate-500">/ Admin</span></span></div>
  <a href="/admin" class="hidden rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300 hover:text-white sm:inline-flex">Admin overview</a>
</header>
<%- include('sidebar', { currentPath: '/admin/deposit/add' }) %>
<div class="admin-page-wrap">
  <header class="border-b border-slate-800 bg-slate-950/90 backdrop-blur-xl">
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold">Manual deposit</p>
        <p class="text-xs text-slate-400">Credit a user wallet from the admin panel</p>
      </div>
      <a href="/admin/deposits" class="px-4 py-2 rounded-lg bg-slate-800 text-sm hover:bg-slate-700">
        Back
      </a>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
      <form action="/admin/deposit/add" method="POST" class="space-y-5">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-2">User</label>
          <select name="userId" class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-sm outline-none focus:border-blue-500" required>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.username %> (<%= u.email %>)</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-2">Amount</label>
          <input
            type="number"
            min="0.01"
            step="0.01"
            name="amount"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-sm outline-none focus:border-blue-500"
            required>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-2">Method</label>
          <input
            type="text"
            name="method"
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-sm outline-none focus:border-blue-500"
            placeholder="Bank transfer, USDT, BTC, CashApp"
            required>
        </div>

        <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-100">
          Manual deposits are approved immediately and added to the user's deposit balance.
        </div>

        <button class="w-full px-5 py-3 rounded-xl bg-emerald-600 text-sm font-semibold hover:bg-emerald-700">
          Save approved deposit
        </button>
      </form>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (toast) { %>
    <script>
      Swal.fire({
        icon: '<%= toast.type %>',
        title: '<%= toast.message %>',
        toast: true,
        position: 'top',
        showConfirmButton: false,
        timer: 2500,
        background: '#0f172a',
        color: '#fff'
      })
    </script>
  <% } %>

</div>
<script>document.addEventListener("DOMContentLoaded",function(){if(typeof lucide!=="undefined")lucide.createIcons();});</script>
</body>
</html>
