<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png?v=2">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Payment Settings</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<style>
  body { background:radial-gradient(ellipse at 15% 0%,#172554 0,#0b1220 38%,#070b14 100%)!important; }
  .admin-page-wrap { min-width:0; width:100%; }
  @media(max-width:1023px){ .admin-page-wrap { padding-bottom:5.25rem!important; } }
</style>
  <link rel="stylesheet" href="/css/stocker-light-theme.css">
  <link rel="stylesheet" href="/css/global-equinox-gold.css">
</head>

<body class="admin-layout min-h-screen text-white">
<header class="sticky top-0 z-30 flex min-h-16 items-center justify-between border-b border-slate-700/40 bg-slate-950/75 px-4 backdrop-blur-xl sm:px-6">
  <div class="flex min-w-0 items-center gap-3"><button id="admin-menu-toggle" type="button" onclick="adminSetSidebar(true)" class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-slate-200 lg:hidden" aria-label="Open admin menu"><i data-lucide="menu" class="h-5 w-5"></i></button><span class="truncate text-sm font-semibold text-slate-100">Global Equinox Trade <span class="font-normal text-slate-500">/ Admin</span></span></div>
  <a href="/admin" class="hidden rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300 hover:text-white sm:inline-flex">Admin overview</a>
</header>
<%- include('sidebar', { currentPath: '/admin/payment-settings' }) %>
<div class="admin-page-wrap">
  <header class="border-b border-slate-800 bg-slate-950/90 backdrop-blur-xl">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold">Payment settings</p>
        <p class="text-xs text-slate-400">Update deposit instructions shown to users</p>
      </div>
      <a href="/admin" class="px-4 py-2 rounded-lg bg-slate-800 text-sm hover:bg-slate-700">
        Back to dashboard
      </a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-8">
    <% if (!methods || methods.length === 0) { %>
      <section class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <p class="text-slate-300 font-semibold">No deposit methods yet.</p>
        <p class="text-sm text-slate-500 mt-1">Add methods first, then return here to set payment details.</p>
        <a href="/admin/deposit-methods" class="inline-flex mt-5 px-4 py-2 rounded-lg bg-blue-600 text-sm font-semibold hover:bg-blue-700">
          Add deposit methods
        </a>
      </section>
    <% } else { %>
      <form action="/admin/payment-settings" method="POST" class="space-y-5">
        <% methods.forEach(method => { %>
          <section class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
              <div>
                <label for="details-<%= method.id %>" class="block font-semibold text-white">
                  <%= method.name %>
                </label>
                <p class="text-xs text-slate-500">Wallet address, account details, or exact payment instructions.</p>
              </div>
              <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                <input
                  type="checkbox"
                  name="enabled[<%= method.id %>]"
                  class="h-4 w-4 rounded border-slate-700 bg-slate-800"
                  <%= method.enabled === false ? '' : 'checked' %>>
                Enabled
              </label>
            </div>

            <textarea
              id="details-<%= method.id %>"
              name="details[<%= method.id %>]"
              rows="3"
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white outline-none focus:border-blue-500"
              placeholder="Enter payment details users should follow"><%= method.details || '' %></textarea>
          </section>
        <% }) %>

        <div class="flex flex-col sm:flex-row gap-3 sm:justify-end">
          <a href="/admin/deposit-methods" class="px-5 py-3 rounded-xl bg-slate-800 text-sm font-semibold text-center hover:bg-slate-700">
            Manage methods
          </a>
          <button class="px-5 py-3 rounded-xl bg-blue-600 text-sm font-semibold hover:bg-blue-700">
            Save payment settings
          </button>
        </div>
      </form>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% if (toast) { %>
    <script>
      Swal.fire({
        icon: '<%= toast.type %>',
        title: '<%= toast.message %>',
        toast: true,
        position: 'top',
        showConfirmButton: false,
        timer: 2500,
        background: '#0f172a',
        color: '#fff'
      })
    </script>
  <% } %>

</div>
<script>document.addEventListener("DOMContentLoaded",function(){if(typeof lucide!=="undefined")lucide.createIcons();});</script>
</body>
</html>
