      <a href="/pricing" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="credit-card"></i> Pricing</a>
      <a href="/education" class="flex items-center gap-3 text-lg font-medium py-3" style="color:#8a6815"><i data-lucide="graduation-cap"></i> Education</a>
