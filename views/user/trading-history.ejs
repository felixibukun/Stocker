<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Trading History</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-950 text-white">

<header class="h-16 border-b border-slate-800 bg-slate-950/80 backdrop-blur-xl flex items-center">
  <div class="max-w-5xl mx-auto w-full px-4 flex justify-between">
    <p class="text-sm font-semibold">Trading History</p>
    <a href="/dashboard" class="text-xs text-slate-300 hover:text-white">Back</a>
  </div>
</header>

<main class="max-w-5xl mx-auto px-4 py-8">

  <div class="bg-slate-900/80 rounded-2xl border border-slate-800 p-6">
    <p class="text-sm font-semibold mb-4 text-slate-100">Your Trades</p>

    <% if (!trades || trades.length === 0) { %>
      <p class="text-xs text-slate-500">No trades found</p>
    <% } else { %>
      <div class="space-y-2 text-xs">

        <% trades.forEach(t => { %>
          <div class="flex justify-between border-b border-slate-800 pb-1">

            <span>
              <%= t.side %> <%= t.stockName %> (<%= t.symbol %>)
              · Qty <%= t.quantity %> @ $<%= t.price %>
            </span>

            <span>
              P L $<%= (t.profit || 0).toFixed(2) %>
            </span>

          </div>
        <% }) %>

      </div>
    <% } %>

  </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

<%- include('partials/mobile-bankbar') %>
</body>
</html>
