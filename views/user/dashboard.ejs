                  </div>

                  <% if (trade.status === 'open') { %>
  <span class="text-sm text-amber-400">Open</span>
<% } else { %>
  <span class="text-sm <%= Number(trade.profit || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
