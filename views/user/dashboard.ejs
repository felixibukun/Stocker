<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=yes">
  <title>Dashboard - <%= user.name || user.username %></title>

  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            primary: { 600: '#4F46E5', 700: '#4338ca', 500: '#6366f1' },
            success: '#10b981',
            warning: '#f59e0b',
            danger: '#ef4444',
            long: '#10b981',
            short: '#ef4444'
          },
          animation: {
            'slide-in': 'slideIn 0.3s ease-out',
            'fade-in': 'fadeIn 0.3s ease-in',
            'pulse-slow': 'pulse 3s infinite'
          },
          keyframes: {
            slideIn: {
              '0%': { transform: 'translateX(-100%)' },
              '100%': { transform: 'translateX(0)' }
            },
            fadeIn: {
              '0%': { opacity: 0 },
              '100%': { opacity: 1 }
            }
          }
        }
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js" defer></script>

  <style>
    body { overflow-x: hidden; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

    .sidebar-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 40;
      backdrop-filter: blur(4px);
      transition: opacity .3s ease;
    }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 280px;
      background: #0f172a;
      border-right: 1px solid #1e293b;
      z-index: 50;
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform .3s ease;
    }

    .sidebar.open { transform: translateX(0); }

    @media (max-width: 767px) {
      .sidebar.open ~ .sidebar-overlay { display: block; }
    }

    .main-content { width: 100%; transition: margin-left .3s ease; }

    @media (min-width: 768px) {
      .sidebar.open ~ .main-content { margin-left: 280px; }
    }

    .nav-active { background: #4F46E5; color: white; }
    .nav-item:hover { background: rgba(255,255,255,0.05); }

    .sidebar::-webkit-scrollbar { width: 6px; }
    .sidebar::-webkit-scrollbar-track { background: #1e293b; }
    .sidebar::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }

    i[data-lucide] { width: 18px; height: 18px; stroke-width: 1.5; display: inline-block; }

    .balance-gradient { background: linear-gradient(135deg,#4F46E5 0,#7c3aed 100%); }
    .trade-widget { background: linear-gradient(135deg,#1e293b 0,#0f172a 100%); }

    .price-up { color:#10b981; background:rgba(16,185,129,0.1); }
    .price-down { color:#ef4444; background:rgba(239,68,68,0.1); }

    .mobile-bankbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 45;
      padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
      background: rgba(2, 6, 23, 0.94);
      border-top: 1px solid rgba(51, 65, 85, 0.9);
      backdrop-filter: blur(18px);
      box-shadow: 0 -18px 45px rgba(0, 0, 0, 0.34);
    }

    .mobile-bankbar-inner {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: end;
      gap: 0.25rem;
      max-width: 34rem;
      margin: 0 auto;
    }

    .mobile-bankbar-link,
    .mobile-bankbar-action {
      min-width: 0;
      min-height: 3.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      border-radius: 1rem;
      color: #94a3b8;
      font-size: 0.68rem;
      font-weight: 700;
      line-height: 1;
      transition: background .2s ease, color .2s ease, transform .2s ease;
    }

    .mobile-bankbar-link.active {
      color: #ffffff;
      background: rgba(79, 70, 229, 0.18);
    }

    .mobile-bankbar-link:active,
    .mobile-bankbar-action:active {
      transform: translateY(1px) scale(0.98);
    }

    .mobile-bankbar-link i[data-lucide] {
      width: 1.2rem;
      height: 1.2rem;
      stroke-width: 2;
    }

    .mobile-bankbar-action {
      min-height: 4rem;
      color: #ffffff;
      transform: translateY(-0.6rem);
    }

    .mobile-bankbar-action .action-icon {
      height: 3.35rem;
      width: 3.35rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: linear-gradient(135deg, #10b981, #4F46E5);
      border: 4px solid #020617;
      box-shadow: 0 12px 30px rgba(16, 185, 129, 0.26);
    }

    .mobile-bankbar-action i[data-lucide] {
      width: 1.45rem;
      height: 1.45rem;
      stroke-width: 2.3;
    }

    .signal-buy { background:rgba(16,185,129,0.15); border-left:3px solid #10b981; }
    .signal-sell { background:rgba(239,68,68,0.15); border-left:3px solid #ef4444; }

    .order-buy { background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); }
    .order-sell { background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); }

    @keyframes pulse {
      0%,100% { opacity:1; }
      50% { opacity:.5; }
    }

    .pulse-indicator { animation:pulse 2s cubic-bezier(.4,0,.6,1) infinite; }

    /* Scrollbar hide utility */
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Mobile Responsive Fixes */
    @media (max-width: 640px) {
      body {
        padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
      }

      main {
        padding-bottom: 6.5rem !important;
      }

      /* Header fixes */
      header .flex.items-center.gap-4 {
        gap: 0.5rem !important;
      }
      
      header h1.text-lg {
        font-size: 1rem !important;
      }
      
      header .text-sm {
        font-size: 0.75rem !important;
      }
      
      header .h-10.w-10 {
        height: 2.25rem !important;
        width: 2.25rem !important;
      }
      
      /* Tab navigation - make scrollable */
      .flex.space-x-1.p-1 {
        overflow-x: auto !important;
        white-space: nowrap !important;
        flex-wrap: nowrap !important;
        -webkit-overflow-scrolling: touch;
        gap: 0.25rem !important;
        padding: 0.25rem !important;
      }
      
      .flex.space-x-1.p-1 button {
        display: inline-flex !important;
        padding: 0.5rem 0.75rem !important;
        font-size: 0.75rem !important;
        flex-shrink: 0 !important;
      }
      
      .flex.space-x-1.p-1 button i {
        margin-right: 0.25rem !important;
        width: 0.875rem !important;
        height: 0.875rem !important;
      }
      
      /* Balance cards */
      .grid.grid-cols-1.sm\:grid-cols-3.gap-4 {
        grid-template-columns: 1fr !important;
        gap: 0.75rem !important;
      }
      
      /* Trading balance section */
      .text-4xl.font-bold {
        font-size: 1.75rem !important;
      }
      
      .flex.items-start.justify-between.mb-6 {
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 0.75rem !important;
      }
      
      /* Action buttons */
      .flex.flex-wrap.gap-3 {
        flex-direction: column !important;
      }
      
      .flex.flex-wrap.gap-3 button,
      .flex.flex-wrap.gap-3 a {
        min-width: 100% !important;
        width: 100% !important;
        padding: 0.75rem !important;
        font-size: 0.875rem !important;
      }
      
      /* Trading stats grid */
      .grid.grid-cols-2.gap-4 {
        grid-template-columns: 1fr !important;
        gap: 0.75rem !important;
      }
      
      /* Market watchlist table */
      .overflow-x-auto {
        margin: 0 -1rem !important;
        width: calc(100% + 2rem) !important;
        padding: 0 1rem !important;
      }
      
      table {
        min-width: 600px !important;
      }
      
      /* Trading execution forms */
      .grid.grid-cols-1.md\:grid-cols-2.gap-6 {
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
      }
      
      .order-buy.p-6, .order-sell.p-6 {
        padding: 1rem !important;
      }
      
      .grid.grid-cols-2.gap-4 {
        grid-template-columns: 1fr !important;
      }
      
      /* Portfolio section */
      .grid.grid-cols-1.lg\:grid-cols-4.gap-6 {
        grid-template-columns: 1fr !important;
        gap: 0.75rem !important;
      }
      
      .grid.grid-cols-1.lg\:grid-cols-2.gap-6 {
        grid-template-columns: 1fr !important;
      }
      
      /* Quick trade modal */
      .fixed.inset-0.z-50 .bg-slate-900 {
        margin: 1rem !important;
        max-height: 90vh !important;
        overflow-y: auto !important;
      }
      
      /* Open positions */
      .grid.grid-cols-2.gap-3.text-sm {
        grid-template-columns: 1fr 1fr !important;
      }
      
      /* Footer */
      .flex.flex-col.md\:flex-row {
        flex-direction: column !important;
        gap: 0.75rem !important;
      }
      
      .flex.items-center.gap-6 {
        flex-wrap: wrap !important;
        justify-content: center !important;
        gap: 0.75rem !important;
      }
      
      /* Chart container */
      .tradingview-widget-container {
        height: 350px !important;
      }
      
      /* User menu */
      .hidden.sm\:block {
        display: none !important;
      }
      
      /* Quick trade button */
      .hidden.sm\:flex {
        display: none !important;
      }
      
      /* Stats cards */
      .bg-slate-800\/50.rounded-xl.p-4 {
        padding: 0.75rem !important;
      }
      
      .text-2xl.font-bold {
        font-size: 1.25rem !important;
      }
      
      /* KYC status icons */
      .ml-auto i {
        width: 1rem !important;
        height: 1rem !important;
      }
      
      /* Sidebar */
      .sidebar {
        width: 85% !important;
      }
      
      /* Back to top button */
      .fixed.bottom-6.left-6 {
        bottom: 6rem !important;
        left: 1rem !important;
        height: 2.5rem !important;
        width: 2.5rem !important;
      }
    }

    @media (min-width: 641px) and (max-width: 768px) {
      .grid.grid-cols-1.lg\:grid-cols-3.gap-6 {
        grid-template-columns: repeat(2, 1fr) !important;
      }
      
      .lg\:col-span-2 {
        grid-column: span 2 !important;
      }
      
      .grid.grid-cols-1.lg\:grid-cols-4.gap-6 {
        grid-template-columns: repeat(2, 1fr) !important;
      }
      
      .grid.grid-cols-1.lg\:grid-cols-2.gap-6 {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }

    /* Ensure buttons are tappable */
    button, a {
      min-height: 44px;
      min-width: 44px;
    }

    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
    }

    /* Better mobile scrolling */
    .overflow-x-auto {
      -webkit-overflow-scrolling: touch;
    }
  </style>
</head>

<body class="bg-slate-950 text-white"
      x-data="{ sidebarOpen:false, quickTrade:{symbol:'BTC/USD', type:'market', side:'buy', amount:100, leverage:1}, showTradeModal:false, activeTab:'overview' }"
      @keydown.escape="sidebarOpen = false">
      <% if (admin) { %>
  <div class="bg-yellow-500/10 border-b border-yellow-500/30 px-6 py-3 flex justify-between items-center">
    <p class="text-yellow-300 text-sm">
      Viewing user account as admin
    </p>

    <form action="/admin/return" method="POST">
      <button class="px-4 py-2 text-sm bg-yellow-500/20 text-yellow-300 rounded hover:bg-yellow-500/30">
        Return to Admin
      </button>
    </form>
  </div>
<% } %>

<div x-show="sidebarOpen"
     @click="sidebarOpen = false"
     class="sidebar-overlay md:hidden"
     x-transition:enter="transition-opacity ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-transition:leave="transition-opacity ease-in duration-200"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0"
     style="display:none"></div>

<aside class="sidebar"
       :class="{ 'open': sidebarOpen }"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="transform -translate-x-full"
       x-transition:enter-end="transform translate-x-0"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="transform translate-x-0"
       x-transition:leave-end="transform -translate-x-full">

  <div class="p-6 border-b border-slate-800">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img src="/temp/custom/img/logo1.png" class="h-8 w-auto">
        <div>
          <h1 class="font-bold text-lg text-white">Trader Panel</h1>
          <div class="flex items-center gap-2 mt-1">
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 pulse-indicator"></span>
            <span class="text-xs text-slate-400">Live</span>
          </div>
        </div>
      </div>

      <button @click="sidebarOpen = false" class="text-slate-400 hover:text-white md:hidden">
        <i data-lucide="x"></i>
      </button>
    </div>
  </div>

  <div class="p-6 border-b border-slate-800">
    <div class="flex items-center gap-3">
      <div class="relative">
        <div class="h-12 w-12 rounded-full bg-gradient-to-br from-primary-600 to-primary-800 flex items-center justify-center text-white font-bold text-lg">
          <%= (user.name || user.username).slice(0,1).toUpperCase() %>
        </div>
        <div class="absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-slate-900 bg-emerald-500"></div>
      </div>

      <div class="flex-1 min-w-0">
        <p class="font-semibold text-white truncate"><%= user.name || user.username %></p>
        <p class="text-sm text-slate-400">Standard Account</p>
      </div>
    </div>
  </div>

  <nav class="p-4 space-y-1 flex-1 overflow-y-auto">

    <a href="/dashboard"
       class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group"
       :class="window.location.pathname === '/dashboard' ? 'bg-primary-600 text-white' : 'text-slate-300'">
      <i data-lucide="layout-dashboard" class="group-hover:scale-110 transition-transform"></i>
      <span class="font-medium">Dashboard</span>
    </a>

    <a href="/account"
       class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group text-slate-300 hover:bg-slate-800/50">
      <i data-lucide="user"></i>
      <span>Account</span>
    </a>

    <a href="/support"
       class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group text-slate-300 hover:bg-slate-800/50">
      <i data-lucide="life-buoy"></i>
      <span>Support</span>
    </a>

    <a href="/kyc-verification"
       class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all group text-slate-300 hover:bg-slate-800/50">
      <i data-lucide="id-card"></i>
      <span>KYC Verification</span>

      <% if (user.kycStatus === 'verified') { %>
        <span class="ml-auto"><i data-lucide="check-circle" class="text-emerald-400"></i></span>
      <% } else if (user.kycStatus === 'pending') { %>
        <span class="ml-auto pulse-indicator"><i data-lucide="clock" class="text-amber-400"></i></span>
      <% } %>
    </a>

    <div class="pt-6 pb-2 px-4">
      <p class="text-xs font-semibold text-slate-500 uppercase">TRADING</p>
    </div>

    <a href="/copy-trader"
       class="flex items-center gap-3 px-4 py-3 rounded-xl group hover:bg-slate-800/50 text-slate-300">
      <i data-lucide="users"></i>
      <span>Copy Trader</span>
    </a>

    <a href="/stocks"
       class="flex items-center gap-3 px-4 py-3 rounded-xl group hover:bg-slate-800/50 text-slate-300">
      <i data-lucide="trending-up"></i>
      <span>Stocks</span>
    </a>

    <a href="/pl-record"
       class="flex items-center gap-3 px-4 py-3 rounded-xl group hover:bg-slate-800/50 text-slate-300">
      <i data-lucide="bar-chart-2"></i>
      <span>P&L Record</span>
    </a>

    <a href="/trading-history"
       class="flex items-center gap-3 px-4 py-3 rounded-xl group hover:bg-slate-800/50 text-slate-300">
      <i data-lucide="activity"></i>
      <span>Trading History</span>
    </a>

    <div class="pt-6 pb-2 px-4">
      <p class="text-xs font-semibold text-slate-500 uppercase">FINANCIAL</p>
    </div>

    <div x-data="{ dropdownOpen:false }" class="relative">
      <button @click="dropdownOpen = !dropdownOpen"
              class="flex items-center justify-between w-full px-4 py-3 rounded-xl text-slate-300 hover:bg-slate-800/50">
        <div class="flex items-center gap-3">
          <i data-lucide="wallet"></i>
          <span>Deposit & Withdrawal</span>
        </div>
        <i data-lucide="chevron-down"
           class="transition-transform"
           :class="{ 'rotate-180': dropdownOpen }"></i>
      </button>

      <div x-show="dropdownOpen" x-collapse class="pl-12 pr-4 pt-2 space-y-1">
        <a href="/deposit-withdrawal"
           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/30">
          <i data-lucide="arrow-down-circle" class="w-4 h-4"></i>
          Deposit
        </a>

        <a href="/withdraw"
           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/30">
          <i data-lucide="arrow-up-circle" class="w-4 h-4"></i>
          Withdraw
        </a>
      </div>
    </div>

    <a href="/packages"
       class="flex items-center gap-3 px-4 py-3 rounded-xl group hover:bg-slate-800/50 text-slate-300">
      <i data-lucide="gift"></i>
      <span>Packages</span>
    </a>

    <a href="/package-history"
       class="flex items-center gap-3 px-4 py-3 rounded-xl group hover:bg-slate-800/50 text-slate-300">
      <i data-lucide="history"></i>
      <span>Package History</span>
    </a>

    <a href="/transactions-history"
       class="flex items-center gap-3 px-4 py-3 rounded-xl group hover:bg-slate-800/50 text-slate-300">
      <i data-lucide="list-tree"></i>
      <span>Transactions</span>
    </a>

    <div class="pt-6 mt-6 border-t border-slate-800">
      <a href="/logout"
         class="flex items-center gap-3 px-4 py-3 rounded-xl text-red-400 hover:bg-red-500/10">
        <i data-lucide="log-out"></i>
        <span>Logout</span>
      </a>
    </div>

  </nav>

  <div class="p-4 border-t border-slate-800">
    <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:bg-slate-800/50">
      <i data-lucide="home"></i>
      <span>Back to Home</span>
    </a>
  </div>

</aside>

<div class="main-content flex flex-col min-h-screen">

<header class="sticky top-0 z-30 bg-slate-900/90 backdrop-blur-xl border-b border-slate-800">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-4">
        <button @click="sidebarOpen = !sidebarOpen"
                class="h-10 w-10 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center hover:bg-slate-700">
          <i data-lucide="menu"></i>
        </button>

        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg font-bold text-white">Trading Dashboard</h1>
            <span class="px-2 py-1 rounded-full bg-emerald-500/10 text-emerald-300 text-xs font-semibold flex items-center gap-1">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Live
            </span>
          </div>
          <p class="text-sm text-slate-400">
            Welcome back,
            <span class="text-slate-300 font-medium"><%= user.name || user.username %></span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button @click="showTradeModal = true"
                class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 text-sm font-semibold hover:bg-emerald-700">
          <i data-lucide="zap" class="w-4 h-4"></i>
          Quick Trade
        </button>

        <div class="relative" x-data="{ userMenuOpen: false }">
          <button @click="userMenuOpen = !userMenuOpen"
                  class="flex items-center gap-3 px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 hover:bg-slate-700">
            <div class="h-8 w-8 rounded-full bg-slate-700 flex items-center justify-center font-semibold">
              <%= (user.name || user.username).slice(0,1).toUpperCase() %>
            </div>
            <div class="hidden sm:block text-left">
              <p class="text-sm font-medium text-white"><%= user.username %></p>
              <p class="text-xs text-slate-400">Trading Account</p>
            </div>
            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
          </button>

          <div x-show="userMenuOpen"
               @click.outside="userMenuOpen = false"
               class="absolute right-0 mt-2 w-48 bg-slate-800 border border-slate-700 rounded-xl shadow-xl py-2 z-50"
               x-transition:enter="transition ease-out duration-100"
               x-transition:enter-start="transform opacity-0 scale-95"
               x-transition:enter-end="transform opacity-100 scale-100"
               x-transition:leave="transition ease-in duration-75"
               x-transition:leave-start="transform opacity-100 scale-100"
               x-transition:leave-end="transform opacity-0 scale-95"
               style="display:none">

            <a href="/account"
               class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-700/50">
