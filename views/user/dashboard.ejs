<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Dashboard • <%= user.name || user.username %></title>
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png">

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <script src="https://s3.tradingview.com/tv.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Inter', 'sans-serif'] },
          colors: {
            brand: { 50: '#0d2035', 100: '#12304d', 500: '#0090ff', 600: '#00c8ff', 700: '#00ffd5' },
            ink: { DEFAULT: '#ffffff', soft: '#a7b4c4', mute: '#718096' }
          },
          keyframes: {
            'fade-up': { '0%': { opacity: '0', transform: 'translateY(16px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
            'scale-in': { '0%': { opacity: '0', transform: 'scale(.96)' }, '100%': { opacity: '1', transform: 'scale(1)' } }
          },
          animation: { 'fade-up': 'fade-up .5s cubic-bezier(.16,1,.3,1) forwards', 'scale-in': 'scale-in .2s ease-out' }
        }
      }
    }
  </script>

  <style>
    :root {
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --black: #030508;
      --surface: #080d16;
      --card: #0d1420;
      --card2: #111b2b;
      --border: rgba(255,255,255,.07);
      --blue: #0090ff;
      --blue2: #00c8ff;
      --cyan: #00ffd5;
      --green: #00e676;
      --muted: #8899aa;
    }
    html, body { background: var(--black); }
    body { font-family: Inter, sans-serif; overflow-x: hidden; -webkit-font-smoothing: antialiased; color: #fff; }
    h1, h2, h3, h4, h5, h6 { font-family: Inter, sans-serif; }
    [x-cloak] { display: none !important; }

    .card {
      min-width: 0;
      overflow-wrap: anywhere;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      box-shadow: 0 1px 2px rgba(0,0,0,.2), 0 12px 32px -18px rgba(0,0,0,.8);
    }
    .card .flex-1 { min-width: 0; }
    .account-balance-card { container-type: inline-size; }
    .account-balance-value {
      max-width: 100%;
      font-size: clamp(1.25rem, 5.5cqi, 2.5rem);
      line-height: 1.1;
      overflow-wrap: anywhere;
    }
    .dashboard-stat-card { container-type: inline-size; }
    .dashboard-stat-value {
      font-size: clamp(1rem, 8cqi, 1.4rem);
      line-height: 1.25;
      overflow-wrap: anywhere;
    }
    .card-hover { transition: transform .25s ease, box-shadow .25s ease, border-color .2s ease; }
    .card-hover:hover { transform: translateY(-3px); border-color: rgba(0,176,255,.35); box-shadow: 0 14px 32px -14px rgba(0,144,255,.25); }
    .btn-primary {
      background: linear-gradient(135deg, var(--blue), var(--blue2));
      color: #030508;
      box-shadow: 0 8px 20px -8px rgba(0,144,255,.55);
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 12px 24px -8px rgba(0,144,255,.6); }
    .btn-soft { background: var(--card2); color: #fff; border: 1px solid var(--border); transition: background .2s ease; }
    .btn-soft:hover { background: #172438; }
    .nav-link { color: #a7b4c4; }
    .nav-link:hover { background: rgba(255,255,255,.05); color: #fff; }
    .nav-link.active { background: rgba(0,144,255,.13); color: var(--blue2); font-weight: 600; }
    .mobile-downbar { padding-bottom: calc(8px + var(--safe-bottom)); box-shadow: 0 -10px 30px rgba(0,0,0,.45); }
    @media (max-width: 767px) { body { padding-bottom: calc(88px + var(--safe-bottom)); } }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--surface); }
    ::-webkit-scrollbar-thumb { background: #263448; border-radius: 10px; }

    /* Keep the reference layout while using the homepage's dark palette. */
    [class~="bg-white"], [class~="bg-white/90"], [class~="bg-white/95"] { background-color: var(--surface) !important; }
    [class~="bg-slate-50"], [class~="bg-slate-50/80"] { background-color: rgba(255,255,255,.035) !important; }
    [class~="bg-slate-100"] { background-color: rgba(255,255,255,.06) !important; }
    [class~="bg-slate-200"] { background-color: rgba(255,255,255,.1) !important; }
    [class~="border-slate-100"], [class~="border-slate-200"] { border-color: var(--border) !important; }
    [class~="text-slate-900"], [class~="text-slate-800"], [class~="text-ink"] { color: #fff !important; }
    [class~="text-slate-700"] { color: #d5deea !important; }
    [class~="text-slate-600"] { color: #a7b4c4 !important; }
    [class~="text-slate-500"] { color: var(--muted) !important; }
    [class~="text-slate-400"] { color: #718096 !important; }
    [class~="text-brand-600"] { color: var(--blue2) !important; }
    [class~="bg-brand-50"] { background-color: rgba(0,144,255,.12) !important; }
    [class~="bg-emerald-50"] { background-color: rgba(0,230,118,.12) !important; }
    [class~="bg-amber-50"] { background-color: rgba(255,192,64,.12) !important; }
    [class~="bg-red-50"], [class~="bg-rose-50"] { background-color: rgba(255,61,90,.12) !important; }
    [class~="bg-orange-50"] { background-color: rgba(255,159,67,.12) !important; }
    [class~="bg-purple-50"] { background-color: rgba(168,85,247,.12) !important; }
    [class~="text-emerald-700"] { color: #00e676 !important; }
    [class~="text-amber-700"] { color: #ffc040 !important; }
    [class~="text-red-600"], [class~="text-rose-600"] { color: #ff6078 !important; }
    [class~="hover:bg-slate-50"]:hover { background-color: rgba(255,255,255,.05) !important; }
    [class~="hover:bg-slate-100"]:hover, [class~="hover:bg-slate-200"]:hover { background-color: rgba(255,255,255,.09) !important; }
    [class~="hover:bg-brand-100"]:hover { background-color: rgba(0,144,255,.2) !important; }
  </style>
</head>

<%
  const money = (n) => Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const btcPrice = Number((cryptoPrices && cryptoPrices.btc) || 67432.15);
  const btcEq = (Number(user.balance || 0) / btcPrice).toFixed(6);
  const verified = String(user.kycStatus || '').trim().toLowerCase() === 'verified';
  const kycPending = String(user.kycStatus || '').trim().toLowerCase() === 'pending';
  const initial = (user.name || user.username).slice(0, 1).toUpperCase();
  const signalSource = typeof accountSignal !== 'undefined' && accountSignal !== null
    ? accountSignal
    : (user.signal ?? 100);
  const parsedSignal = Number(signalSource);
  const signalValue = Number.isFinite(parsedSignal)
    ? Math.max(0, Math.min(100, parsedSignal))
    : 100;
  const lastUpdated = new Date().toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
%>

<body class="min-h-screen font-sans"
      x-data="{
        mobileSidebarOpen: false,
        notificationOpen: false,
        userMenuOpen: false,
        cryptoPrices: {
          btc: <%= cryptoPrices?.btc || 67432.15 %>,
          eth: <%= cryptoPrices?.eth || 3542.78 %>,
          sol: <%= cryptoPrices?.sol || 172.45 %>
        }
      }"
      @keydown.escape="mobileSidebarOpen = false; notificationOpen = false; userMenuOpen = false">

<!-- Mobile sidebar backdrop -->
<div x-show="mobileSidebarOpen" x-cloak @click="mobileSidebarOpen = false"
     class="fixed inset-0 z-30 bg-slate-900/40 backdrop-blur-sm md:hidden"></div>

<!-- Notification Panel -->
<div x-show="notificationOpen" x-cloak @click.outside="notificationOpen = false"
     class="fixed right-4 top-20 w-80 max-w-[calc(100vw-2rem)] card shadow-2xl z-50 max-h-96 overflow-y-auto animate-scale-in">
  <div class="p-4 border-b border-slate-100 flex items-center justify-between">
    <h3 class="font-semibold font-display">Notifications</h3>
    <button @click="notificationOpen = false" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-5 h-5"></i></button>
  </div>
  <div class="p-4 hover:bg-slate-50 transition-colors">
    <div class="flex items-start gap-3">
      <div class="h-10 w-10 rounded-xl bg-emerald-50 flex items-center justify-center"><i data-lucide="trending-up" class="text-emerald-600 w-5 h-5"></i></div>
      <div class="flex-1">
        <p class="text-sm font-medium">Welcome to Stocker</p>
        <p class="text-xs text-slate-500 mt-1">Your account is active and ready to trade</p>
        <span class="text-xs text-slate-400 mt-2 block">Just now</span>
      </div>
    </div>
  </div>
</div>

<!-- SIDEBAR -->
<aside class="fixed inset-y-0 left-0 z-40 w-64 flex flex-col bg-white border-r border-slate-200 transition-transform duration-300 md:translate-x-0"
       :class="mobileSidebarOpen ? 'translate-x-0' : '-translate-x-full'">

  <div class="p-5 border-b border-slate-100 flex items-center justify-between">
    <img src="/temp/custom/img/logo.png" alt="Logo" class="h-11 w-auto">
    <button @click="mobileSidebarOpen = false" class="md:hidden text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-5 h-5"></i></button>
  </div>

  <div class="p-5 border-b border-slate-100">
    <div class="flex items-center gap-3">
      <div class="h-11 w-11 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-bold"><%= initial %></div>
      <div class="flex-1 min-w-0">
        <p class="font-semibold truncate font-display"><%= user.name || user.username %></p>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-xs text-slate-500">Standard</span>
          <% if (verified) { %>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium">Verified</span>
          <% } else if (kycPending) { %>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium">Pending review</span>
          <% } else { %>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium">Unverified</span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <nav class="p-3 space-y-1 flex-1 overflow-y-auto text-sm">
    <a href="/" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="home" class="w-5 h-5"></i><span>Home</span></a>
    <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %> flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors">
      <i data-lucide="layout-dashboard" class="w-5 h-5"></i><span>Dashboard</span>
    </a>

    <p class="pt-4 pb-1 px-4 text-[11px] font-semibold text-slate-400 uppercase tracking-widest">Trading</p>
    <a href="/stocks" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="trending-up" class="w-5 h-5"></i><span>Stocks</span><span class="ml-auto text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium">Hot</span></a>
    <a href="/copy-trader" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="users" class="w-5 h-5"></i><span>Copy Trading</span></a>
    <a href="/trading-history" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="clock" class="w-5 h-5"></i><span>Trading History</span></a>
    <a href="/pl-record" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="bar-chart-2" class="w-5 h-5"></i><span>P/L Record</span></a>

    <p class="pt-4 pb-1 px-4 text-[11px] font-semibold text-slate-400 uppercase tracking-widest">Financial</p>
    <a href="/deposit-withdrawal" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="arrow-down-circle" class="w-5 h-5"></i><span>Deposit</span></a>
    <a href="/withdraw" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="arrow-up-circle" class="w-5 h-5"></i><span>Withdraw</span></a>
    <a href="/transactions-history" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="credit-card" class="w-5 h-5"></i><span>Funding History</span></a>

    <p class="pt-4 pb-1 px-4 text-[11px] font-semibold text-slate-400 uppercase tracking-widest">Account</p>
    <a href="/account" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="user" class="w-5 h-5"></i><span>Profile</span></a>
    <a href="/kyc-verification" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors">
      <i data-lucide="shield" class="w-5 h-5"></i><span>KYC</span>
      <% if (!verified) { %><i data-lucide="clock" class="w-4 h-4 text-amber-500 ml-auto"></i><% } %>
    </a>
    <a href="/support" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="message-circle" class="w-5 h-5"></i><span>Support</span></a>
    <a href="/packages" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="sun" class="w-5 h-5"></i><span>Packages</span></a>
    <a href="/package-history" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="package" class="w-5 h-5"></i><span>Package History</span></a>

    <div class="pt-4 mt-4 border-t border-slate-100">
      <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-red-600 hover:bg-red-50 transition-colors mt-1"><i data-lucide="log-out" class="w-5 h-5"></i><span>Logout</span></a>
    </div>
  </nav>
</aside>

<!-- MAIN -->
<div class="min-h-screen md:ml-64">

  <!-- Header -->
  <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-xl border-b border-slate-200">
    <div class="px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
      <div class="flex items-center gap-3">
        <button @click="mobileSidebarOpen = true" class="md:hidden h-10 w-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center hover:bg-slate-200 transition-colors">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="hidden md:flex items-center gap-2 text-sm">
          <span class="text-slate-500">Dashboard</span>
          <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
          <span class="font-medium">Overview</span>
        </div>
      </div>

      <div class="hidden lg:flex items-center gap-6 text-sm">
        <div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span><span class="text-slate-600"><%= marketData?.marketOpen ? 'Market Open' : 'Market Closed' %></span></div>
        <div><span class="text-slate-400">BTC</span> <span class="text-emerald-600 font-semibold ml-1" x-text="'$' + cryptoPrices.btc.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})"></span></div>
        <div><span class="text-slate-400">ETH</span> <span class="text-emerald-600 font-semibold ml-1" x-text="'$' + cryptoPrices.eth.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})"></span></div>
        <div><span class="text-slate-400">SOL</span> <span class="text-emerald-600 font-semibold ml-1" x-text="'$' + cryptoPrices.sol.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})"></span></div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <a href="/deposit-withdrawal" class="hidden sm:flex btn-primary items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold">
          <i data-lucide="plus" class="w-4 h-4"></i> Quick Deposit
        </a>

        <button @click="notificationOpen = !notificationOpen" class="h-10 w-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center hover:bg-slate-200 transition-colors">
          <i data-lucide="bell" class="w-5 h-5"></i>
        </button>

        <div class="relative">
          <button @click="userMenuOpen = !userMenuOpen" class="flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 hover:bg-slate-200 transition-colors">
            <div class="h-8 w-8 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center font-semibold text-white text-sm"><%= initial %></div>
            <div class="hidden sm:block text-left">
              <p class="text-sm font-medium leading-tight"><%= user.username %></p>
              <p class="text-xs text-slate-500">$<%= money(user.balance) %></p>
            </div>
            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 transition-transform" :class="{'rotate-180': userMenuOpen}"></i>
          </button>

          <div x-show="userMenuOpen" x-cloak @click.outside="userMenuOpen = false"
               class="absolute right-0 mt-2 w-56 card py-2 z-50 animate-scale-in">
            <div class="px-4 py-3 border-b border-slate-100">
              <p class="text-sm font-medium"><%= user.name || user.username %></p>
              <p class="text-xs text-slate-500 mt-1"><%= user.kycStatus || 'Not Verified' %></p>
            </div>
            <div class="py-1 text-sm">
              <a href="/account" class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50"><i data-lucide="user" class="w-4 h-4"></i>Profile Settings</a>
              <a href="/kyc-verification" class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50"><i data-lucide="shield" class="w-4 h-4"></i>KYC Verification</a>
            </div>
            <div class="border-t border-slate-100 pt-1">
              <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 text-red-600 hover:bg-red-50 text-sm"><i data-lucide="log-out" class="w-4 h-4"></i>Logout</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live ticker strip (mobile + all) -->
    <div class="border-t border-slate-100 bg-slate-50/80 px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between text-xs sm:text-sm lg:hidden">
      <div class="flex items-center gap-3 overflow-x-auto whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-slate-500 font-medium"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>LIVE</span>
        <span><span class="text-slate-400">BTC:</span> <span class="text-emerald-600 font-semibold" x-text="'$' + Math.round(cryptoPrices.btc).toLocaleString('en-US')"></span></span>
        <span><span class="text-slate-400">ETH:</span> <span class="text-emerald-600 font-semibold" x-text="'$' + Math.round(cryptoPrices.eth).toLocaleString('en-US')"></span></span>
      </div>
      <div class="text-right shrink-0 pl-3"><span class="text-slate-400">Balance:</span> <span class="font-bold">$<%= money(user.balance) %></span></div>
    </div>
  </header>

  <!-- Content -->
  <main class="p-4 sm:p-6 lg:p-8">
    <% if (typeof impersonating !== 'undefined' && impersonating) { %>
      <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <span class="font-medium">Account preview mode is active.</span>
        <a href="/secure/stop-preview" class="inline-flex items-center justify-center rounded-xl bg-amber-500 px-4 py-2 text-xs font-semibold text-white hover:bg-amber-600 transition-colors">Exit Preview</a>
      </div>
    <% } %>

    <div class="max-w-7xl mx-auto space-y-6 animate-fade-up">

      <!-- Welcome -->
      <div class="text-center md:text-left">
        <h2 class="text-2xl sm:text-3xl font-bold font-display tracking-tight">Welcome back, <%= user.name || user.username %>!</h2>
        <p class="text-slate-500 mt-1">Your investment dashboard overview</p>
      </div>

      <section class="card p-5 sm:p-6" aria-label="Account signal">
        <div class="mb-3 flex items-center justify-between gap-4">
          <h3 class="flex items-center gap-2 font-semibold font-display"><i data-lucide="activity" class="h-5 w-5 text-brand-600"></i>Account Signal</h3>
          <span class="font-bold tabular-nums <%= signalValue === 0 ? 'text-red-600' : signalValue < 40 ? 'text-amber-500' : 'text-emerald-500' %>"><%= signalValue %>%</span>
        </div>
        <div class="h-3 overflow-hidden rounded-full bg-slate-200" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= signalValue %>" aria-label="Account signal level">
          <div class="h-full rounded-full bg-gradient-to-r from-red-500 via-amber-400 to-emerald-500 transition-all duration-500" style="width: <%= signalValue %>%"></div>
        </div>
        <% if (signalValue === 0) { %>
          <p class="mt-3 flex items-start gap-2 text-xs text-red-300">
            <i data-lucide="lock" class="mt-0.5 h-4 w-4 shrink-0"></i>
            Your account signal has been exhausted. Certain account actions are temporarily unavailable. Please contact support for further assistance.
          </p>
        <% } %>
      </section>

      <!-- Balance + stats -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

        <!-- Account balance card -->
        <div class="card account-balance-card p-6 sm:p-8 lg:col-span-2 text-center">
          <div class="flex items-center justify-center gap-2 text-ink">
            <i data-lucide="wallet" class="w-5 h-5 text-brand-600"></i>
            <h3 class="text-lg font-semibold font-display">Account Balance</h3>
          </div>
          <p class="text-sm text-slate-500 mt-1">Your available funds</p>

          <p class="account-balance-value font-bold font-display mt-5 tracking-tight">$<%= money(user.balance) %></p>

          <div class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-orange-50 border border-orange-200 text-orange-600 font-semibold text-sm">
            <span class="h-5 w-5 rounded-full bg-orange-500 text-white text-[11px] flex items-center justify-center font-bold">₿</span>
            <%= btcEq %> BTC
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 text-xs font-medium">
              <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> Available for Withdrawal
            </span>
            <% if (verified) { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold"><i data-lucide="badge-check" class="w-3.5 h-3.5"></i> Verified</span>
            <% } else if (kycPending) { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold"><i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending review</span>
            <% } else { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-50 text-red-600 text-xs font-semibold"><i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> Unverified</span>
            <% } %>
          </div>

          <p class="text-xs text-slate-400 mt-4">Last updated: <%= lastUpdated %></p>

          <div class="mt-5 space-y-3">
            <a href="/deposit-withdrawal" class="btn-primary flex items-center justify-center gap-2 w-full py-3 rounded-xl text-sm font-semibold"><i data-lucide="plus-circle" class="w-4 h-4"></i> Deposit</a>
            <a href="/withdraw" class="btn-soft flex items-center justify-center gap-2 w-full py-3 rounded-xl text-sm font-semibold"><i data-lucide="arrow-up-right" class="w-4 h-4"></i> Withdraw</a>
          </div>
        </div>

        <!-- Right column -->
        <div class="lg:col-span-3 space-y-6">
          <div class="grid grid-cols-2 gap-4">
            <div class="card card-hover dashboard-stat-card p-5">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Profit Available</span>
                <span class="h-8 w-8 rounded-full bg-emerald-50 flex items-center justify-center"><i data-lucide="dollar-sign" class="w-4 h-4 text-emerald-600"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3 <%= (user.totalProfit || 0) >= 0 ? 'text-emerald-600' : 'text-red-600' %>">$<%= money(user.totalProfit) %></p>
              <p class="text-xs text-slate-400 mt-2">After requested withdrawals</p>
            </div>

            <div class="card card-hover dashboard-stat-card p-5">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Deposit</span>
                <span class="h-8 w-8 rounded-full bg-brand-50 flex items-center justify-center"><i data-lucide="arrow-down" class="w-4 h-4 text-brand-600"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3">$<%= money(user.depositBalance) %></p>
              <p class="text-xs text-slate-400 mt-2">Current funds available for trading</p>
            </div>

            <div class="card card-hover dashboard-stat-card p-5">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Withdrawals Paid</span>
                <span class="h-8 w-8 rounded-full bg-rose-50 flex items-center justify-center"><i data-lucide="arrow-up" class="w-4 h-4 text-rose-600"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3">$<%= money(user.totalWithdrawal) %></p>
              <p class="text-xs text-slate-400 mt-2">$<%= money(user.pendingWithdrawal) %> pending</p>
            </div>

            <div class="card card-hover dashboard-stat-card p-5">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Bonus</span>
                <span class="h-8 w-8 rounded-full bg-amber-50 flex items-center justify-center"><i data-lucide="gift" class="w-4 h-4 text-amber-600"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3">$<%= money(user.bonus) %></p>
              <p class="text-xs text-slate-400 mt-2 flex items-center gap-1.5"><i data-lucide="calendar" class="w-3.5 h-3.5"></i> All time</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="card p-5 flex items-center justify-between">
              <div>
                <p class="text-sm text-slate-500">Open Trades</p>
                <p class="text-2xl font-bold font-display mt-1"><%= openTrades || 0 %></p>
              </div>
              <span class="h-10 w-10 rounded-xl bg-brand-50 flex items-center justify-center"><i data-lucide="activity" class="w-5 h-5 text-brand-600"></i></span>
            </div>
            <div class="card p-5 flex items-center justify-between">
              <div>
                <p class="text-sm text-slate-500">Win Rate</p>
                <p class="text-2xl font-bold font-display mt-1"><%= user.winRate || '0.0' %>%</p>
              </div>
              <span class="h-10 w-10 rounded-xl bg-emerald-50 flex items-center justify-center"><i data-lucide="target" class="w-5 h-5 text-emerald-600"></i></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Identity verification -->
      <% if (!verified) { %>
      <div class="card p-6 sm:p-8 text-center">
        <span class="mx-auto h-14 w-14 rounded-2xl bg-brand-50 flex items-center justify-center"><i data-lucide="shield-check" class="w-7 h-7 text-brand-600"></i></span>
        <h3 class="text-xl font-semibold font-display mt-4"><%= kycPending ? 'Verification in review' : 'Identity Verification' %></h3>
        <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto"><%= kycPending ? 'Your documents were submitted and are waiting for admin review.' : 'Verify your identity to unlock withdrawals, higher limits and full account protection.' %></p>
        <% if (!kycPending) { %><a href="/kyc-verification" class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold mt-5"><i data-lucide="shield" class="w-4 h-4"></i> Verify Now</a><% } %>
      </div>
      <% } %>

      <!-- Live prices -->
      <div class="card p-5">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-semibold font-display">Live Prices</h3>
          <a href="/stocks" class="text-sm text-brand-600 hover:text-brand-700 font-medium">View All →</a>
        </div>
        <div class="flex overflow-x-auto gap-4 pb-2">
          <div class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100 min-w-[190px]">
            <span class="h-10 w-10 rounded-full bg-orange-50 flex items-center justify-center"><i data-lucide="bitcoin" class="w-5 h-5 text-orange-500"></i></span>
            <div><p class="text-xs text-slate-500">BTC/USD</p><span class="text-lg font-bold font-display" x-text="'$' + cryptoPrices.btc.toLocaleString('en-US', {minimumFractionDigits: 0})"></span></div>
          </div>
          <div class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100 min-w-[190px]">
            <span class="h-10 w-10 rounded-full bg-brand-50 flex items-center justify-center"><i data-lucide="hexagon" class="w-5 h-5 text-brand-600"></i></span>
            <div><p class="text-xs text-slate-500">ETH/USD</p><span class="text-lg font-bold font-display" x-text="'$' + cryptoPrices.eth.toLocaleString('en-US', {minimumFractionDigits: 2})"></span></div>
          </div>
          <div class="flex items-center gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100 min-w-[190px]">
            <span class="h-10 w-10 rounded-full bg-purple-50 flex items-center justify-center"><i data-lucide="sun" class="w-5 h-5 text-purple-600"></i></span>
            <div><p class="text-xs text-slate-500">SOL/USD</p><span class="text-lg font-bold font-display" x-text="'$' + cryptoPrices.sol.toLocaleString('en-US', {minimumFractionDigits: 2})"></span></div>
          </div>
        </div>
      </div>

      <!-- Charts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-5">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold font-display">Market Chart</h3>
            <select id="symbolSelect" class="px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-100">
              <option value="BTCUSD">BTC/USD</option>
              <option value="ETHUSD">ETH/USD</option>
              <option value="SOLUSD">SOL/USD</option>
              <option value="AAPL">AAPL</option>
              <option value="TSLA">TSLA</option>
            </select>
          </div>
          <div id="tradingview_chart" class="h-[400px] rounded-2xl overflow-hidden"></div>
        </div>

        <div class="card p-5">
          <div class="mb-4">
            <h3 class="text-lg font-semibold font-display">Portfolio Growth</h3>
            <p class="text-sm text-slate-500">30-day performance</p>
          </div>
          <div id="performanceChart" style="height: 350px;"></div>
        </div>
      </div>

      <% if (closeableTradesCount > 0) { %>
      <section class="card p-5 sm:p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="text-lg font-semibold font-display">Open Trades <span class="ml-1 text-sm text-slate-400">(<%= closeableTradesCount %>)</span></h3>
            <p class="mt-1 text-sm text-slate-500">Uses live prices where available, otherwise the last recorded P/L. Stops active copy trades.</p>
          </div>
          <form action="/trade/close-all" method="POST" onsubmit="return confirm('Close all <%= closeableTradesCount %> open trades? Live prices will be used where available; otherwise the last recorded P/L is applied. This cannot be undone.');">
            <button type="submit" class="w-full rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700 sm:w-auto">Close All Open Trades</button>
          </form>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <% (openPositions || []).forEach(position => { %>
            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-4">
              <div>
                <p class="font-semibold"><%= position.symbol %></p>
                <p class="mt-1 text-xs text-slate-500"><%= String(position.side || 'buy').toUpperCase() %> · <%= Number(position.leverage || 1) %>× leverage</p>
              </div>
              <p class="text-sm font-semibold <%= Number(position.pnl || 0) >= 0 ? 'text-emerald-600' : 'text-red-600' %>">$<%= Number(position.pnl || 0).toFixed(2) %></p>
            </div>
          <% }) %>
          <% (activeCopyTrades || []).forEach(trade => { %>
            <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-4">
              <div>
                <p class="font-semibold"><%= trade.symbol || 'Copy trade' %></p>
                <p class="mt-1 text-xs text-slate-500">Active copy trade</p>
              </div>
              <p class="text-sm font-semibold <%= Number(trade.profit || trade.pnl || 0) >= 0 ? 'text-emerald-600' : 'text-red-600' %>">$<%= Number(trade.profit || trade.pnl || 0).toFixed(2) %></p>
            </div>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- Trades + Holdings -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="text-lg font-semibold font-display mb-5">Recent Trades</h3>
          <div class="space-y-3">
            <% if (!trades || trades.length === 0) { %>
              <div class="text-center py-10">
                <i data-lucide="activity" class="w-12 h-12 text-slate-300 mx-auto mb-4"></i>
                <p class="text-slate-500 mb-4">No trades yet</p>
                <a href="/stocks" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-50 text-brand-600 hover:bg-brand-100 transition-colors text-sm font-semibold"><i data-lucide="plus" class="w-4 h-4"></i> Start Trading</a>
              </div>
            <% } else { %>
              <% trades.slice(0, 5).forEach(t => { %>
                <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                  <div class="h-10 w-10 rounded-full <%= t.side === 'BUY' ? 'bg-emerald-50' : 'bg-red-50' %> flex items-center justify-center">
                    <i data-lucide="<%= t.side === 'BUY' ? 'trending-up' : 'trending-down' %>" class="w-5 h-5 <%= t.side === 'BUY' ? 'text-emerald-600' : 'text-red-600' %>"></i>
                  </div>
                  <div class="flex-1"><p class="text-sm font-medium"><%= t.symbol %></p><p class="text-xs text-slate-500"><%= t.quantity %> shares</p></div>
                  <span class="text-sm font-semibold <%= t.profit >= 0 ? 'text-emerald-600' : 'text-red-600' %>">$<%= Number(t.profit || 0).toFixed(2) %></span>
                </div>
              <% }) %>
              <a href="/trading-history" class="btn-soft flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-medium mt-2">View All Trades <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
            <% } %>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-semibold font-display">Top Holdings</h3>
            <a href="/stocks" class="text-sm text-brand-600 hover:text-brand-700 font-medium">View All →</a>
          </div>
          <div class="space-y-3">
            <% if (!holdings || holdings.length === 0) { %>
              <div class="text-center py-10">
                <i data-lucide="briefcase" class="w-12 h-12 text-slate-300 mx-auto mb-4"></i>
                <p class="text-slate-500 mb-4">No holdings yet</p>
                <a href="/stocks" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-50 text-brand-600 hover:bg-brand-100 transition-colors text-sm font-semibold"><i data-lucide="plus" class="w-4 h-4"></i> Add Stocks</a>
              </div>
            <% } else { %>
              <% holdings.slice(0, 5).forEach(h => { %>
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100 hover:bg-slate-100 transition-colors">
                  <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-xl bg-brand-50 flex items-center justify-center font-bold text-brand-600"><%= h.symbol.slice(0,2) %></div>
                    <div><p class="text-sm font-medium"><%= h.symbol %></p><p class="text-xs text-slate-500"><%= h.quantity %> shares</p></div>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium">$<%= Number(h.currentPrice || h.avgPrice).toFixed(2) %></p>
                    <p class="text-xs <%= (h.plPercent || 0) >= 0 ? 'text-emerald-600' : 'text-red-600' %>"><%= (h.plPercent || 0) >= 0 ? '↗' : '↘' %> <%= Math.abs(h.plPercent || 0).toFixed(1) %>%</p>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick links -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/kyc-verification" class="card card-hover p-5">
          <span class="h-11 w-11 rounded-xl bg-brand-50 flex items-center justify-center mb-4"><i data-lucide="shield-check" class="w-5 h-5 text-brand-600"></i></span>
          <h4 class="font-semibold mb-1">KYC</h4>
          <p class="text-xs text-slate-500"><%= verified ? 'Verified ✓' : (kycPending ? 'Pending review' : 'Complete now') %></p>
        </a>
        <a href="/copy-trader" class="card card-hover p-5">
          <span class="h-11 w-11 rounded-xl bg-purple-50 flex items-center justify-center mb-4"><i data-lucide="users" class="w-5 h-5 text-purple-600"></i></span>
          <h4 class="font-semibold mb-1">Copy Trading</h4>
          <p class="text-xs text-slate-500">Follow experts</p>
        </a>
        <a href="/packages" class="card card-hover p-5">
          <span class="h-11 w-11 rounded-xl bg-amber-50 flex items-center justify-center mb-4"><i data-lucide="sun" class="w-5 h-5 text-amber-600"></i></span>
          <h4 class="font-semibold mb-1">Packages</h4>
          <p class="text-xs text-slate-500">Upgrade plan</p>
        </a>
        <a href="/support" class="card card-hover p-5">
          <span class="h-11 w-11 rounded-xl bg-cyan-50 flex items-center justify-center mb-4"><i data-lucide="message-circle" class="w-5 h-5 text-cyan-600"></i></span>
          <h4 class="font-semibold mb-1">Support</h4>
          <p class="text-xs text-slate-500">Chat with our support team</p>
        </a>
      </div>
    </div>
  </main>

  <footer class="mt-6 py-8 border-t border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 text-center text-sm text-slate-500">
      <p>&copy; <%= new Date().getFullYear() %> Stocker. All rights reserved.</p>
      <p class="mt-2 text-xs text-slate-400">Trading involves risk. Past performance is not indicative of future results.</p>
    </div>
  </footer>
</div>

<!-- Shared Annexes-style mobile bottom navigation -->
<%- include('mobile-downbar') %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();

    if (typeof ApexCharts !== 'undefined') {
      const perfData = <%- JSON.stringify(performanceData || [10000,10200,10150,10300,10500,10700,10650,10800,11000,11200,11100,11300,11500,11700,11800,12000,11900,12100,12300,12500,12700,12800,13000,13200,13400,13300,13500,13700,13800,14000]) %>;
      const labels = perfData.map((_, i) => 'Day ' + (i + 1));
      new ApexCharts(document.querySelector('#performanceChart'), {
        series: [{ name: 'Portfolio Value', data: perfData }],
        chart: { type: 'area', height: 350, toolbar: { show: false }, background: 'transparent', foreColor: '#8899aa', fontFamily: 'Inter, sans-serif' },
        colors: ['#2457E6'],
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 3 },
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.02, stops: [0, 100] } },
        xaxis: { categories: labels, labels: { style: { colors: '#8899aa' } }, tickAmount: 6 },
        yaxis: { labels: { style: { colors: '#8899aa' }, formatter: v => '$' + Math.round(v).toLocaleString() } },
        grid: { borderColor: 'rgba(255,255,255,.08)', strokeDashArray: 4 },
        tooltip: { theme: 'dark', y: { formatter: v => '$' + v.toLocaleString() } }
      }).render();
    }

    if (typeof TradingView !== 'undefined' && TradingView.widget) {
      function loadChart(symbol) {
        const container = document.getElementById('tradingview_chart');
        if (!container) return;
        container.innerHTML = '';
        new TradingView.widget({
          container_id: 'tradingview_chart', width: '100%', height: '400', symbol: symbol,
          interval: '60', timezone: 'Etc/UTC', theme: 'dark', style: '1', locale: 'en',
          toolbar_bg: '#080d16', enable_publishing: false, allow_symbol_change: true,
          studies: ['MACD@tv-basicstudies', 'RSI@tv-basicstudies']
        });
      }
      loadChart('BITSTAMP:BTCUSD');
      const sel = document.getElementById('symbolSelect');
      if (sel) sel.addEventListener('change', function (e) {
        const map = { BTCUSD: 'BITSTAMP:BTCUSD', ETHUSD: 'BITSTAMP:ETHUSD', SOLUSD: 'BINANCE:SOLUSD', AAPL: 'NASDAQ:AAPL', TSLA: 'NASDAQ:TSLA' };
        loadChart(map[e.target.value] || e.target.value);
      });
    }
  });
</script>

<% if (typeof toast !== 'undefined' && toast && toast.message) { %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swal !== 'undefined') {
      Swal.fire({
        icon: '<%= toast.type || "info" %>',
        title: '<%= toast.message %>',
        toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true,
        background: '#0d1420', color: '#ffffff',
        customClass: { popup: 'border border-slate-700 rounded-2xl' }
      });
    }
  });
</script>
<% } %>

</body>
</html>
