<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof lucide !== 'undefined' && lucide.createIcons) lucide.createIcons();

    if (typeof ApexCharts !== 'undefined') {
      const perfData = <%- JSON.stringify(performanceData || [10000,10200,10150,10300,10500,10700,10650,10800,11000,11200,11100,11300,11500,11700,11800,12000,11900,12100,12300,12500,12700,12800,13000,13200,13400,13300,13500,13700,13800,14000]) %>;
      const labels = perfData.map((_, i) => 'Day ' + (i + 1));
      new ApexCharts(document.querySelector('#performanceChart'), {
        series: [{ name: 'Portfolio Value', data: perfData }],
        chart: { type: 'area', height: 350, toolbar: { show: false }, background: 'transparent', foreColor: '#8899aa', fontFamily: 'Inter, sans-serif', zoom: { enabled: false }, animations: { enabled: true, easing: 'easeinout', speed: 900 } },
        colors: ['#0090ff'],
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 3, lineCap: 'round' },
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.02, stops: [0, 100] } },
        markers: { size: 0, hover: { size: 5 } },
        xaxis: { categories: labels, labels: { style: { colors: '#8899aa' } }, tickAmount: 6, axisBorder: { show: false }, axisTicks: { show: false } },
        yaxis: { labels: { style: { colors: '#8899aa' }, formatter: v => '$' + Math.round(v).toLocaleString() } },
        grid: { borderColor: 'rgba(255,255,255,.06)', strokeDashArray: 4 },
        tooltip: { theme: 'dark', y: { formatter: v => '$' + v.toLocaleString() } }
      }).render();
    }

    if (typeof TradingView !== 'undefined' && TradingView.widget) {
      function loadChart(symbol) {
        const container = document.getElementById('tradingview_chart');
        if (!container) return;
        container.innerHTML = '';
        new TradingView.widget({
          container_id: 'tradingview_chart', width: '100%', height: '400', symbol: symbol,
          interval: '60', timezone: 'Etc/UTC', theme: 'dark', style: '1', locale: 'en',
          toolbar_bg: '#080d16', enable_publishing: false, allow_symbol_change: true,
          studies: ['MACD@tv-basicstudies', 'RSI@tv-basicstudies']
        });
      }
      loadChart('BITSTAMP:BTCUSD');
      const sel = document.getElementById('symbolSelect');
      if (sel) sel.addEventListener('change', function (e) {
        const map = { BTCUSD: 'BITSTAMP:BTCUSD', ETHUSD: 'BITSTAMP:ETHUSD', SOLUSD: 'BINANCE:SOLUSD', AAPL: 'NASDAQ:AAPL', TSLA: 'NASDAQ:TSLA' };
        loadChart(map[e.target.value] || e.target.value);
      });
    }
  });
</script>

<% if (typeof toast !== 'undefined' && toast && toast.message) { %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swal !== 'undefined') {
      Swal.fire({
        icon: '<%= toast.type || "info" %>',
        title: '<%= toast.message %>',
        toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true,
        background: '#0d1420', color: '#ffffff',
        customClass: { popup: 'border border-slate-700/50 rounded-2xl shadow-2xl' }
      });
    }
  });
</script>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-live-prices-track]').forEach(function (track) {
      const group = track.querySelector('.live-prices-group:not([aria-hidden="true"])');
      const viewport = track.parentElement;
      if (!group || !viewport) return;

      let offset = 0;
      let previousTime = 0;
      let paused = false;
      let loopWidth = 0;
      const speed = 32;

      function measure() { loopWidth = group.getBoundingClientRect().width + 16; }
      measure();
      window.addEventListener('resize', measure, { passive: true });
      viewport.addEventListener('mouseenter', function () { paused = true; });
      viewport.addEventListener('mouseleave', function () { paused = false; });
      viewport.addEventListener('touchstart', function () { paused = true; }, { passive: true });
      viewport.addEventListener('touchend', function () { window.setTimeout(function () { paused = false; }, 900); }, { passive: true });
      track.addEventListener('focusin', function () { paused = true; });
      track.addEventListener('focusout', function () { paused = false; });

      function frame(now) {
        if (!previousTime) previousTime = now;
        const elapsed = Math.min(now - previousTime, 50);
        previousTime = now;
        if (!paused && loopWidth > 0) {
          offset = (offset + speed * elapsed / 1000) % loopWidth;
          track.style.transform = 'translate3d(' + (-offset) + 'px,0,0)';
        }
        window.requestAnimationFrame(frame);
      }
      window.requestAnimationFrame(frame);
    });
  });
</script>
