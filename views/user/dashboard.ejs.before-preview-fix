<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Dashboard • <%= user.name || user.username %></title>
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  <script src="https://s3.tradingview.com/tv.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Inter', 'sans-serif'] },
          colors: {
            brand: { 50: '#0d2035', 100: '#12304d', 500: '#0090ff', 600: '#00c8ff', 700: '#00ffd5' },
            ink: { DEFAULT: '#ffffff', soft: '#a7b4c4', mute: '#718096' }
          },
          keyframes: {
            'fade-up': { '0%': { opacity: '0', transform: 'translateY(18px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
            'scale-in': { '0%': { opacity: '0', transform: 'scale(.96)' }, '100%': { opacity: '1', transform: 'scale(1)' } },
            'glow-pulse': { '0%, 100%': { opacity: '0.4' }, '50%': { opacity: '0.8' } },
            'float': { '0%, 100%': { transform: 'translateY(0px)' }, '50%': { transform: 'translateY(-4px)' } },
            'shimmer': { '0%': { transform: 'translateX(-100%)' }, '100%': { transform: 'translateX(100%)' } }
          },
          animation: {
            'fade-up': 'fade-up .6s cubic-bezier(.16,1,.3,1) both',
            'scale-in': 'scale-in .2s ease-out',
            'glow-pulse': 'glow-pulse 2s ease-in-out infinite',
            'float': 'float 3s ease-in-out infinite',
            'shimmer': 'shimmer 2.6s ease-in-out infinite'
          }
        }
      }
    }
  </script>

  <style>
    [x-cloak] { display: none !important; }

    :root {
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --black: #030508;
      --surface: #080d16;
      --card: #0d1420;
      --card2: #111b2b;
      --border: rgba(255,255,255,.07);
      --border-glow: rgba(0,144,255,.25);
      --blue: #0090ff;
      --blue2: #00c8ff;
      --cyan: #00ffd5;
      --green: #00e676;
      --muted: #8899aa;
      --glass: rgba(13,20,32,.72);
    }
    html, body { background: var(--black); }
    body {
      font-family: Inter, sans-serif; overflow-x: hidden; -webkit-font-smoothing: antialiased;
      color: #fff; position: relative; letter-spacing: -0.005em;
    }

    /* Ambient background: soft aurora + fine grid */
    body::before {
      content: ''; position: fixed; inset: 0; z-index: -2; pointer-events: none;
      background:
        radial-gradient(900px 520px at 85% -8%, rgba(0,144,255,.14), transparent 60%),
        radial-gradient(700px 480px at 8% 12%, rgba(0,255,213,.06), transparent 60%),
        radial-gradient(800px 600px at 50% 110%, rgba(0,200,255,.07), transparent 60%),
        var(--black);
    }
    body::after {
      content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none; opacity: .5;
      background-image:
        linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.022) 1px, transparent 1px);
      background-size: 56px 56px;
      -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 0%, transparent 70%);
      mask-image: radial-gradient(ellipse at 50% 0%, #000 0%, transparent 70%);
    }

    /* Premium card */
    .card {
      min-width: 0;
      overflow-wrap: anywhere;
      background: linear-gradient(155deg, rgba(255,255,255,.028) 0%, transparent 55%), var(--card);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      box-shadow: 0 1px 2px rgba(0,0,0,.3), 0 24px 48px -24px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.05);
      transition: box-shadow .35s ease, border-color .35s ease, transform .35s cubic-bezier(.16,1,.3,1);
    }
    .card:hover {
      border-color: rgba(0,144,255,.16);
      box-shadow: 0 1px 2px rgba(0,0,0,.3), 0 28px 56px -24px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.07);
    }
    .card .flex-1 { min-width: 0; }

    /* Balance hero */
    .account-balance-card { container-type: inline-size; }
    .account-balance-value {
      max-width: 100%;
      font-size: clamp(1.5rem, 7cqi, 2.75rem);
      line-height: 1.05;
      overflow-wrap: anywhere;
      font-variant-numeric: tabular-nums;
      background: linear-gradient(180deg, #ffffff 30%, #9fd6ff 100%);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .hero-card {
      background:
        radial-gradient(520px 260px at 100% 0%, rgba(0,144,255,.22), transparent 65%),
        radial-gradient(380px 220px at 0% 100%, rgba(0,255,213,.08), transparent 65%),
        linear-gradient(155deg, rgba(255,255,255,.04) 0%, transparent 55%), var(--card);
    }
    .dashboard-stat-card { container-type: inline-size; }
    .dashboard-stat-value {
      font-size: clamp(1rem, 8cqi, 1.45rem);
      line-height: 1.25;
      overflow-wrap: anywhere;
      font-variant-numeric: tabular-nums;
    }

    /* Stat accent line */
    .stat-accent { position: relative; overflow: hidden; }
    .stat-accent::before {
      content: ''; position: absolute; left: 1.25rem; right: 1.25rem; top: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent, var(--blue2)), transparent);
      opacity: .55; border-radius: 0 0 4px 4px;
    }

    /* Hover lift */
    .card-hover:hover {
      transform: translateY(-4px);
      border-color: rgba(0,176,255,.3);
      box-shadow: 0 26px 44px -18px rgba(0,144,255,.35), 0 0 0 1px rgba(0,176,255,.1);
    }

    /* Buttons */
    .btn-primary {
      position: relative; overflow: hidden;
      background: linear-gradient(135deg, var(--blue) 0%, var(--blue2) 100%);
      color: #030508;
      box-shadow: 0 8px 24px -8px rgba(0,144,255,.6), inset 0 1px 0 rgba(255,255,255,.3);
      transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s ease, filter .25s ease;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 12px 24px -8px rgba(0,144,255,.6); }
    .btn-soft { background: var(--card2); color: #fff; border: 1px solid var(--border); transition: background .2s ease; }
    .btn-soft:hover { background: #172438; }
    .nav-link { color: #a7b4c4; }
    .nav-link:hover { background: rgba(255,255,255,.05); color: #fff; }
    .nav-link.active { background: rgba(0,144,255,.13); color: var(--blue2); font-weight: 600; }
    /* Continuous live-price ticker */
    .live-prices-viewport { display:block!important; overflow:hidden!important; width:100%; }
    .live-prices-track { display:flex!important; flex-wrap:nowrap!important; width:max-content!important; gap:1rem; transform:translate3d(0,0,0); will-change:transform; }
    .live-prices-group { display:flex!important; flex:none!important; width:max-content!important; gap:1rem; }
    .live-prices-card { box-sizing:border-box; display:flex; flex:0 0 190px!important; width:190px; min-width:190px; align-items:center; white-space:nowrap; }
    @keyframes live-prices-scroll { from { transform:translateX(0); } to { transform:translateX(-50%); } }
    .mobile-downbar { padding-bottom: calc(8px + var(--safe-bottom)); box-shadow: 0 -10px 30px rgba(0,0,0,.45); }

    .btn-primary::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.35) 50%, transparent 70%);
      transform: translateX(-100%); transition: transform .7s ease;
    }
    .btn-primary:hover { transform: translateY(-2px); filter: brightness(1.05); box-shadow: 0 14px 32px -10px rgba(0,144,255,.7), inset 0 1px 0 rgba(255,255,255,.4); }
    .btn-primary:hover::after { transform: translateX(100%); }
    .btn-primary:active, .btn-soft:active { transform: translateY(0) scale(.985); }
    .btn-soft {
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01)), var(--card2);
      color: #fff;
      border: 1px solid var(--border);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
      transition: background .2s ease, border-color .2s ease, transform .2s ease;
      font-weight: 600;
    }
    .btn-soft:hover { background: #172438; border-color: rgba(0,200,255,.22); }

    /* Navigation */
    .nav-link { color: #a7b4c4; transition: all .2s ease; position: relative; }
    .nav-link:hover { background: rgba(255,255,255,.05); color: #fff; transform: translateX(2px); }
    .nav-link.active {
      background: linear-gradient(90deg, rgba(0,144,255,.18) 0%, rgba(0,200,255,.03) 100%);
      color: var(--blue2);
      font-weight: 600;
      box-shadow: inset 3px 0 0 var(--blue2);
    }

    /* Mobile downbar */
    .mobile-downbar { padding-bottom: calc(8px + var(--safe-bottom)); box-shadow: 0 -10px 30px rgba(0,0,0,.5); }
    @media (max-width: 767px) { body { padding-bottom: calc(88px + var(--safe-bottom)); } }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #263448; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #2f4055; }

    /* Glass header */
    .glass-header {
      background: var(--glass);
      backdrop-filter: blur(22px) saturate(1.5);
      -webkit-backdrop-filter: blur(22px) saturate(1.5);
      border-bottom: 1px solid rgba(255,255,255,.06);
    }

    /* Keep the reference layout while using the homepage's dark palette. */
    [class~="bg-white"], [class~="bg-white/90"], [class~="bg-white/95"] { background-color: var(--surface) !important; }
    [class~="bg-slate-50"], [class~="bg-slate-50/80"] { background-color: rgba(255,255,255,.035) !important; }
    [class~="bg-slate-100"] { background-color: rgba(255,255,255,.06) !important; }
    [class~="bg-slate-200"] { background-color: rgba(255,255,255,.1) !important; }
    [class~="border-slate-100"], [class~="border-slate-200"] { border-color: var(--border) !important; }
    [class~="text-slate-900"], [class~="text-slate-800"], [class~="text-ink"] { color: #fff !important; }
    [class~="text-slate-700"] { color: #d5deea !important; }
    [class~="text-slate-600"] { color: #a7b4c4 !important; }
    [class~="text-slate-500"] { color: var(--muted) !important; }
    [class~="text-slate-400"] { color: #718096 !important; }
    [class~="text-brand-600"] { color: var(--blue2) !important; }
    [class~="bg-brand-50"] { background-color: rgba(0,144,255,.12) !important; }
    [class~="bg-emerald-50"] { background-color: rgba(0,230,118,.12) !important; }
    [class~="bg-amber-50"] { background-color: rgba(255,192,64,.12) !important; }
    [class~="bg-red-50"], [class~="bg-rose-50"] { background-color: rgba(255,61,90,.12) !important; }
    [class~="bg-orange-50"] { background-color: rgba(255,159,67,.12) !important; }
    [class~="bg-purple-50"] { background-color: rgba(168,85,247,.12) !important; }
    [class~="bg-cyan-50"] { background-color: rgba(0,200,255,.1) !important; }
    [class~="text-emerald-700"] { color: #00e676 !important; }
    [class~="text-amber-700"] { color: #ffc040 !important; }
    [class~="text-red-600"], [class~="text-rose-600"] { color: #ff6078 !important; }
    [class~="hover:bg-slate-50"]:hover { background-color: rgba(255,255,255,.05) !important; }
    [class~="hover:bg-slate-100"]:hover, [class~="hover:bg-slate-200"]:hover { background-color: rgba(255,255,255,.09) !important; }
    [class~="hover:bg-brand-100"]:hover { background-color: rgba(0,144,255,.2) !important; }

    /* Premium touches */
    .glow-text { text-shadow: 0 0 28px rgba(0,200,255,.22); }
    .gradient-border { position: relative; }
    .gradient-border::before {
      content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
      background: linear-gradient(135deg, rgba(0,144,255,.45), rgba(0,255,213,.1) 40%, transparent 65%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
      pointer-events: none;
    }
    .stat-glow { position: relative; overflow: hidden; }
    .stat-glow::after {
      content: ''; position: absolute; top: -40%; right: -20%; width: 140px; height: 140px;
      background: radial-gradient(circle, rgba(0,144,255,.09) 0%, transparent 70%);
      border-radius: 50%; pointer-events: none;
    }
    .live-dot { position: relative; }
    .live-dot::after {
      content: ''; position: absolute; inset: -3px; border-radius: 50%;
      background: rgba(0,230,118,.3); animation: glow-pulse 2s ease-in-out infinite;
    }

    /* Live price movement feedback */
    .live-price-value { display: inline-block; transition: color .25s ease, transform .25s ease; font-variant-numeric: tabular-nums; }
    .live-price-card { transition: border-color .3s ease, background-color .3s ease; }
    .price-up { animation: price-flash-up .7s ease; }
    .price-down { animation: price-flash-down .7s ease; }
    @keyframes price-flash-up { 0%, 100% { text-shadow: none; } 35% { text-shadow: 0 0 14px rgba(0,230,118,.75); transform: translateY(-1px); } }
    @keyframes price-flash-down { 0%, 100% { text-shadow: none; } 35% { text-shadow: 0 0 14px rgba(255,96,120,.75); transform: translateY(1px); } }
    @media (prefers-reduced-motion: reduce) { .price-up, .price-down { animation: none; } }

    /* Continuous scroll animation for the full crypto list */
    @keyframes scroll-prices {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .animate-scroll-prices {
      display: flex;
      width: max-content;
      animation: scroll-prices 60s linear infinite;
      gap: 0.75rem;
    }
    .animate-scroll-prices:hover {
      animation-play-state: paused;
    }
    /* Fade mask on the edges */
    .live-prices-wrapper {
      position: relative;
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    }
    .live-price-card {
      min-width: 160px;
      flex-shrink: 0;
    }

    /* Icon chip */
    .icon-chip {
      display: inline-flex; align-items: center; justify-content: center;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 6px 16px -8px currentColor;
    }

    /* Section eyebrow */
    .eyebrow {
      font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
      color: var(--blue2); opacity: .85;
    }

    /* Signal bar shimmer */
    .signal-fill { position: relative; overflow: hidden; }
    .signal-fill::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);
      animation: shimmer 2.6s ease-in-out infinite;
    }

    /* Stagger entrance */
    .stagger > * { animation: fade-up .6s cubic-bezier(.16,1,.3,1) both; }
    .stagger > *:nth-child(1) { animation-delay: .02s; }
    .stagger > *:nth-child(2) { animation-delay: .08s; }
    .stagger > *:nth-child(3) { animation-delay: .14s; }
    .stagger > *:nth-child(4) { animation-delay: .20s; }
    .stagger > *:nth-child(5) { animation-delay: .26s; }
    .stagger > *:nth-child(6) { animation-delay: .32s; }
    .stagger > *:nth-child(7) { animation-delay: .38s; }
    .stagger > *:nth-child(8) { animation-delay: .44s; }
    .stagger > *:nth-child(9) { animation-delay: .50s; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
    }
  </style>
</head>

<%
  const money = (n) => Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const btcPrice = Number((cryptoPrices && cryptoPrices.btc) || 67432.15);
  const btcEq = (Number(user.balance || 0) / btcPrice).toFixed(6);
  const verified = String(user.kycStatus || '').trim().toLowerCase() === 'verified';
  const kycPending = String(user.kycStatus || '').trim().toLowerCase() === 'pending';
  const initial = (user.name || user.username).slice(0, 1).toUpperCase();
  const signalSource = typeof accountSignal !== 'undefined' && accountSignal !== null
    ? accountSignal
    : (user.signal ?? 100);
  const parsedSignal = Number(signalSource);
  const signalValue = Number.isFinite(parsedSignal)
    ? Math.max(0, Math.min(100, parsedSignal))
    : 100;
  const lastUpdated = new Date().toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const hour = new Date().getHours();
  const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
%>

<body class="min-h-screen font-sans"
      x-data="{
        mobileSidebarOpen: false,
        notificationOpen: false,
        userMenuOpen: false,
        priceTimer: null,
        priceDirection: { btc: 'same', eth: 'same', sol: 'same' },
        cryptoPrices: [],
        init() {
          this.updateCryptoPrices();
          this.priceTimer = setInterval(() => this.updateCryptoPrices(), 60000);
        },
        destroy() {
          if (this.priceTimer) clearInterval(this.priceTimer);
        },
        async updateCryptoPrices() {
          try {
            const url = 'https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=50&page=1&sparkline=false';
            const response = await fetch(url, { cache: 'no-store' });
            if (!response.ok) throw new Error('Failed to fetch prices');
            const data = await response.json();
            this.cryptoPrices = data.map(coin => ({
              id: coin.id,
              symbol: coin.symbol.toUpperCase(),
              name: coin.name,
              price: coin.current_price,
              change24h: coin.price_change_percentage_24h,
              image: coin.image
            }));
          } catch (error) {
            console.error('Live price fetch failed:', error);
          }
        },
        formatPrice(value) {
          if (value === null || value === undefined) return '$0.00';
          if (value < 0.01) return '$' + value.toFixed(6);
          if (value < 1) return '$' + value.toFixed(4);
          return '$' + value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
      }"
      @keydown.escape="mobileSidebarOpen = false; notificationOpen = false; userMenuOpen = false">

<!-- Mobile sidebar backdrop -->
<div x-show="mobileSidebarOpen" x-cloak @click="mobileSidebarOpen = false"
     class="fixed inset-0 z-30 bg-slate-900/60 backdrop-blur-sm md:hidden transition-opacity duration-300"></div>

<!-- Notification Panel -->
<div x-show="notificationOpen" x-cloak @click.outside="notificationOpen = false"
     class="fixed right-4 top-20 w-80 max-w-[calc(100vw-2rem)] card shadow-2xl z-50 max-h-96 overflow-y-auto animate-scale-in gradient-border">
  <div class="p-4 border-b border-slate-100 flex items-center justify-between">
    <h3 class="font-semibold font-display">Notifications</h3>
    <button @click="notificationOpen = false" class="text-slate-400 hover:text-slate-700 transition-colors"><i data-lucide="x" class="w-5 h-5"></i></button>
  </div>
  <div class="p-4 hover:bg-slate-50 transition-colors">
    <div class="flex items-start gap-3">
      <div class="h-10 w-10 rounded-xl bg-emerald-50 flex items-center justify-center"><i data-lucide="trending-up" class="text-emerald-600 w-5 h-5"></i></div>
      <div class="flex-1">
        <p class="text-sm font-medium">Welcome to Global Equinox Trade</p>
        <p class="text-xs text-slate-500 mt-1">Your account is active and ready to trade</p>
        <span class="text-xs text-slate-400 mt-2 block">Just now</span>
      </div>
    </div>
  </div>
</div>

<!-- SIDEBAR -->
<aside class="fixed inset-y-0 left-0 z-40 w-64 flex flex-col bg-[#080d16]/95 backdrop-blur-xl border-r border-white/[0.06] transition-transform duration-300 md:translate-x-0"
       :class="mobileSidebarOpen ? 'translate-x-0' : '-translate-x-full'">

  <div class="p-5 border-b border-white/[0.06] flex items-center justify-between">
    <img src="/temp/custom/img/logo.png" alt="Logo" class="h-11 w-auto">
    <button @click="mobileSidebarOpen = false" class="md:hidden text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-5 h-5"></i></button>
  </div>

  <div class="p-4 border-b border-white/[0.06]">
    <div class="flex items-center gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/[0.06]">
      <div class="h-11 w-11 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-[#030508] font-bold shadow-lg shadow-brand-500/25 ring-2 ring-white/10"><%= initial %></div>
      <div class="flex-1 min-w-0">
        <p class="font-semibold truncate font-display text-sm"><%= user.name || user.username %></p>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-xs text-slate-500">Standard</span>
          <% if (verified) { %>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium">Verified</span>
          <% } else if (kycPending) { %>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium">Pending review</span>
          <% } else { %>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium">Unverified</span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <nav class="p-3 space-y-1 flex-1 overflow-y-auto text-sm">
    <a href="/" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="home" class="w-5 h-5"></i><span>Home</span></a>
    <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %> flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors">
      <i data-lucide="layout-dashboard" class="w-5 h-5"></i><span>Dashboard</span>
    </a>

    <p class="pt-5 pb-1 px-4 text-[10px] font-semibold text-slate-400 uppercase tracking-[.18em]">Trading</p>
    <a href="/stocks" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="trending-up" class="w-5 h-5"></i><span>Stocks</span><span class="ml-auto text-[11px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-medium">Hot</span></a>
    <a href="/copy-trader" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="users" class="w-5 h-5"></i><span>Copy Trading</span></a>
    <a href="/trading-history" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="clock" class="w-5 h-5"></i><span>Trading History</span></a>
    <a href="/pl-record" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="bar-chart-2" class="w-5 h-5"></i><span>P/L Record</span></a>

    <p class="pt-5 pb-1 px-4 text-[10px] font-semibold text-slate-400 uppercase tracking-[.18em]">Financial</p>
    <a href="/deposit-withdrawal" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="arrow-down-circle" class="w-5 h-5"></i><span>Deposit</span></a>
    <a href="/withdraw" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="arrow-up-circle" class="w-5 h-5"></i><span>Withdraw</span></a>
    <a href="/transactions-history" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="credit-card" class="w-5 h-5"></i><span>Funding History</span></a>

    <p class="pt-5 pb-1 px-4 text-[10px] font-semibold text-slate-400 uppercase tracking-[.18em]">Account</p>
    <a href="/account" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="user" class="w-5 h-5"></i><span>Profile</span></a>
    <a href="/kyc-verification" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors">
      <i data-lucide="shield" class="w-5 h-5"></i><span>KYC</span>
      <% if (!verified) { %><i data-lucide="clock" class="w-4 h-4 text-amber-500 ml-auto"></i><% } %>
    </a>
    <a href="/support" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="message-circle" class="w-5 h-5"></i><span>Support</span></a>
    <a href="/packages" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="sun" class="w-5 h-5"></i><span>Packages</span></a>
    <a href="/package-history" class="nav-link flex items-center gap-3 px-4 py-2.5 rounded-xl transition-colors"><i data-lucide="package" class="w-5 h-5"></i><span>Package History</span></a>

    <div class="pt-4 mt-4 border-t border-white/[0.06]">
      <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-red-400 hover:bg-red-500/10 transition-colors mt-1"><i data-lucide="log-out" class="w-5 h-5"></i><span>Logout</span></a>
    </div>
  </nav>
</aside>

<!-- MAIN -->
<div class="min-h-screen md:ml-64">

  <!-- Header -->
  <header class="sticky top-0 z-30 glass-header">
    <div class="px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
      <div class="flex items-center gap-3">
        <button @click="mobileSidebarOpen = true" class="md:hidden h-10 w-10 rounded-xl bg-white/[0.06] border border-white/[0.08] flex items-center justify-center hover:bg-white/[0.1] transition-colors">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="hidden md:flex items-center gap-2 text-sm">
          <span class="text-slate-500">Dashboard</span>
          <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
          <span class="font-medium">Overview</span>
        </div>
      </div>

      <div class="hidden lg:flex items-center gap-2 text-sm">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.06]"><span class="h-2 w-2 rounded-full bg-emerald-500 live-dot"></span><span class="text-slate-600 text-xs font-medium"><%= marketData?.marketOpen ? 'Market Open' : 'Market Closed' %></span></div>
        <template x-if="cryptoPrices.length > 0">
          <div class="flex items-center gap-2">
            <template x-for="coin in cryptoPrices.slice(0, 3)" :key="coin.id">
              <div class="px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.06]">
                <span class="text-slate-400 text-xs" x-text="coin.symbol"></span>
                <span class="text-emerald-400 font-semibold ml-1 tabular-nums" x-text="formatPrice(coin.price)"></span>
              </div>
            </template>
          </div>
        </template>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <a href="/deposit-withdrawal" class="hidden sm:flex btn-primary items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold">
          <i data-lucide="plus" class="w-4 h-4"></i> Quick Deposit
        </a>

        <button @click="notificationOpen = !notificationOpen" class="h-10 w-10 rounded-xl bg-white/[0.06] border border-white/[0.08] flex items-center justify-center hover:bg-white/[0.1] transition-colors relative">
          <i data-lucide="bell" class="w-5 h-5"></i>
          <span class="absolute top-2 right-2 h-2 w-2 rounded-full bg-brand-500 ring-2 ring-[#0d1420]"></span>
        </button>

        <div class="relative">
          <button @click="userMenuOpen = !userMenuOpen" class="flex items-center gap-2 sm:gap-3 px-2 sm:px-3 py-1.5 rounded-xl bg-white/[0.06] border border-white/[0.08] hover:bg-white/[0.1] transition-colors">
            <div class="h-8 w-8 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center font-semibold text-[#030508] text-sm shadow-md shadow-brand-500/20"><%= initial %></div>
            <div class="hidden sm:block text-left">
              <p class="text-sm font-medium leading-tight"><%= user.username %></p>
              <p class="text-xs text-slate-500 tabular-nums">$<%= money(user.balance) %></p>
            </div>
            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 transition-transform duration-200" :class="{'rotate-180': userMenuOpen}"></i>
          </button>

          <div x-show="userMenuOpen" x-cloak @click.outside="userMenuOpen = false"
               class="absolute right-0 mt-2 w-56 card py-2 z-50 animate-scale-in gradient-border">
            <div class="px-4 py-3 border-b border-white/[0.06]">
              <p class="text-sm font-medium"><%= user.name || user.username %></p>
              <p class="text-xs text-slate-500 mt-1"><%= user.kycStatus || 'Not Verified' %></p>
            </div>
            <div class="py-1 text-sm">
              <a href="/account" class="flex items-center gap-3 px-4 py-2.5 hover:bg-white/[0.05] transition-colors"><i data-lucide="user" class="w-4 h-4"></i>Profile Settings</a>
              <a href="/kyc-verification" class="flex items-center gap-3 px-4 py-2.5 hover:bg-white/[0.05] transition-colors"><i data-lucide="shield" class="w-4 h-4"></i>KYC Verification</a>
            </div>
            <div class="border-t border-white/[0.06] pt-1">
              <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 text-red-400 hover:bg-red-500/10 text-sm transition-colors"><i data-lucide="log-out" class="w-4 h-4"></i>Logout</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live ticker strip (mobile + tablet) -->
    <div class="border-t border-white/[0.06] bg-white/[0.02] px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between text-xs sm:text-sm lg:hidden">
      <div class="flex items-center gap-3 overflow-x-auto whitespace-nowrap">
        <span class="flex items-center gap-1.5 text-slate-500 font-medium"><span class="h-2 w-2 rounded-full bg-emerald-500 live-dot"></span>LIVE</span>
        <template x-if="cryptoPrices.length > 0">
          <template x-for="coin in cryptoPrices.slice(0, 2)" :key="coin.id">
            <span><span class="text-slate-400" x-text="coin.symbol + ':'"></span> <span class="text-emerald-400 font-semibold tabular-nums" x-text="formatPrice(coin.price)"></span></span>
          </template>
        </template>
      </div>
      <div class="text-right shrink-0 pl-3"><span class="text-slate-400">Balance:</span> <span class="font-bold tabular-nums">$<%= money(user.balance) %></span></div>
    </div>
  </header>

  <!-- Content -->
  <main class="p-4 sm:p-6 lg:p-8">
    <% if (typeof impersonating !== 'undefined' && impersonating) { %>
      <div class="mb-6 rounded-2xl border border-amber-200/30 bg-amber-500/10 px-5 py-4 text-sm text-amber-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 backdrop-blur-sm">
        <span class="font-medium">Account preview mode is active.</span>
        <a href="/secure/stop-preview" class="inline-flex items-center justify-center rounded-xl bg-amber-500 px-4 py-2 text-xs font-semibold text-white hover:bg-amber-600 transition-colors">Exit Preview</a>
      </div>
    <% } %>

    <div class="max-w-7xl mx-auto space-y-6 stagger">

      <!-- Welcome -->
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 text-center md:text-left">
        <div>
          <p class="eyebrow"><%= greeting %></p>
          <h2 class="text-2xl sm:text-4xl font-bold font-display tracking-tight glow-text mt-1">Welcome back, <%= user.name || user.username %></h2>
          <p class="text-slate-500 mt-1.5">Your investment dashboard overview</p>
        </div>
        <div class="inline-flex self-center md:self-auto items-center gap-2 px-3.5 py-2 rounded-full bg-white/[0.04] border border-white/[0.07] text-xs text-slate-500">
          <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-brand-600"></i>
          <span>Updated <%= lastUpdated %></span>
        </div>
      </div>

      <!-- Account signal -->
      <section class="card p-5 sm:p-6 gradient-border" aria-label="Account signal">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h3 class="flex items-center gap-3 font-semibold font-display">
            <span class="icon-chip h-9 w-9 rounded-xl bg-brand-500/10 text-brand-600"><i data-lucide="activity" class="h-5 w-5"></i></span>
            Account Signal
          </h3>
          <span class="text-lg font-bold tabular-nums <%= signalValue === 0 ? 'text-red-400' : signalValue < 40 ? 'text-amber-400' : 'text-emerald-400' %>"><%= signalValue %>%</span>
        </div>
        <div class="h-3 overflow-hidden rounded-full bg-white/[0.06] ring-1 ring-inset ring-white/[0.05]" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= signalValue %>" aria-label="Account signal level">
          <div class="signal-fill h-full rounded-full bg-gradient-to-r from-red-500 via-amber-400 to-emerald-500 transition-all duration-700 ease-out" style="width: <%= signalValue %>%"></div>
        </div>
        <% if (signalValue === 0) { %>
          <p class="mt-3 flex items-start gap-2 text-xs text-red-300">
            <i data-lucide="lock" class="mt-0.5 h-4 w-4 shrink-0"></i>
            Your account signal has been exhausted. Certain account actions are temporarily unavailable. Please contact support for further assistance.
          </p>
        <% } %>
      </section>

      <!-- Balance + stats -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

        <!-- Account balance card -->
        <div class="card hero-card account-balance-card p-6 sm:p-8 lg:col-span-2 text-center gradient-border stat-glow">
          <div class="flex items-center justify-center gap-2 text-ink">
            <span class="icon-chip h-9 w-9 rounded-xl bg-brand-500/10 text-brand-600"><i data-lucide="wallet" class="w-5 h-5"></i></span>
            <h3 class="text-lg font-semibold font-display">Account Balance</h3>
          </div>
          <p class="text-sm text-slate-500 mt-2">Your available funds</p>

          <p class="account-balance-value font-extrabold font-display mt-5 tracking-tight">$<%= money(user.balance) %></p>

          <div class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-300 font-semibold text-sm tabular-nums">
            <span class="h-5 w-5 rounded-full bg-orange-500 text-white text-[11px] flex items-center justify-center font-bold">₿</span>
            <%= btcEq %> BTC
          </div>

          <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/[0.06] text-slate-300 text-xs font-medium">
              <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-400"></i> Available for Withdrawal
            </span>
            <% if (verified) { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-300 text-xs font-semibold"><i data-lucide="badge-check" class="w-3.5 h-3.5"></i> Verified</span>
            <% } else if (kycPending) { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-500/10 text-amber-300 text-xs font-semibold"><i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending review</span>
            <% } else { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-500/10 text-red-300 text-xs font-semibold"><i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> Unverified</span>
            <% } %>
          </div>

          <div class="mt-6 grid grid-cols-2 gap-3">
            <a href="/deposit-withdrawal" class="btn-primary flex items-center justify-center gap-2 py-3 rounded-xl text-sm font-semibold"><i data-lucide="plus-circle" class="w-4 h-4"></i> Deposit</a>
            <a href="/withdraw" class="btn-soft flex items-center justify-center gap-2 py-3 rounded-xl text-sm font-semibold"><i data-lucide="arrow-up-right" class="w-4 h-4"></i> Withdraw</a>
          </div>
        </div>

        <!-- Right column -->
        <div class="lg:col-span-3 space-y-6">
          <div class="grid grid-cols-2 gap-4">
            <div class="card card-hover stat-accent dashboard-stat-card p-5 stat-glow" style="--accent:#00e676">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Profit Available</span>
                <span class="icon-chip h-9 w-9 rounded-xl bg-emerald-500/10 text-emerald-400"><i data-lucide="dollar-sign" class="w-4 h-4"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3 <%= (user.totalProfit || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>">$<%= money(user.totalProfit) %></p>
              <p class="text-xs text-slate-500 mt-2">After requested withdrawals</p>
            </div>

            <div class="card card-hover stat-accent dashboard-stat-card p-5 stat-glow" style="--accent:#00c8ff">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Deposit</span>
                <span class="icon-chip h-9 w-9 rounded-xl bg-brand-500/10 text-brand-600"><i data-lucide="arrow-down" class="w-4 h-4"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3">$<%= money(user.depositBalance) %></p>
              <p class="text-xs text-slate-500 mt-2">Current funds available for trading</p>
            </div>

            <div class="card card-hover stat-accent dashboard-stat-card p-5 stat-glow" style="--accent:#ff6078">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Withdrawals Paid</span>
                <span class="icon-chip h-9 w-9 rounded-xl bg-rose-500/10 text-rose-400"><i data-lucide="arrow-up" class="w-4 h-4"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3">$<%= money(user.totalWithdrawal) %></p>
              <p class="text-xs text-slate-500 mt-2">$<%= money(user.pendingWithdrawal) %> pending</p>
            </div>

            <div class="card card-hover stat-accent dashboard-stat-card p-5 stat-glow" style="--accent:#ffc040">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-500">Bonus</span>
                <span class="icon-chip h-9 w-9 rounded-xl bg-amber-500/10 text-amber-400"><i data-lucide="gift" class="w-4 h-4"></i></span>
              </div>
              <p class="dashboard-stat-value font-bold font-display mt-3">$<%= money(user.bonus) %></p>
              <p class="text-xs text-slate-500 mt-2 flex items-center gap-1.5"><i data-lucide="calendar" class="w-3.5 h-3.5"></i> All time</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="card p-5 flex items-center justify-between stat-glow">
              <div>
                <p class="text-sm text-slate-500">Open Trades</p>
                <p class="text-3xl font-bold font-display mt-1 tabular-nums"><%= openTrades || 0 %></p>
              </div>
              <span class="icon-chip h-11 w-11 rounded-xl bg-brand-500/10 text-brand-600"><i data-lucide="activity" class="w-5 h-5"></i></span>
            </div>
            <div class="card p-5 flex items-center justify-between stat-glow">
              <div>
                <p class="text-sm text-slate-500">Win Rate</p>
                <p class="text-3xl font-bold font-display mt-1 tabular-nums"><%= user.winRate || '0.0' %>%</p>
              </div>
              <span class="icon-chip h-11 w-11 rounded-xl bg-emerald-500/10 text-emerald-400"><i data-lucide="target" class="w-5 h-5"></i></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Identity verification -->
      <% if (!verified) { %>
      <div class="card p-6 sm:p-8 text-center gradient-border" style="background: radial-gradient(500px 200px at 50% 0%, rgba(0,144,255,.12), transparent 70%), var(--card);">
        <span class="icon-chip mx-auto h-14 w-14 rounded-2xl bg-brand-500/10 text-brand-600"><i data-lucide="shield-check" class="w-7 h-7"></i></span>
        <h3 class="text-xl font-semibold font-display mt-4"><%= kycPending ? 'Verification in review' : 'Identity Verification' %></h3>
        <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto"><%= kycPending ? 'Your documents were submitted and are waiting for admin review.' : 'Verify your identity to unlock withdrawals, higher limits and full account protection.' %></p>
        <% if (!kycPending) { %><a href="/kyc-verification" class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold mt-5"><i data-lucide="shield" class="w-4 h-4"></i> Verify Now</a><% } %>
      </div>
      <% } %>

      <!-- Live prices (Continuous Ticker - ALL COINS) -->
      <div class="card p-5 gradient-border">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2.5">
            <h3 class="text-lg font-semibold font-display">Live Prices</h3>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-400 px-2 py-0.5 rounded-full bg-emerald-500/10">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 live-dot"></span>LIVE
            </span>
          </div>
          <a href="/stocks" class="text-sm text-brand-600 hover:text-brand-700 font-medium transition-colors">View All →</a>
        </div>
        <div class="live-prices-viewport" aria-label="Moving live cryptocurrency prices">
          <div class="live-prices-track" tabindex="0" data-live-prices-track>
            <div class="live-prices-group">
              <div class="live-prices-card gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100"><span class="h-10 w-10 flex-none rounded-full bg-orange-50 flex items-center justify-center"><i data-lucide="bitcoin" class="w-5 h-5 text-orange-500"></i></span><div class="min-w-0"><p class="text-xs text-slate-500">BTC/USD</p><span class="text-lg font-bold font-display tabular-nums" x-text="'$' + cryptoPrices.btc.toLocaleString('en-US', {minimumFractionDigits: 0})"></span></div></div>
              <div class="live-prices-card gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100"><span class="h-10 w-10 flex-none rounded-full bg-brand-50 flex items-center justify-center"><i data-lucide="hexagon" class="w-5 h-5 text-brand-600"></i></span><div class="min-w-0"><p class="text-xs text-slate-500">ETH/USD</p><span class="text-lg font-bold font-display tabular-nums" x-text="'$' + cryptoPrices.eth.toLocaleString('en-US', {minimumFractionDigits: 2})"></span></div></div>
              <div class="live-prices-card gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100"><span class="h-10 w-10 flex-none rounded-full bg-purple-50 flex items-center justify-center"><i data-lucide="sun" class="w-5 h-5 text-purple-600"></i></span><div class="min-w-0"><p class="text-xs text-slate-500">SOL/USD</p><span class="text-lg font-bold font-display tabular-nums" x-text="'$' + cryptoPrices.sol.toLocaleString('en-US', {minimumFractionDigits: 2})"></span></div></div>
            </div>
            <div class="live-prices-group" aria-hidden="true">
              <div class="live-prices-card gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100"><span class="h-10 w-10 flex-none rounded-full bg-orange-50 flex items-center justify-center"><i data-lucide="bitcoin" class="w-5 h-5 text-orange-500"></i></span><div class="min-w-0"><p class="text-xs text-slate-500">BTC/USD</p><span class="text-lg font-bold font-display tabular-nums" x-text="'$' + cryptoPrices.btc.toLocaleString('en-US', {minimumFractionDigits: 0})"></span></div></div>
              <div class="live-prices-card gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100"><span class="h-10 w-10 flex-none rounded-full bg-brand-50 flex items-center justify-center"><i data-lucide="hexagon" class="w-5 h-5 text-brand-600"></i></span><div class="min-w-0"><p class="text-xs text-slate-500">ETH/USD</p><span class="text-lg font-bold font-display tabular-nums" x-text="'$' + cryptoPrices.eth.toLocaleString('en-US', {minimumFractionDigits: 2})"></span></div></div>
              <div class="live-prices-card gap-3 p-4 rounded-2xl bg-slate-50 border border-slate-100"><span class="h-10 w-10 flex-none rounded-full bg-purple-50 flex items-center justify-center"><i data-lucide="sun" class="w-5 h-5 text-purple-600"></i></span><div class="min-w-0"><p class="text-xs text-slate-500">SOL/USD</p><span class="text-lg font-bold font-display tabular-nums" x-text="'$' + cryptoPrices.sol.toLocaleString('en-US', {minimumFractionDigits: 2})"></span></div></div>
            </div>
          </div>
        </div>
      </div>
      <!-- Charts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-5 gradient-border">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold font-display">Market Chart</h3>
            <select id="symbolSelect" class="px-3 py-2 rounded-xl bg-white/[0.04] border border-white/[0.08] text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500/50 transition-all">
