              <option value="ETHUSD">ETH/USD</option>
              <option value="SOLUSD">SOL/USD</option>
              <option value="AAPL">AAPL</option>
              <option value="TSLA">TSLA</option>
            </select>
          </div>
          <div id="tradingview_chart" class="h-[400px] rounded-2xl overflow-hidden ring-1 ring-white/[0.06]"></div>
        </div>

        <div class="card p-5 gradient-border">
          <div class="mb-4">
            <h3 class="text-lg font-semibold font-display">Portfolio Growth</h3>
            <p class="text-sm text-slate-500">30-day performance</p>
          </div>
          <div id="performanceChart" style="height: 350px;"></div>
        </div>
      </div>

      <% if (closeableTradesCount > 0) { %>
      <section class="card p-5 sm:p-6 gradient-border">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h3 class="text-lg font-semibold font-display">Open Trades <span class="ml-1 text-sm text-slate-400">(<%= closeableTradesCount %>)</span></h3>
            <p class="mt-1 text-sm text-slate-500">Uses live prices where available, otherwise the last recorded P/L. Stops active copy trades.</p>
          </div>
          <form action="/trade/close-all" method="POST" onsubmit="return confirm('Close all <%= closeableTradesCount %> open trades? Live prices will be used where available; otherwise the last recorded P/L is applied. This cannot be undone.');">
            <button type="submit" class="w-full rounded-xl bg-red-500/90 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-600 sm:w-auto shadow-lg shadow-red-500/20">Close All Open Trades</button>
          </form>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <% (openPositions || []).forEach(position => { %>
            <div class="flex items-center justify-between rounded-xl border border-white/[0.06] bg-white/[0.03] p-4 hover:bg-white/[0.05] transition-colors">
              <div>
                <p class="font-semibold"><%= position.symbol %></p>
                <p class="mt-1 text-xs text-slate-500"><%= String(position.side || 'buy').toUpperCase() %> · <%= Number(position.leverage || 1) %>× leverage</p>
              </div>
              <p class="text-sm font-semibold tabular-nums <%= Number(position.pnl || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>">$<%= Number(position.pnl || 0).toFixed(2) %></p>
            </div>
          <% }) %>
          <% (activeCopyTrades || []).forEach(trade => { %>
            <div class="flex items-center justify-between rounded-xl border border-white/[0.06] bg-white/[0.03] p-4 hover:bg-white/[0.05] transition-colors">
              <div>
                <p class="font-semibold"><%= trade.symbol || 'Copy trade' %></p>
                <p class="mt-1 text-xs text-slate-500">Active copy trade</p>
              </div>
              <p class="text-sm font-semibold tabular-nums <%= Number(trade.profit || trade.pnl || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>">$<%= Number(trade.profit || trade.pnl || 0).toFixed(2) %></p>
            </div>
          <% }) %>
        </div>
      </section>
      <% } %>

      <!-- Trades + Holdings -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card p-6 gradient-border">
          <h3 class="text-lg font-semibold font-display mb-5">Recent Trades</h3>
          <div class="space-y-3">
            <% if (!trades || trades.length === 0) { %>
              <div class="text-center py-10">
                <span class="icon-chip mx-auto h-16 w-16 rounded-2xl bg-white/[0.04] text-slate-500 mb-4"><i data-lucide="activity" class="w-8 h-8"></i></span>
                <p class="text-slate-500 mb-4">No trades yet</p>
                <a href="/stocks" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-500/10 text-brand-600 hover:bg-brand-500/20 transition-colors text-sm font-semibold"><i data-lucide="plus" class="w-4 h-4"></i> Start Trading</a>
              </div>
            <% } else { %>
              <% trades.slice(0, 5).forEach(t => { %>
                <div class="flex items-center gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/[0.06] hover:bg-white/[0.05] hover:border-white/[0.1] transition-all">
                  <div class="h-10 w-10 rounded-full <%= t.side === 'BUY' ? 'bg-emerald-500/10' : 'bg-red-500/10' %> flex items-center justify-center">
                    <i data-lucide="<%= t.side === 'BUY' ? 'trending-up' : 'trending-down' %>" class="w-5 h-5 <%= t.side === 'BUY' ? 'text-emerald-400' : 'text-red-400' %>"></i>
                  </div>
                  <div class="flex-1"><p class="text-sm font-medium"><%= t.symbol %></p><p class="text-xs text-slate-500"><%= t.quantity %> shares</p></div>
                  <span class="text-sm font-semibold tabular-nums <%= t.profit >= 0 ? 'text-emerald-400' : 'text-red-400' %>">$<%= Number(t.profit || 0).toFixed(2) %></span>
                </div>
              <% }) %>
              <a href="/trading-history" class="btn-soft flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-medium mt-2">View All Trades <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
            <% } %>
          </div>
        </div>

        <div class="card p-6 gradient-border">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-semibold font-display">Top Holdings</h3>
            <a href="/stocks" class="text-sm text-brand-600 hover:text-brand-700 font-medium transition-colors">View All →</a>
          </div>
          <div class="space-y-3">
            <% if (!holdings || holdings.length === 0) { %>
              <div class="text-center py-10">
                <span class="icon-chip mx-auto h-16 w-16 rounded-2xl bg-white/[0.04] text-slate-500 mb-4"><i data-lucide="briefcase" class="w-8 h-8"></i></span>
                <p class="text-slate-500 mb-4">No holdings yet</p>
                <a href="/stocks" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-500/10 text-brand-600 hover:bg-brand-500/20 transition-colors text-sm font-semibold"><i data-lucide="plus" class="w-4 h-4"></i> Add Stocks</a>
              </div>
            <% } else { %>
              <% holdings.slice(0, 5).forEach(h => { %>
                <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.03] border border-white/[0.06] hover:bg-white/[0.05] hover:border-white/[0.1] transition-all">
                  <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-xl bg-brand-500/10 flex items-center justify-center font-bold text-brand-600"><%= h.symbol.slice(0,2) %></div>
                    <div><p class="text-sm font-medium"><%= h.symbol %></p><p class="text-xs text-slate-500"><%= h.quantity %> shares</p></div>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium tabular-nums">$<%= Number(h.currentPrice || h.avgPrice).toFixed(2) %></p>
                    <p class="text-xs tabular-nums <%= (h.plPercent || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>"><%= (h.plPercent || 0) >= 0 ? '↗' : '↘' %> <%= Math.abs(h.plPercent || 0).toFixed(1) %>%</p>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick links -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/kyc-verification" class="card card-hover p-5 gradient-border group">
          <span class="icon-chip h-11 w-11 rounded-xl bg-brand-500/10 text-brand-600 mb-4 transition-transform group-hover:scale-110"><i data-lucide="shield-check" class="w-5 h-5"></i></span>
          <h4 class="font-semibold mb-1">KYC</h4>
          <p class="text-xs text-slate-500"><%= verified ? 'Verified ✓' : (kycPending ? 'Pending review' : 'Complete now') %></p>
        </a>
        <a href="/copy-trader" class="card card-hover p-5 gradient-border group">
          <span class="icon-chip h-11 w-11 rounded-xl bg-purple-500/10 text-purple-400 mb-4 transition-transform group-hover:scale-110"><i data-lucide="users" class="w-5 h-5"></i></span>
          <h4 class="font-semibold mb-1">Copy Trading</h4>
          <p class="text-xs text-slate-500">Follow experts</p>
        </a>
        <a href="/packages" class="card card-hover p-5 gradient-border group">
          <span class="icon-chip h-11 w-11 rounded-xl bg-amber-500/10 text-amber-400 mb-4 transition-transform group-hover:scale-110"><i data-lucide="sun" class="w-5 h-5"></i></span>
          <h4 class="font-semibold mb-1">Packages</h4>
          <p class="text-xs text-slate-500">Upgrade plan</p>
        </a>
        <a href="/support" class="card card-hover p-5 gradient-border group">
          <span class="icon-chip h-11 w-11 rounded-xl bg-cyan-500/10 text-cyan-400 mb-4 transition-transform group-hover:scale-110"><i data-lucide="message-circle" class="w-5 h-5"></i></span>
          <h4 class="font-semibold mb-1">Support</h4>
          <p class="text-xs text-slate-500">Chat with our support team</p>
        </a>
      </div>
    </div>
  </main>

  <footer class="mt-6 py-8 border-t border-white/[0.06] bg-[#080d16]/80">
    <div class="max-w-7xl mx-auto px-4 text-center text-sm text-slate-500">
      <p>&copy; <%= new Date().getFullYear() %> Global Equinox Trade. All rights reserved.</p>
      <p class="mt-2 text-xs text-slate-600">Trading involves risk. Past performance is not indicative of future results.</p>
    </div>
  </footer>
</div>

