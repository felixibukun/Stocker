<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Transactions History</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    .gradient-bg {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }
    .card-gradient {
      background: linear-gradient(145deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.9) 100%);
    }
    .status-badge {
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .status-approved, .status-profit, .status-completed, .status-success {
      background-color: rgba(34, 197, 94, 0.1);
      color: #22c55e;
      border: 1px solid rgba(34, 197, 94, 0.3);
    }
    .status-pending {
      background-color: rgba(234, 179, 8, 0.1);
      color: #eab308;
      border: 1px solid rgba(234, 179, 8, 0.3);
    }
    .status-rejected, .status-failed, .status-declined {
      background-color: rgba(239, 68, 68, 0.1);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .type-badge {
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 600;
    }
    .type-deposit {
      background-color: rgba(59, 130, 246, 0.1);
      color: #3b82f6;
    }
    .type-withdrawal {
      background-color: rgba(168, 85, 247, 0.1);
      color: #a855f7;
    }
    .type-investment {
      background-color: rgba(14, 165, 233, 0.1);
      color: #0ea5e9;
    }
    .type-profit {
      background-color: rgba(34, 197, 94, 0.1);
      color: #22c55e;
    }
    .filter-btn {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .filter-btn.active {
      background-color: #3b82f6;
      color: white;
    }
    .filter-btn:not(.active) {
      background-color: rgba(30, 41, 59, 0.8);
      color: #94a3b8;
    }
    .filter-btn:not(.active):hover {
      background-color: rgba(30, 41, 59, 1);
      color: #cbd5e1;
    }
    .transaction-card {
      transition: all 0.2s;
      border-left: 4px solid transparent;
    }
    .transaction-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }
    .transaction-card.deposit {
      border-left-color: #3b82f6;
    }
    .transaction-card.withdrawal {
      border-left-color: #a855f7;
    }
    .transaction-card.investment {
      border-left-color: #0ea5e9;
    }
    .transaction-card.profit {
      border-left-color: #22c55e;
    }
    .empty-state {
      opacity: 0.6;
    }
  </style>
</head>

<body class="min-h-screen gradient-bg text-white font-sans">
  <!-- Header -->
  <header class="sticky top-0 z-50 h-16 border-b border-slate-800 bg-slate-950/90 backdrop-blur-xl flex items-center">
    <div class="w-full max-w-6xl mx-auto px-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a href="/dashboard" class="flex items-center text-slate-300 hover:text-white transition-colors">
          <i class="fas fa-arrow-left mr-2 text-sm"></i>
          <span class="text-sm font-medium">Back to Dashboard</span>
        </a>
        <div class="h-6 w-px bg-slate-700"></div>
        <h1 class="text-xl font-bold">Transactions History</h1>
      </div>
      <div class="hidden md:flex items-center space-x-2 text-sm">
        <i class="fas fa-chart-line text-slate-400"></i>
        <span class="text-slate-300">Total Transactions:</span>
        <span class="font-bold text-white"><%= transactions ? transactions.length : 0 %></span>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Stats Cards -->
    <% if (transactions && transactions.length > 0) { 
      let totalDeposits = transactions.filter(t => t.type === 'deposit' && (t.status === 'approved' || t.status === 'profit')).reduce((sum, t) => sum + Number(t.amount), 0);
      let totalWithdrawals = transactions.filter(t => t.type === 'withdrawal' && t.status === 'completed').reduce((sum, t) => sum + Number(t.amount), 0);
      let pendingTransactions = transactions.filter(t => t.status === 'pending').length;
      let recentProfit = transactions.filter(t => t.type === 'profit').slice(0, 5).reduce((sum, t) => sum + Number(t.amount), 0);
    %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="card-gradient border border-slate-800 rounded-2xl p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-400 text-sm mb-1">Total Deposits</p>
              <p class="text-2xl font-bold">$<%= totalDeposits.toFixed(2) %></p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-900/30 flex items-center justify-center">
              <i class="fas fa-money-bill-wave text-blue-400 text-xl"></i>
            </div>
          </div>
        </div>
        
        <div class="card-gradient border border-slate-800 rounded-2xl p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-400 text-sm mb-1">Total Withdrawals</p>
              <p class="text-2xl font-bold">$<%= totalWithdrawals.toFixed(2) %></p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-purple-900/30 flex items-center justify-center">
              <i class="fas fa-paper-plane text-purple-400 text-xl"></i>
            </div>
          </div>
        </div>
        
        <div class="card-gradient border border-slate-800 rounded-2xl p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-400 text-sm mb-1">Pending</p>
              <p class="text-2xl font-bold"><%= pendingTransactions %></p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-900/30 flex items-center justify-center">
              <i class="fas fa-clock text-amber-400 text-xl"></i>
            </div>
          </div>
        </div>
        
        <div class="card-gradient border border-slate-800 rounded-2xl p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-slate-400 text-sm mb-1">Recent Profits</p>
              <p class="text-2xl font-bold text-emerald-400">$<%= recentProfit.toFixed(2) %></p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-900/30 flex items-center justify-center">
              <i class="fas fa-chart-line text-emerald-400 text-xl"></i>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Filters and Search -->
    <div class="card-gradient border border-slate-800 rounded-2xl p-6 mb-6">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold mb-2">All Transactions</h2>
          <p class="text-slate-400 text-sm">Track your deposit, withdrawal, and investment activity</p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-3">
          <!-- Search -->
          <div class="relative">
            <div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400">
              <i class="fas fa-search"></i>
            </div>
            <input type="text" id="searchInput" placeholder="Search transactions..." 
                   class="pl-10 pr-4 py-2 bg-slate-800/50 border border-slate-700 rounded-lg text-sm w-full sm:w-64 focus:outline-none focus:border-blue-500">
          </div>
          
          <!-- Date Filter -->
          <div class="relative">
            <div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400">
              <i class="fas fa-calendar"></i>
            </div>
            <select id="dateFilter" class="pl-10 pr-4 py-2 bg-slate-800/50 border border-slate-700 rounded-lg text-sm focus:outline-none focus:border-blue-500">
              <option value="all">All Time</option>
              <option value="today">Today</option>
              <option value="week">This Week</option>
              <option value="month">This Month</option>
              <option value="year">This Year</option>
            </select>
          </div>
        </div>
      </div>
      
      <!-- Type Filters -->
      <div class="flex flex-wrap gap-2 mt-6">
        <button class="filter-btn active" data-filter="all">
          <i class="fas fa-list mr-1"></i> All
        </button>
        <button class="filter-btn" data-filter="deposit">
          <i class="fas fa-money-bill-wave mr-1"></i> Deposits
        </button>
        <button class="filter-btn" data-filter="withdrawal">
          <i class="fas fa-paper-plane mr-1"></i> Withdrawals
        </button>
        <button class="filter-btn" data-filter="investment">
          <i class="fas fa-chart-line mr-1"></i> Investments
        </button>
        <button class="filter-btn" data-filter="profit">
          <i class="fas fa-coins mr-1"></i> Profits
        </button>
        
        <!-- Status Filters -->
        <div class="ml-2 pl-2 border-l border-slate-700 hidden sm:flex items-center gap-2">
          <button class="filter-btn" data-status="all">
            All Status
          </button>
          <button class="filter-btn" data-status="approved,completed,success,profit">
            <i class="fas fa-check-circle mr-1"></i> Approved
          </button>
          <button class="filter-btn" data-status="pending">
            <i class="fas fa-clock mr-1"></i> Pending
          </button>
          <button class="filter-btn" data-status="rejected,failed,declined">
            <i class="fas fa-times-circle mr-1"></i> Failed
          </button>
        </div>
      </div>
      
      <!-- Mobile Status Filters -->
      <div class="flex flex-wrap gap-2 mt-3 sm:hidden">
        <button class="filter-btn" data-status="all">
          All Status
        </button>
        <button class="filter-btn" data-status="approved,completed,success,profit">
          Approved
        </button>
        <button class="filter-btn" data-status="pending">
          Pending
        </button>
        <button class="filter-btn" data-status="rejected,failed,declined">
          Failed
        </button>
      </div>
    </div>

    <!-- Transactions List -->
    <div class="card-gradient border border-slate-800 rounded-2xl p-6">
      <% if (!transactions || transactions.length === 0) { %>
        <div class="text-center py-12 empty-state">
          <div class="w-20 h-20 mx-auto rounded-full bg-slate-800 flex items-center justify-center mb-4">
            <i class="fas fa-exchange-alt text-slate-600 text-2xl"></i>
          </div>
          <h3 class="text-lg font-medium text-slate-400 mb-2">No transactions yet</h3>
          <p class="text-slate-500 text-sm mb-6">Your deposit, withdrawal, and investment history will appear here</p>
          <div class="flex justify-center gap-3">
            <a href="/deposit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors">
              <i class="fas fa-plus mr-1"></i> Make Deposit
            </a>
            <a href="/dashboard" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg font-medium transition-colors">
              <i class="fas fa-home mr-1"></i> Go to Dashboard
            </a>
          </div>
        </div>
      <% } else { %>
        <div id="transactionsList" class="space-y-4">
          <% transactions.forEach(t => { 
            let typeClass = '';
            let typeIcon = 'exchange-alt';
            let typeColor = 'text-slate-400';
            
            if (t.type === 'deposit') {
              typeClass = 'deposit';
              typeIcon = 'money-bill-wave';
              typeColor = 'text-blue-400';
            } else if (t.type === 'withdrawal') {
              typeClass = 'withdrawal';
              typeIcon = 'paper-plane';
              typeColor = 'text-purple-400';
            } else if (t.type === 'investment') {
              typeClass = 'investment';
              typeIcon = 'chart-line';
              typeColor = 'text-sky-400';
            } else if (t.type === 'profit') {
              typeClass = 'profit';
              typeIcon = 'coins';
              typeColor = 'text-emerald-400';
            }
            
            let statusClass = 'status-pending';
            let statusIcon = 'clock';
            
            if (t.status === 'approved' || t.status === 'completed' || t.status === 'success' || t.status === 'profit') {
              statusClass = 'status-approved';
              statusIcon = 'check-circle';
            } else if (t.status === 'rejected' || t.status === 'failed' || t.status === 'declined') {
              statusClass = 'status-rejected';
              statusIcon = 'times-circle';
            }
          %>
            <div class="transaction-card <%= typeClass %> bg-slate-900/50 border border-slate-800 rounded-xl p-5" 
                 data-type="<%= t.type %>" 
                 data-status="<%= t.status %>"
                 data-date="<%= new Date(t.date).getTime() %>"
                 data-amount="<%= t.amount %>">
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <!-- Left Section -->
                <div class="flex items-start space-x-4">
                  <div class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-<%= typeIcon %> <%= typeColor %> text-lg"></i>
                  </div>
                  
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="type-badge type-<%= t.type %> capitalize">
                        <%= t.type %>
                      </span>
                      <span class="<%= statusClass %> flex items-center">
                        <i class="fas fa-<%= statusIcon %> mr-1 text-xs"></i>
                        <span class="capitalize"><%= t.status %></span>
                      </span>
                    </div>
                    
                    <div class="space-y-1 text-sm">
                      <% if (t.method || t.network) { %>
                        <div class="flex items-center text-slate-400">
                          <i class="fas fa-wallet mr-2 text-xs"></i>
                          <span><%= t.method || t.network %></span>
                        </div>
                      <% } %>
                      
                      <div class="flex items-center text-slate-400">
                        <i class="fas fa-calendar mr-2 text-xs"></i>
                        <span><%= new Date(t.date).toLocaleDateString('en-US', { 
                          year: 'numeric', 
                          month: 'short', 
                          day: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                        }) %></span>
                      </div>
                      
                      <% if (t.description || t.note) { %>
                        <div class="flex items-start text-slate-400">
                          <i class="fas fa-sticky-note mr-2 text-xs mt-0.5"></i>
                          <span class="text-xs"><%= t.description || t.note %></span>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
                
                <!-- Right Section -->
                <div class="flex flex-col items-end">
                  <div class="text-2xl font-bold mb-2 <%= t.type === 'withdrawal' ? 'text-purple-300' : t.type === 'profit' ? 'text-emerald-300' : 'text-blue-300' %>">
                    <%= t.type === 'withdrawal' ? '-' : t.type === 'deposit' || t.type === 'profit' ? '+' : '' %>$<%= Number(t.amount).toFixed(2) %>
                  </div>
                  
                  <div class="flex items-center space-x-3">
                    <% if (t.proofUrl) { %>
                      <a href="<%= t.proofUrl %>" target="_blank" class="flex items-center text-blue-400 hover:text-blue-300 text-sm">
                        <i class="fas fa-external-link-alt mr-1 text-xs"></i>
                        <span>Proof</span>
                      </a>
                    <% } %>
                    
                    <% if (t.transactionId) { %>
                      <button onclick="copyToClipboard('<%= t.transactionId %>')" class="flex items-center text-slate-400 hover:text-slate-300 text-sm" title="Copy Transaction ID">
                        <i class="fas fa-copy mr-1 text-xs"></i>
                        <span>Copy ID</span>
                      </button>
                    <% } %>
                    
                    <button onclick="showTransactionDetails('<%= t._id || t.id %>')" class="flex items-center text-slate-400 hover:text-slate-300 text-sm">
                      <i class="fas fa-info-circle mr-1 text-xs"></i>
                      <span>Details</span>
                    </button>
                  </div>
                </div>
              </div>
              
              <!-- Transaction ID (hidden by default) -->
              <% if (t.transactionId) { %>
                <div class="mt-3 pt-3 border-t border-slate-800/50 hidden" id="details-<%= t._id || t.id %>">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div>
                      <p class="text-slate-400 mb-1">Transaction ID:</p>
                      <code class="text-xs bg-slate-900 p-2 rounded block break-all"><%= t.transactionId %></code>
                    </div>
                    <div>
                      <p class="text-slate-400 mb-1">Processed:</p>
                      <p class="text-slate-300"><%= new Date(t.date).toLocaleString() %></p>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
        
        <!-- Pagination/Export -->
        <div class="flex flex-col sm:flex-row items-center justify-between mt-8 pt-6 border-t border-slate-800/50">
          <div class="text-sm text-slate-400 mb-4 sm:mb-0">
            Showing <span id="shownCount"><%= transactions.length %></span> of <span id="totalCount"><%= transactions.length %></span> transactions
          </div>
          
          <div class="flex items-center space-x-3">
            <button id="exportBtn" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 rounded-lg font-medium text-sm transition-colors">
              <i class="fas fa-download mr-1"></i> Export CSV
            </button>
            
            <div class="flex items-center space-x-2">
              <button id="prevBtn" class="w-9 h-9 flex items-center justify-center bg-slate-800 hover:bg-slate-700 rounded-lg disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                <i class="fas fa-chevron-left"></i>
              </button>
              <span class="text-sm text-slate-400">Page 1</span>
              <button id="nextBtn" class="w-9 h-9 flex items-center justify-center bg-slate-800 hover:bg-slate-700 rounded-lg disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Elements
      const transactionsList = document.getElementById('transactionsList');
      const filterButtons = document.querySelectorAll('.filter-btn[data-filter]');
      const statusButtons = document.querySelectorAll('.filter-btn[data-status]');
      const searchInput = document.getElementById('searchInput');
      const dateFilter = document.getElementById('dateFilter');
      const shownCount = document.getElementById('shownCount');
      const totalCount = document.getElementById('totalCount');
      const exportBtn = document.getElementById('exportBtn');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      
      // Get all transaction cards
      let allTransactions = [];
      if (transactionsList) {
        allTransactions = Array.from(transactionsList.querySelectorAll('.transaction-card'));
      }
      
      // Filter variables
      let currentFilter = 'all';
      let currentStatus = 'all';
      let currentSearch = '';
      let currentDateFilter = 'all';
      
      // Initialize counts
      if (totalCount) {
        totalCount.textContent = allTransactions.length;
        shownCount.textContent = allTransactions.length;
      }
      
      // Type filter buttons
      filterButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          // Update active state
          filterButtons.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          
          currentFilter = this.getAttribute('data-filter');
          filterTransactions();
        });
      });
      
      // Status filter buttons
      statusButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          // Update active state
          statusButtons.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          
          currentStatus = this.getAttribute('data-status');
          filterTransactions();
        });
      });
      
      // Search input
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          currentSearch = this.value.toLowerCase();
          filterTransactions();
        });
      }
      
      // Date filter
      if (dateFilter) {
        dateFilter.addEventListener('change', function() {
          currentDateFilter = this.value;
          filterTransactions();
        });
      }
      
      // Filter function
      function filterTransactions() {
        let visibleCount = 0;
        const now = new Date();
        
        allTransactions.forEach(transaction => {
          const type = transaction.getAttribute('data-type');
          const status = transaction.getAttribute('data-status');
          const date = new Date(parseInt(transaction.getAttribute('data-date')));
          const amount = parseFloat(transaction.getAttribute('data-amount'));
          const text = transaction.textContent.toLowerCase();
          
          let show = true;
          
          // Type filter
          if (currentFilter !== 'all' && type !== currentFilter) {
            show = false;
          }
          
          // Status filter
          if (currentStatus !== 'all') {
            if (currentStatus.includes(',')) {
              const statuses = currentStatus.split(',');
              if (!statuses.includes(status)) {
                show = false;
              }
            } else if (status !== currentStatus) {
              show = false;
            }
          }
          
          // Search filter
          if (currentSearch && !text.includes(currentSearch)) {
            show = false;
          }
          
          // Date filter
          if (currentDateFilter !== 'all') {
            const isToday = date.toDateString() === now.toDateString();
            const isThisWeek = getWeekNumber(date) === getWeekNumber(now) && date.getFullYear() === now.getFullYear();
            const isThisMonth = date.getMonth() === now.getMonth() && date.getFullYear() === now.getFullYear();
            const isThisYear = date.getFullYear() === now.getFullYear();
            
            switch (currentDateFilter) {
              case 'today':
                if (!isToday) show = false;
                break;
              case 'week':
                if (!isThisWeek) show = false;
                break;
              case 'month':
                if (!isThisMonth) show = false;
                break;
              case 'year':
                if (!isThisYear) show = false;
                break;
            }
          }
          
          // Show/hide transaction
          if (show) {
            transaction.style.display = 'block';
            visibleCount++;
          } else {
            transaction.style.display = 'none';
          }
        });
        
        // Update shown count
        if (shownCount) {
          shownCount.textContent = visibleCount;
        }
        
        // Show empty state if no transactions match
        if (visibleCount === 0 && allTransactions.length > 0) {
          showEmptyFilterState();
        }
      }
      
      // Helper function to get week number
      function getWeekNumber(d) {
        d = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
        d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay()||7));
        const yearStart = new Date(Date.UTC(d.getUTCFullYear(),0,1));
        const weekNo = Math.ceil(( ( (d - yearStart) / 86400000) + 1)/7);
        return weekNo;
      }
      
      // Show empty filter state
      function showEmptyFilterState() {
        // This would show a custom message when no transactions match filters
        // For now, we just update the count
      }
      
      // Copy to clipboard
      window.copyToClipboard = function(text) {
        navigator.clipboard.writeText(text);
        Swal.fire({
          icon: 'success',
          title: 'Copied!',
          text: 'Transaction ID copied to clipboard',
          toast: true,
          position: 'top-end',
          showConfirmButton: false,
          timer: 2000
        });
      };
      
      // Show transaction details
      window.showTransactionDetails = function(id) {
        const detailsEl = document.getElementById(`details-${id}`);
        if (detailsEl) {
          detailsEl.classList.toggle('hidden');
        }
      };
      
      // Export CSV
      if (exportBtn) {
        exportBtn.addEventListener('click', function() {
          Swal.fire({
            title: 'Export Transactions',
            text: 'Download your transaction history as CSV file?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3b82f6',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Export',
            cancelButtonText: 'Cancel'
          }).then((result) => {
            if (result.isConfirmed) {
              // In a real implementation, this would make an API call to generate CSV
              // For now, we'll simulate with a notification
              Swal.fire({
                icon: 'success',
                title: 'Export Started',
                text: 'Your CSV file is being prepared for download.',
                timer: 2000,
                showConfirmButton: false
              });
              
              // Simulate download
              setTimeout(() => {
                const link = document.createElement('a');
                link.href = '#';
                link.download = 'transactions.csv';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
              }, 1000);
            }
          });
        });
      }
      
      // Pagination (simplified for demo)
      if (prevBtn && nextBtn) {
        // In a real implementation, this would handle actual pagination
        // For now, we'll just disable them since we're showing all
        prevBtn.disabled = true;
        nextBtn.disabled = true;
      }
      
      // Initialize filtering
      filterTransactions();
    });
    
    // Toast notifications
    <% if (toast) { %>
      Swal.fire({
        icon: '<%= toast.type %>',
        title: '<%= toast.message %>',
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000
      });
    <% } %>
  </script>
</body>
</html>