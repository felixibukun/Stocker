<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Withdrawal History</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-950 text-white">
  <header class="border-b border-slate-800 bg-slate-900">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <p class="text-lg font-semibold">Withdrawal History</p>
        <p class="text-xs text-slate-400">Review your withdrawal requests and statuses</p>
      </div>
      <a href="/withdraw" class="px-4 py-2 rounded bg-slate-800 text-sm hover:bg-slate-700">Back</a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-8">
    <% if (!history || history.length === 0) { %>
      <section class="border border-slate-800 rounded-lg bg-slate-900 p-8 text-center">
        <p class="font-semibold mb-2">No withdrawals yet</p>
        <p class="text-sm text-slate-400 mb-5">Submitted withdrawal requests will appear here.</p>
        <a href="/withdraw" class="inline-flex px-4 py-2 rounded bg-blue-600 text-sm font-semibold hover:bg-blue-700">Request Withdrawal</a>
      </section>
    <% } else { %>
      <div class="overflow-x-auto border border-slate-800 rounded-lg">
        <table class="w-full text-sm">
          <thead class="bg-slate-900 text-slate-400">
            <tr>
              <th class="text-left px-4 py-3">Date</th>
              <th class="text-left px-4 py-3">Method</th>
              <th class="text-right px-4 py-3">Amount</th>
              <th class="text-left px-4 py-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <% history.forEach(w => { %>
              <tr class="bg-slate-950">
                <td class="px-4 py-3 text-slate-300"><%= new Date(w.date).toLocaleString() %></td>
                <td class="px-4 py-3"><%= w.network || 'N/A' %></td>
                <td class="px-4 py-3 text-right font-semibold">$<%= Number(w.amount || 0).toFixed(2) %></td>
                <td class="px-4 py-3 capitalize"><%= w.status || 'pending' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
