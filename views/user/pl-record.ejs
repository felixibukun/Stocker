<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>P/L Record</title>

  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] }
        }
      }
    }
  </script>
</head>

<body class="min-h-screen bg-slate-950 text-white font-sans pb-28">

<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="h-11 w-11 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center">
        <img src="/temp/custom/img/logo.png" class="h-7 w-auto" alt="Logo">
      </div>

      <div>
        <p class="text-xl font-bold tracking-tight">P/L Record</p>
        <p class="text-sm text-slate-400">Track profit, loss, and portfolio performance</p>
      </div>
    </div>

    <a href="/dashboard"
       class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-slate-900 border border-slate-800 text-sm font-semibold text-slate-200 hover:bg-slate-800">
      Back
    </a>
  </div>
</header>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
      <p class="text-sm text-slate-400">Total P/L</p>
      <p class="mt-2 text-3xl font-bold <%= Number(totalProfit || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
        <%= Number(totalProfit || 0) >= 0 ? '+' : '-' %>$<%= Math.abs(Number(totalProfit || 0)).toFixed(2) %>
      </p>
    </div>

    <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
      <p class="text-sm text-slate-400">Tracked Holdings</p>
      <p class="mt-2 text-3xl font-bold text-white"><%= holdings ? holdings.length : 0 %></p>
    </div>

    <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
      <p class="text-sm text-slate-400">Status</p>
      <p class="mt-2 text-3xl font-bold <%= Number(totalProfit || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
        <%= Number(totalProfit || 0) >= 0 ? 'PROFIT' : 'LOSS' %>
      </p>
    </div>
  </section>

  <section class="rounded-3xl border border-slate-800 bg-slate-900/80 shadow-2xl shadow-black/30 overflow-hidden">
    <div class="p-6 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-lg font-bold">Profit and Loss Details</h1>
        <p class="text-sm text-slate-400 mt-1">Live unrealized P/L from your current stock holdings.</p>
      </div>

      <div class="h-10 px-4 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 text-sm font-semibold flex items-center">
        Portfolio Records
      </div>
    </div>

    <% if (!holdings || holdings.length === 0) { %>
      <div class="p-10 text-center">
        <div class="mx-auto h-14 w-14 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center mb-4">
          <span class="text-2xl">↗</span>
        </div>
        <p class="font-semibold text-white">No records found</p>
        <p class="text-sm text-slate-400 mt-2">Your profit and loss records will appear after you buy stocks.</p>
      </div>
    <% } else { %>

      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-950/60 text-slate-400 border-b border-slate-800">
            <tr>
              <th class="text-left font-semibold px-6 py-4">Asset</th>
              <th class="text-right font-semibold px-6 py-4">Quantity</th>
              <th class="text-right font-semibold px-6 py-4">Average Price</th>
              <th class="text-right font-semibold px-6 py-4">Market Value</th>
              <th class="text-right font-semibold px-6 py-4">P/L</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-800">
            <% holdings.forEach(t => { 
              const quantity = Number(t.quantity || 0)
              const avgPrice = Number(t.avgPrice || t.price || 0)
              const value = quantity * avgPrice
              const profit = Number(t.pnl || t.profit || 0)
            %>
              <tr class="hover:bg-slate-800/30 transition">
                <td class="px-6 py-5">
                  <p class="font-semibold text-white"><%= t.stockName || t.symbol || 'N/A' %></p>
                  <p class="text-xs text-slate-500 mt-1"><%= t.symbol || 'Holding' %></p>
                </td>

                <td class="px-6 py-5 text-right text-slate-200">
                  <%= quantity %>
                </td>

                <td class="px-6 py-5 text-right text-slate-200">
                  $<%= avgPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>

                <td class="px-6 py-5 text-right text-slate-200">
                  $<%= value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>

                <td class="px-6 py-5 text-right font-bold <%= profit >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
                  <%= profit >= 0 ? '+' : '-' %>$<%= Math.abs(profit).toFixed(2) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="md:hidden divide-y divide-slate-800">
        <% holdings.forEach(t => { 
          const quantity = Number(t.quantity || 0)
          const avgPrice = Number(t.avgPrice || t.price || 0)
          const value = quantity * avgPrice
          const profit = Number(t.pnl || t.profit || 0)
        %>
          <div class="p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-bold text-white"><%= t.stockName || t.symbol || 'N/A' %></p>
                <p class="text-xs text-slate-500 mt-1"><%= t.symbol || 'Holding' %></p>
              </div>

              <span class="px-3 py-1 rounded-full text-xs font-bold <%= profit >= 0 ? 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/20' : 'bg-red-500/10 text-red-300 border border-red-500/20' %>">
                <%= profit >= 0 ? 'PROFIT' : 'LOSS' %>
              </span>
            </div>

            <div class="grid grid-cols-2 gap-4 mt-5 text-sm">
              <div>
                <p class="text-slate-500">Quantity</p>
                <p class="font-semibold mt-1"><%= quantity %></p>
              </div>

              <div>
                <p class="text-slate-500">Avg Price</p>
                <p class="font-semibold mt-1">$<%= avgPrice.toFixed(2) %></p>
              </div>

              <div>
                <p class="text-slate-500">Market Value</p>
                <p class="font-semibold mt-1">$<%= value.toFixed(2) %></p>
              </div>

              <div>
                <p class="text-slate-500">P/L</p>
                <p class="font-bold mt-1 <%= profit >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
                  <%= profit >= 0 ? '+' : '-' %>$<%= Math.abs(profit).toFixed(2) %>
                </p>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

    <% } %>
  </section>

</main>

<%- include('partials/mobile-bankbar') %>
</body>
</html>