  </header>

  <!-- Mobile menu -->
  <div class="mobile-menu lg:hidden" id="mobileMenu">
    <div class="p-6 space-y-2">
      <a href="/" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="home"></i> Home</a>
      <a href="/markets" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="trending-up"></i> Markets</a>
      <a href="/platform" class="flex items-center gap-3 text-lg font-medium py-3" style="color:#8a6815"><i data-lucide="layout-dashboard"></i> Platform</a>
      <a href="/pricing" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="credit-card"></i> Pricing</a>
      <a href="/education" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="graduation-cap"></i> Education</a>
      <a href="/FAQ" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="help-circle"></i> FAQ</a>
      <a href="/about" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="info"></i> About</a>
      <div class="pt-6 mt-4 border-t space-y-3" style="border-color:#e2e8f0">
        <a href="/login" class="btn-ghost w-full">Login to Account</a>
        <a href="/signup" class="btn-gold w-full">Create Account</a>
      </div>
    </div>
  </div>

  <main>
    <!-- ================= HERO ================= -->
    <section id="hero" class="relative pt-[4.25rem]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-12 md:pt-20 md:pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7">
            <div class="eyebrow reveal"><span class="live-dot"></span> Your Trading Workspace</div>
            <h1 class="reveal d1 mt-6 text-[2.4rem] leading-[1.06] sm:text-5xl lg:text-[3.8rem] font-bold tracking-tight" style="color:#172033">
              The Global Equinox Platform.<br>
              <span class="gold-text">Knowledge. Clarity. Preparation.</span>
            </h1>
            <p class="reveal d2 mt-6 text-lg max-w-xl leading-relaxed" style="color:#475569">
              A starting point for learning about the platform, managing account access, and approaching markets responsibly. Confirm account-specific details before use.
            </p>
            <div class="reveal d3 mt-8 flex flex-col sm:flex-row gap-3.5">
              <a href="/signup" class="btn-gold group text-[0.95rem]">
                Create Account
                <i data-lucide="arrow-right" class="transition-transform group-hover:translate-x-1"></i>
              </a>
              <a href="/risk-disclosure" class="btn-ghost text-[0.95rem]">
                <i data-lucide="shield-alert"></i> Read Risk Disclosure
              </a>
            </div>
            <div class="reveal d4 mt-10 grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-xl">
              <div class="flex items-center gap-2.5">
                <div class="icon-chip green !w-10 !h-10 !rounded-xl"><i data-lucide="lock" class="!w-4 !h-4"></i></div>
                <div><p class="text-sm font-semibold" style="color:#172033">Secure access</p><p class="text-xs" style="color:#64748b">Protected login</p></div>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="icon-chip !w-10 !h-10 !rounded-xl"><i data-lucide="layout-dashboard" class="!w-4 !h-4"></i></div>
                <div><p class="text-sm font-semibold" style="color:#172033">All-in-one</p><p class="text-xs" style="color:#64748b">Single workspace</p></div>
              </div>
              <div class="flex items-center gap-2.5">
                <div class="icon-chip blue !w-10 !h-10 !rounded-xl"><i data-lucide="headset" class="!w-4 !h-4"></i></div>
                <div><p class="text-sm font-semibold" style="color:#172033">Support</p><p class="text-xs" style="color:#64748b">Help when needed</p></div>
              </div>
            </div>
          </div>

          <!-- Platform preview mock -->
