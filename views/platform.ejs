    <div class="aurora a1"></div>
    <div class="aurora a2"></div>
    <div class="aurora a3"></div>
    <div class="grain"></div>
  </div>

  <!-- Header -->
  <header class="site-header" id="siteHeader">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="h-[4.25rem] flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/temp/custom/img/logo.png" alt="Global Equinox Trade" class="h-8 w-auto transition-transform duration-300 group-hover:scale-105">
