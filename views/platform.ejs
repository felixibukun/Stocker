<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="A starting point for learning about the platform, managing account access, and approaching markets responsibly.">
  <title>The Global Equinox Platform | Global Equinox Trade</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global-equinox-gold.css?v=pages20261023">
  <style>
:root{--page:#f7f8fc;--ink:#172033;--muted:#647084;--gold:#d4af37;--gold-dark:#96751c;--line:#e8e1d0;--white:#fff}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body.ge-page{margin:0;background:var(--page);color:var(--ink);font-family:'DM Sans',Arial,sans-serif;line-height:1.65}
.ge-page a{color:inherit;text-decoration:none}
.ge-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border-bottom:1px solid #e5e7eb}
.ge-nav{max-width:1200px;margin:auto;padding:0 24px;min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.ge-brand{display:flex;align-items:center;gap:12px;font-weight:700;color:var(--ink);white-space:nowrap}
.ge-brand img{width:auto;height:34px;max-width:48px;object-fit:contain}
.ge-links{display:flex;align-items:center;gap:23px;font-size:14px;color:#475569}
.ge-links a:hover,.ge-links a[aria-current="page"]{color:var(--gold-dark)}
.ge-actions{display:flex;align-items:center;gap:10px}
.ge-btn{display:inline-flex;align-items:center;justify-content:center;border-radius:12px;padding:11px 18px;font-weight:700;font-size:14px;border:1px solid var(--line);background:#fff;color:var(--ink)!important}
.ge-btn.gold{border-color:var(--gold);background:linear-gradient(135deg,#f1d99a,#d4af37);color:#211a08!important}
.ge-menu-btn{display:none;background:white;border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-size:20px;color:var(--ink)}
.ge-mobile{display:none;padding:8px 24px 20px;background:white;border-top:1px solid var(--line)}
.ge-mobile a{display:block;padding:10px 0;color:var(--ink)}
.ge-hero{background:linear-gradient(135deg,#fff 0%,#fffdf7 70%,#f8f1dd 100%);border-bottom:1px solid var(--line)}
.ge-wrap{max-width:1160px;margin:auto;padding-left:24px;padding-right:24px}
.ge-hero-inner{padding-top:66px;padding-bottom:58px}
.ge-eyebrow{display:inline-flex;align-items:center;border:1px solid #eadba8;border-radius:999px;background:#fffaf0;color:#806315;padding:6px 13px;font-size:12px;font-weight:800;letter-spacing:.09em}
.ge-hero h1{font-size:clamp(34px,5vw,56px);line-height:1.12;letter-spacing:-.035em;margin:20px 0 16px;color:var(--ink)}
.ge-hero h1 span{color:var(--gold-dark)}
.ge-intro{max-width:760px;font-size:18px;color:#526075;margin:0}
.ge-actions-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.ge-section{padding-top:46px;padding-bottom:54px}
.ge-section-heading{margin-bottom:24px}
.ge-section-heading h2{font-size:clamp(24px,3vw,32px);line-height:1.2;margin:0 0 8px;color:var(--ink)}
.ge-section-heading p{margin:0;color:var(--muted)}
.ge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.ge-card{background:var(--white);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 8px 28px rgba(23,32,51,.045)}
.ge-card-mark{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:13px;background:#fff6d9;color:#826316;font-size:13px;font-weight:800;margin-bottom:17px}
.ge-card h3{font-size:18px;margin:0 0 9px;color:var(--ink)}
.ge-card p{font-size:14px;line-height:1.75;color:#596579;margin:0}
.ge-callout{display:grid;grid-template-columns:1fr auto;align-items:center;gap:24px;padding:28px;border-radius:18px;background:#fff;border:1px solid var(--line);margin-top:28px}
.ge-callout h2{font-size:22px;margin:0 0 8px;color:var(--ink)}
.ge-callout p{color:#596579;margin:0;max-width:800px}
.ge-footer{background:#fff;border-top:1px solid #e5e7eb;margin-top:20px}
.ge-footer-inner{max-width:1200px;margin:auto;padding:38px 24px 24px}
.ge-footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px}
.ge-footer h3,.ge-footer h4{margin:0 0 12px;color:var(--ink)}
.ge-footer p,.ge-footer a{font-size:13px;color:#647084}
.ge-footer a:hover{color:var(--gold-dark)}
.ge-footer ul{list-style:none;padding:0;margin:0}
.ge-footer li{margin:8px 0}
.ge-footer-bottom{border-top:1px solid #e5e7eb;margin-top:28px;padding-top:18px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.ge-footer-bottom p{margin:0}
@media(max-width:1000px){.ge-links{gap:13px}.ge-nav{padding:0 18px}.ge-brand{font-size:14px}.ge-actions .ge-btn{padding:9px 12px}.ge-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.ge-nav{min-height:68px}.ge-links,.ge-actions{display:none}.ge-menu-btn{display:block}.ge-mobile.open{display:block}.ge-hero-inner{padding-top:44px;padding-bottom:42px}.ge-intro{font-size:16px}.ge-grid{grid-template-columns:1fr}.ge-section{padding-top:34px;padding-bottom:38px}.ge-card{padding:21px}.ge-callout{grid-template-columns:1fr;padding:22px}.ge-footer-grid{grid-template-columns:1fr 1fr;gap:24px}.ge-footer-grid>div:first-child{grid-column:1/-1}}
@media(max-width:420px){.ge-wrap{padding-left:17px;padding-right:17px}.ge-brand img{height:30px}.ge-footer-grid{grid-template-columns:1fr}.ge-footer-grid>div:first-child{grid-column:auto}.ge-hero h1{font-size:35px}}
</style>
</head>
<body class="ge-page">

<header class="ge-header">
  <div class="ge-nav">
    <a class="ge-brand" href="/">
      <img src="/temp/custom/img/logo.png" alt="Global Equinox Trade logo">
      <span>Global Equinox Trade</span>
    </a>
    <nav class="ge-links" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/markets" >Markets</a>
      <a href="/platform" aria-current="page">Platform</a>
      <a href="/pricing" >Pricing</a>
      <a href="/education" >Education</a>
      <a href="/FAQ">FAQ</a>
      <a href="/about">About</a>
    </nav>
    <div class="ge-actions">
      <a class="ge-btn" href="/login">Login</a>
      <a class="ge-btn gold" href="/signup">Start Trading</a>
    </div>
    <button class="ge-menu-btn" id="geMenuBtn" aria-label="Open navigation" aria-expanded="false">☰</button>
  </div>
  <nav class="ge-mobile" id="geMobileMenu" aria-label="Mobile navigation">
    <a href="/">Home</a><a href="/markets">Markets</a><a href="/platform">Platform</a>
    <a href="/pricing">Pricing</a><a href="/education">Education</a>
    <a href="/FAQ">FAQ</a><a href="/about">About</a>
    <a href="/login">Login</a><a href="/signup">Create Account</a>
  </nav>
</header>

<main>
  <section class="ge-hero">
    <div class="ge-wrap ge-hero-inner">
      <span class="ge-eyebrow">YOUR TRADING WORKSPACE</span>
      <h1>The Global Equinox Platform<br><span>Knowledge. Clarity. Preparation.</span></h1>
      <p class="ge-intro">A starting point for learning about the platform, managing account access, and approaching markets responsibly.</p>
      <div class="ge-actions-row">
        <a class="ge-btn gold" href="/signup">Create Account</a>
        <a class="ge-btn" href="/risk-disclosure">Read Risk Disclosure</a>
      </div>
    </div>
  </section>
  <section class="ge-wrap ge-section">
    <div class="ge-section-heading">
      <h2>Explore the platform</h2>
      <p>Start with the essentials and confirm account-specific details before use.</p>
    </div>
    <div class="ge-grid"><article class="ge-card">
          <div class="ge-card-mark">01</div>
          <h3>Account access</h3>
          <p>Use the account login to access your existing account, or visit registration if you are new. Protect your credentials and never share passwords or authentication codes.</p>
        </article>
<article class="ge-card">
          <div class="ge-card-mark">02</div>
          <h3>Market research</h3>
          <p>Prepare for a trading decision by reviewing relevant market information, understanding volatility, and checking the details of the instrument you intend to trade.</p>
        </article>
<article class="ge-card">
          <div class="ge-card-mark">03</div>
          <h3>Risk awareness</h3>
          <p>Consider your position size, potential loss, leverage where applicable, and the effect of sudden price movements before placing an order.</p>
        </article>
<article class="ge-card">
          <div class="ge-card-mark">04</div>
          <h3>Account security</h3>
          <p>Use a unique password, keep your devices secure, and contact support through verified channels if you notice unexpected account activity.</p>
        </article>
<article class="ge-card">
          <div class="ge-card-mark">05</div>
          <h3>Review and recordkeeping</h3>
          <p>Keep track of your decisions, transactions, and account activity so you can review your approach and identify questions that need support.</p>
        </article>
<article class="ge-card">
          <div class="ge-card-mark">06</div>
          <h3>Help and support</h3>
          <p>Visit the FAQ or contact the support team for assistance with account access and general platform questions.</p>
        </article></div>
    <div class="ge-callout">
      <div><h2>Getting started</h2><p>Start by reviewing the available account features and applicable terms. Specific tools, instruments, fees, and order types should be confirmed in your account before you rely on them.</p></div>
      <a class="ge-btn gold" href="/FAQ">Visit FAQ</a>
    </div>
  </section>
</main>

<footer class="ge-footer">
  <div class="ge-footer-inner">
    <div class="ge-footer-grid">
      <div>
        <h3>Global Equinox Trade</h3>
        <p>Market information and trading resources to help users make informed decisions. Trading involves risk, and losses are possible.</p>
      </div>
      <div><h4>Explore</h4><ul>
        <li><a href="/markets">Markets</a></li><li><a href="/platform">Platform</a></li>
        <li><a href="/pricing">Pricing</a></li><li><a href="/education">Education</a></li>
      </ul></div>
      <div><h4>Account</h4><ul>
        <li><a href="/login">Login</a></li><li><a href="/signup">Create account</a></li>
        <li><a href="/FAQ">Frequently asked questions</a></li><li><a href="/about">About us</a></li>
      </ul></div>
      <div><h4>Policies</h4><ul>
        <li><a href="/terms">Terms of Service</a></li><li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/risk-disclosure">Risk Disclosure</a></li><li><a href="/cookie-policy">Cookie Policy</a></li>
        <li><a href="/aml-policy">AML Policy</a></li>
      </ul></div>
    </div>
    <div class="ge-footer-bottom">
      <p>&copy; <span id="geYear"></span> Global Equinox Trade. All rights reserved.</p>
      <p>Trading involves risk. Past performance does not guarantee future results.</p>
    </div>
  </div>
</footer>


<script>
(function(){
  const btn=document.getElementById('geMenuBtn');
  const menu=document.getElementById('geMobileMenu');
  if(btn && menu){
    btn.addEventListener('click',function(){
      const open=menu.classList.toggle('open');
      btn.setAttribute('aria-expanded',String(open));
      btn.setAttribute('aria-label',open?'Close navigation':'Open navigation');
      btn.textContent=open?'×':'☰';
    });
  }
  const year=document.getElementById('geYear');
  if(year) year.textContent=new Date().getFullYear();
})();
</script>

</body>
</html>
