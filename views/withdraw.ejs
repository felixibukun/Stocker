<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Withdraw Funds</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    .gradient-bg {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }
    .card-gradient {
      background: linear-gradient(145deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.9) 100%);
    }
    .dropdown-gradient {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }
    .input-focus:focus {
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    .status-badge {
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .status-completed {
      background-color: rgba(34, 197, 94, 0.1);
      color: #22c55e;
      border: 1px solid rgba(34, 197, 94, 0.3);
    }
    .status-pending {
      background-color: rgba(234, 179, 8, 0.1);
      color: #eab308;
      border: 1px solid rgba(234, 179, 8, 0.3);
    }
    .status-failed {
      background-color: rgba(239, 68, 68, 0.1);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .custom-select {
      position: relative;
    }
    .custom-select-btn {
      width: 100%;
      text-align: left;
      padding: 0.75rem 1rem;
      background: rgba(30, 41, 59, 0.8);
      border: 1px solid #374151;
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: all 0.2s;
    }
    .custom-select-btn:hover {
      border-color: #4b5563;
    }
    .custom-select-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #1e293b;
      border: 1px solid #374151;
      border-radius: 0.75rem;
      margin-top: 0.25rem;
      max-height: 300px;
      overflow-y: auto;
      z-index: 50;
      display: none;
    }
    .custom-select-dropdown.show {
      display: block;
    }
    .custom-option {
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      cursor: pointer;
      transition: background-color 0.2s;
    }
    .custom-option:hover {
      background-color: rgba(59, 130, 246, 0.1);
    }
    .custom-option.selected {
      background-color: rgba(59, 130, 246, 0.2);
    }
    .method-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 12px;
      font-size: 16px;
    }
    .availability-badge {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
      border-radius: 9999px;
      margin-left: auto;
    }
    .available {
      background-color: rgba(34, 197, 94, 0.1);
      color: #22c55e;
    }
    .unavailable {
      background-color: rgba(239, 68, 68, 0.1);
      color: #ef4444;
    }
  </style>
</head>

<body class="min-h-screen gradient-bg text-white font-sans">
  <!-- Header -->
  <header class="sticky top-0 z-50 h-16 border-b border-slate-800 bg-slate-950/90 backdrop-blur-xl flex items-center">
    <div class="w-full max-w-6xl mx-auto px-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <a href="/dashboard" class="flex items-center text-slate-300 hover:text-white transition-colors">
          <i class="fas fa-arrow-left mr-2 text-sm"></i>
          <span class="text-sm font-medium">Back to Dashboard</span>
        </a>
        <div class="h-6 w-px bg-slate-700"></div>
        <h1 class="text-xl font-bold">Withdraw Funds</h1>
      </div>
      <div class="hidden md:flex items-center space-x-2 text-sm">
        <i class="fas fa-wallet text-slate-400"></i>
        <span class="text-slate-300">Balance:</span>
        <span class="font-bold text-white">$<%= Number(user.balance || 0).toFixed(2) %></span>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Left Column - Withdrawal Form -->
      <section class="space-y-6">
        <!-- Balance Card -->
        <div class="card-gradient border border-slate-800 rounded-2xl p-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between">
            <div>
              <p class="text-slate-300 text-sm mb-1">Available Balance</p>
              <p class="text-3xl font-bold">$<%= Number(user.balance || 0).toFixed(2) %></p>
              <p class="text-slate-400 text-sm mt-2">Minimum withdrawal: $10.00</p>
            </div>
            <button id="withdrawAllBtn" class="mt-4 sm:mt-0 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 rounded-lg font-semibold transition-colors">
              Withdraw All
            </button>
          </div>
        </div>

        <!-- Withdrawal Form -->
        <div class="card-gradient border border-slate-800 rounded-2xl p-6">
          <h2 class="text-lg font-bold mb-6">Withdrawal Request</h2>

          <form id="withdrawForm" action="/withdraw" method="POST" class="space-y-6">
            <!-- Amount Input -->
            <div class="space-y-2">
              <label class="text-sm font-medium">Amount to Withdraw</label>
              <div class="relative">
                <div class="absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-400">$</div>
                <input type="number" name="amount" id="amountInput" min="10" step="0.01" value="10"
                  class="w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
              </div>
              <div class="flex flex-wrap gap-2 text-sm mt-3">
                <button type="button" class="quick-amount px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg" data-amount="50">$50</button>
                <button type="button" class="quick-amount px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg" data-amount="100">$100</button>
                <button type="button" class="quick-amount px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg" data-amount="250">$250</button>
                <button type="button" class="quick-amount px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg" data-amount="500">$500</button>
                <button type="button" id="maxAmountBtn" class="px-3 py-1.5 bg-blue-900/30 hover:bg-blue-800/30 text-blue-400 rounded-lg">MAX</button>
              </div>
            </div>

            <!-- Method Dropdown -->
            <div class="space-y-2">
              <label class="text-sm font-medium">Withdrawal Method</label>
              
              <!-- Custom Select Dropdown -->
              <div class="custom-select">
                <div class="custom-select-btn" id="selectButton">
                  <div class="flex items-center">
                    <div class="method-icon bg-blue-900/30 text-blue-400" id="selectedIcon">
                      <i class="fas fa-money-bill-wave"></i>
                    </div>
                    <div>
                      <div class="font-medium" id="selectedMethod">Cash App</div>
                      <div class="text-xs text-slate-400" id="selectedDetails">Enter your $Cashtag</div>
                    </div>
                  </div>
                  <i class="fas fa-chevron-down text-slate-400"></i>
                </div>
                
                <div class="custom-select-dropdown dropdown-gradient" id="selectDropdown">
                  <!-- Digital Wallets -->
                  <div class="custom-option method-available selected" data-value="CashApp">
                    <div class="method-icon bg-green-900/30 text-green-400">
                      <i class="fas fa-money-bill-wave"></i>
                    </div>
                    <div>
                      <div class="font-medium">Cash App</div>
                      <div class="text-xs text-slate-400">Enter your $Cashtag</div>
                    </div>
                    <span class="availability-badge available">Available</span>
                  </div>
                  
                  <div class="custom-option method-available" data-value="PayPal">
                    <div class="method-icon bg-blue-900/30 text-blue-400">
                      <i class="fab fa-paypal"></i>
                    </div>
                    <div>
                      <div class="font-medium">PayPal</div>
                      <div class="text-xs text-slate-400">Enter your PayPal email</div>
                    </div>
                    <span class="availability-badge available">Available</span>
                  </div>
                  
                  <div class="custom-option method-available" data-value="Venmo">
                    <div class="method-icon bg-sky-900/30 text-sky-400">
                      <i class="fab fa-vimeo"></i>
                    </div>
                    <div>
                      <div class="font-medium">Venmo</div>
                      <div class="text-xs text-slate-400">Enter your Venmo username</div>
                    </div>
                    <span class="availability-badge available">Available</span>
                  </div>
                  
                  <!-- Bank Transfer -->
                  <div class="custom-option method-available" data-value="BANK">
                    <div class="method-icon bg-amber-900/30 text-amber-400">
                      <i class="fas fa-university"></i>
                    </div>
                    <div>
                      <div class="font-medium">Bank Transfer</div>
                      <div class="text-xs text-slate-400">Direct bank transfer</div>
                    </div>
                    <span class="availability-badge available">Available</span>
                  </div>
                  
                  <!-- Divider -->
                  <div class="px-4 py-2 text-xs text-slate-500 font-medium border-t border-slate-800/50">Cryptocurrency</div>
                  
                  <!-- Crypto Methods - CHANGE THESE LINES -->
<div class="custom-option method-available" data-value="BTC">
  <div class="method-icon bg-orange-900/30 text-orange-400">
    <i class="fab fa-bitcoin"></i>
  </div>
  <div>
    <div class="font-medium">Bitcoin (BTC)</div>
    <div class="text-xs text-slate-400">Bitcoin network</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="USDT TRC20">
  <div class="method-icon bg-teal-900/30 text-teal-400">
    <i class="fas fa-coins"></i>
  </div>
  <div>
    <div class="font-medium">USDT (TRC20)</div>
    <div class="text-xs text-slate-400">Tether on Tron</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="USDT ERC20">
  <div class="method-icon bg-purple-900/30 text-purple-400">
    <i class="fas fa-coins"></i>
  </div>
  <div>
    <div class="font-medium">USDT (ERC20)</div>
    <div class="text-xs text-slate-400">Tether on Ethereum</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="ETH">
  <div class="method-icon bg-indigo-900/30 text-indigo-400">
    <i class="fab fa-ethereum"></i>
  </div>
  <div>
    <div class="font-medium">Ethereum (ETH)</div>
    <div class="text-xs text-slate-400">Ethereum network</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="DOGE">
  <div class="method-icon bg-yellow-900/30 text-yellow-400">
    <i class="fab fa-reddit"></i>
  </div>
  <div>
    <div class="font-medium">Dogecoin (DOGE)</div>
    <div class="text-xs text-slate-400">Dogecoin network</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="LTC">
  <div class="method-icon bg-gray-900/30 text-gray-400">
    <i class="fas fa-coins"></i>
  </div>
  <div>
    <div class="font-medium">Litecoin (LTC)</div>
    <div class="text-xs text-slate-400">Litecoin network</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<!-- Other Methods - CHANGE THESE LINES -->
<div class="custom-option method-available" data-value="ApplePay">
  <div class="method-icon bg-slate-900/30 text-slate-400">
    <i class="fab fa-apple"></i>
  </div>
  <div>
    <div class="font-medium">Apple Pay</div>
    <div class="text-xs text-slate-400">Apple Pay transfer</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="GooglePay">
  <div class="method-icon bg-red-900/30 text-red-400">
    <i class="fab fa-google"></i>
  </div>
  <div>
    <div class="font-medium">Google Pay</div>
    <div class="text-xs text-slate-400">Google Pay transfer</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="Zelle">
  <div class="method-icon bg-violet-900/30 text-violet-400">
    <i class="fas fa-money-check"></i>
  </div>
  <div>
    <div class="font-medium">Zelle</div>
    <div class="text-xs text-slate-400">Zelle transfer</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="Skrill">
  <div class="method-icon bg-pink-900/30 text-pink-400">
    <i class="fas fa-money-bill"></i>
  </div>
  <div>
    <div class="font-medium">Skrill</div>
    <div class="text-xs text-slate-400">Skrill wallet</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="Wise">
  <div class="method-icon bg-emerald-900/30 text-emerald-400">
    <i class="fas fa-globe"></i>
  </div>
  <div>
    <div class="font-medium">Wise</div>
    <div class="text-xs text-slate-400">International transfer</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="Revolut">
  <div class="method-icon bg-blue-900/30 text-blue-400">
    <i class="fas fa-credit-card"></i>
  </div>
  <div>
    <div class="font-medium">Revolut</div>
    <div class="text-xs text-slate-400">Revolut transfer</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="Chime">
  <div class="method-icon bg-green-900/30 text-green-400">
    <i class="fas fa-mobile-alt"></i>
  </div>
  <div>
    <div class="font-medium">Chime</div>
    <div class="text-xs text-slate-400">Chime bank transfer</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>

<div class="custom-option method-available" data-value="Wire">
  <div class="method-icon bg-rose-900/30 text-rose-400">
    <i class="fas fa-exchange-alt"></i>
  </div>
  <div>
    <div class="font-medium">Wire Transfer</div>
    <div class="text-xs text-slate-400">International wire</div>
  </div>
  <span class="availability-badge available">Available</span> <!-- CHANGED -->
</div>
                </div>
              </div>
              
              <input type="hidden" name="network" id="network" value="CashApp">
            </div>

            
            <!-- Dynamic Fields -->
            <div id="dynamicFields" class="space-y-4">
              <!-- Digital Wallet Field -->
              <div id="digitalWalletField" class="method-field">
                <label class="text-sm font-medium" id="walletLabel">Cash App Tag</label>
                <input type="text" name="walletInfo" id="walletInput" placeholder="Enter your $Cashtag"
                  class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
              </div>
              
              <!-- Bank Fields -->
              <div id="bankFields" class="method-field hidden space-y-4">
                <div>
                  <label class="text-sm font-medium">Bank Name</label>
                  <input type="text" name="bankName" placeholder="e.g., Bank of America, Chase"
                    class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
                </div>
                <div>
                  <label class="text-sm font-medium">Account Holder Name</label>
                  <input type="text" name="accountName" placeholder="Full name as on account"
                    class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="text-sm font-medium">Account Number</label>
                    <input type="text" name="accountNumber" placeholder="Account number"
                      class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
                  </div>
                  <div>
                    <label class="text-sm font-medium">Routing Number</label>
                    <input type="text" name="routingNumber" placeholder="Routing number"
                      class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
                  </div>
                </div>
              </div>
              
              <!-- Crypto Fields -->
              <div id="cryptoFields" class="method-field hidden space-y-4">
                <div>
                  <label class="text-sm font-medium" id="cryptoLabel">Wallet Address</label>
                  <input type="text" name="cryptoAddress" id="cryptoInput" placeholder="Enter wallet address"
                    class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
                </div>
                <div class="bg-slate-800/30 border border-slate-700 rounded-xl p-3 text-xs">
                  <i class="fas fa-exclamation-triangle text-amber-400 mr-2"></i>
                  Please double-check the address. Transactions cannot be reversed.
                </div>
              </div>
              
              <!-- Other Methods Fields -->
              <div id="otherFields" class="method-field hidden">
                <label class="text-sm font-medium" id="otherLabel">Account Details</label>
                <input type="text" name="otherDetails" id="otherInput" placeholder="Enter account information"
                  class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-sm input-focus focus:outline-none">
              </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="submitBtn" class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 rounded-xl font-semibold text-white transition-colors">
              <i class="fas fa-paper-plane mr-2"></i>
              Submit Withdrawal Request
            </button>

            <!-- Fee Notice -->
            <div class="bg-slate-800/30 border border-slate-700 rounded-xl p-4">
              <div class="flex items-start">
                <i class="fas fa-info-circle text-blue-400 mt-0.5 mr-3"></i>
                <div class="text-sm">
                  <p class="font-medium mb-1">Withdrawal Fees</p>
                  <p class="text-slate-400">Digital wallets (Cash App, PayPal, Venmo): $1.50 or 1.5% (whichever is higher). Bank transfers: $3.00 or 2% (whichever is higher). Minimum withdrawal: $10.00.</p>
                </div>
              </div>
            </div>
          </form>
        </div>
      </section>

      <!-- Right Column - History -->
      <section>
        <div class="card-gradient border border-slate-800 rounded-2xl p-6 h-full">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-bold">Recent Withdrawals</h2>
            <% if (history && history.length > 0) { %>
              <a href="/transactions-history" class="text-sm text-blue-400 hover:text-blue-300">View All</a>
            <% } %>
          </div>

          <% if (!history || history.length === 0) { %>
            <div class="text-center py-10">
              <div class="w-20 h-20 mx-auto rounded-full bg-slate-800 flex items-center justify-center mb-4">
                <i class="fas fa-exchange-alt text-slate-600 text-2xl"></i>
              </div>
              <p class="text-slate-400 font-medium">No withdrawal history</p>
              <p class="text-slate-500 text-sm mt-1">Your withdrawals will appear here</p>
            </div>
          <% } else { %>
            <div class="space-y-3 max-h-[500px] overflow-y-auto pr-2">
              <% history.forEach(w => { 
                let statusClass = 'status-pending';
                let statusIcon = 'clock';
                if (w.status === 'completed' || w.status === 'success') {
                  statusClass = 'status-completed';
                  statusIcon = 'check-circle';
                } else if (w.status === 'failed' || w.status === 'rejected') {
                  statusClass = 'status-failed';
                  statusIcon = 'times-circle';
                }
              %>
                <div class="border border-slate-800 rounded-xl p-4 hover:bg-slate-800/30 transition-colors">
                  <div class="flex justify-between items-start mb-2">
                    <div class="flex items-center">
                      <% 
                        let methodIcon = 'money-bill-wave';
                        let methodColor = 'text-green-400';
                        if (w.network === 'PayPal') {
                          methodIcon = 'paypal';
                          methodColor = 'text-blue-400';
                        } else if (w.network === 'Venmo') {
                          methodIcon = 'vimeo';
                          methodColor = 'text-sky-400';
                        } else if (w.network === 'BANK') {
                          methodIcon = 'university';
                          methodColor = 'text-amber-400';
                        } else if (w.network.includes('BTC')) {
                          methodIcon = 'bitcoin';
                          methodColor = 'text-orange-400';
                        } else if (w.network.includes('USDT') || w.network.includes('ETH') || w.network.includes('DOGE') || w.network.includes('LTC')) {
                          methodIcon = 'coins';
                          methodColor = 'text-teal-400';
                        } else if (w.network.includes('Apple')) {
                          methodIcon = 'apple';
                          methodColor = 'text-slate-400';
                        } else if (w.network.includes('Google')) {
                          methodIcon = 'google';
                          methodColor = 'text-red-400';
                        }
                      %>
                      <div class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center mr-3">
                        <i class="fab fa-<%= methodIcon %> <%= methodColor %>"></i>
                      </div>
                      <div>
                        <p class="font-bold">$<%= Number(w.amount).toFixed(2) %></p>
                        <p class="text-slate-400 text-sm"><%= w.network %></p>
                      </div>
                    </div>
                    <div class="status-badge <%= statusClass %> flex items-center">
                      <i class="fas fa-<%= statusIcon %> mr-1 text-xs"></i>
                      <span class="capitalize"><%= w.status %></span>
                    </div>
                  </div>
                  <p class="text-xs text-slate-500 text-right">
                    <%= new Date(w.date).toLocaleDateString() %> at <%= new Date(w.date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                  </p>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Elements
      const form = document.getElementById('withdrawForm');
      const amountInput = document.getElementById('amountInput');
      const networkInput = document.getElementById('network');
      const selectButton = document.getElementById('selectButton');
      const selectDropdown = document.getElementById('selectDropdown');
      const selectedMethod = document.getElementById('selectedMethod');
      const selectedDetails = document.getElementById('selectedDetails');
      const selectedIcon = document.getElementById('selectedIcon');
      const submitBtn = document.getElementById('submitBtn');
      const withdrawAllBtn = document.getElementById('withdrawAllBtn');
      const maxAmountBtn = document.getElementById('maxAmountBtn');
      const quickAmounts = document.querySelectorAll('.quick-amount');
      
      // User balance
      const userBalance = <%= Number(user.balance || 0) %>;
      const availableMethods = ['CashApp', 'PayPal', 'Venmo', 'BANK', 'BTC', 'USDT TRC20', 'USDT ERC20', 'ETH', 'DOGE', 'LTC', 'ApplePay', 'GooglePay', 'Zelle', 'Skrill', 'Wise', 'Revolut', 'Chime', 'Wire'];
      const cryptoMethods = ['BTC', 'USDT TRC20', 'USDT ERC20', 'ETH', 'DOGE', 'LTC'];
      const otherMethods = ['ApplePay', 'GooglePay', 'Zelle', 'Skrill', 'Wise', 'Revolut', 'Chime', 'Wire'];
      
      // Method configurations
      const methodConfigs = {
        'CashApp': {
          icon: 'money-bill-wave',
          color: 'text-green-400',
          bgColor: 'bg-green-900/30',
          label: 'Cash App Tag',
          placeholder: 'Enter your $Cashtag',
          details: 'Enter your $Cashtag',
          fieldType: 'digitalWallet'
        },
        'PayPal': {
          icon: 'paypal',
          color: 'text-blue-400',
          bgColor: 'bg-blue-900/30',
          label: 'PayPal Email',
          placeholder: 'Enter your PayPal email',
          details: 'Enter your PayPal email',
          fieldType: 'digitalWallet'
        },
        'Venmo': {
          icon: 'vimeo',
          color: 'text-sky-400',
          bgColor: 'bg-sky-900/30',
          label: 'Venmo Username',
          placeholder: 'Enter your Venmo username',
          details: 'Enter your Venmo username',
          fieldType: 'digitalWallet'
        },
        'BANK': {
          icon: 'university',
          color: 'text-amber-400',
          bgColor: 'bg-amber-900/30',
          label: 'Bank Details',
          placeholder: '',
          details: 'Direct bank transfer',
          fieldType: 'bank'
        },
        'BTC': {
          icon: 'bitcoin',
          color: 'text-orange-400',
          bgColor: 'bg-orange-900/30',
          label: 'Bitcoin Address',
          placeholder: 'Enter your Bitcoin wallet address',
          details: 'Bitcoin network',
          fieldType: 'crypto'
        },
        'USDT TRC20': {
          icon: 'coins',
          color: 'text-teal-400',
          bgColor: 'bg-teal-900/30',
          label: 'USDT Address (TRC20)',
          placeholder: 'Enter your Tron wallet address',
          details: 'Tether on Tron',
          fieldType: 'crypto'
        },
        'USDT ERC20': {
          icon: 'coins',
          color: 'text-purple-400',
          bgColor: 'bg-purple-900/30',
          label: 'USDT Address (ERC20)',
          placeholder: 'Enter your Ethereum wallet address',
          details: 'Tether on Ethereum',
          fieldType: 'crypto'
        },
        'ETH': {
          icon: 'ethereum',
          color: 'text-indigo-400',
          bgColor: 'bg-indigo-900/30',
          label: 'Ethereum Address',
          placeholder: 'Enter your Ethereum wallet address',
          details: 'Ethereum network',
          fieldType: 'crypto'
        },
        'DOGE': {
          icon: 'reddit',
          color: 'text-yellow-400',
          bgColor: 'bg-yellow-900/30',
          label: 'Dogecoin Address',
          placeholder: 'Enter your Dogecoin wallet address',
          details: 'Dogecoin network',
          fieldType: 'crypto'
        },
        'LTC': {
          icon: 'coins',
          color: 'text-gray-400',
          bgColor: 'bg-gray-900/30',
          label: 'Litecoin Address',
          placeholder: 'Enter your Litecoin wallet address',
          details: 'Litecoin network',
          fieldType: 'crypto'
        },
        'ApplePay': {
          icon: 'apple',
          color: 'text-slate-400',
          bgColor: 'bg-slate-900/30',
          label: 'Apple Pay Email/Phone',
          placeholder: 'Enter your Apple Pay information',
          details: 'Apple Pay transfer',
          fieldType: 'other'
        },
        'GooglePay': {
          icon: 'google',
          color: 'text-red-400',
          bgColor: 'bg-red-900/30',
          label: 'Google Pay Details',
          placeholder: 'Enter your Google Pay information',
          details: 'Google Pay transfer',
          fieldType: 'other'
        },
        'Zelle': {
          icon: 'money-check',
          color: 'text-violet-400',
          bgColor: 'bg-violet-900/30',
          label: 'Zelle Email/Phone',
          placeholder: 'Enter your Zelle email or phone',
          details: 'Zelle transfer',
          fieldType: 'other'
        },
        'Skrill': {
          icon: 'money-bill',
          color: 'text-pink-400',
          bgColor: 'bg-pink-900/30',
          label: 'Skrill Email',
          placeholder: 'Enter your Skrill email',
          details: 'Skrill wallet',
          fieldType: 'other'
        },
        'Wise': {
          icon: 'globe',
          color: 'text-emerald-400',
          bgColor: 'bg-emerald-900/30',
          label: 'Wise Account Details',
          placeholder: 'Enter your Wise account details',
          details: 'International transfer',
          fieldType: 'other'
        },
        'Revolut': {
          icon: 'credit-card',
          color: 'text-blue-400',
          bgColor: 'bg-blue-900/30',
          label: 'Revolut Details',
          placeholder: 'Enter your Revolut information',
          details: 'Revolut transfer',
          fieldType: 'other'
        },
        'Chime': {
          icon: 'mobile-alt',
          color: 'text-green-400',
          bgColor: 'bg-green-900/30',
          label: 'Chime Account Details',
          placeholder: 'Enter your Chime account details',
          details: 'Chime bank transfer',
          fieldType: 'other'
        },
        'Wire': {
          icon: 'exchange-alt',
          color: 'text-rose-400',
          bgColor: 'bg-rose-900/30',
          label: 'Wire Transfer Details',
          placeholder: 'Enter wire transfer information',
          details: 'International wire',
          fieldType: 'other'
        }
      };
      
      // Initialize
      updateMethodFields('CashApp');
      
      // Toggle dropdown
      selectButton.addEventListener('click', function() {
        selectDropdown.classList.toggle('show');
      });
      
      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        if (!selectButton.contains(event.target) && !selectDropdown.contains(event.target)) {
          selectDropdown.classList.remove('show');
        }
      });
      
      // Method selection
      document.querySelectorAll('.custom-option').forEach(option => {
        option.addEventListener('click', function() {
          const method = this.getAttribute('data-value');
          
          // Update selected option
          document.querySelectorAll('.custom-option').forEach(opt => {
            opt.classList.remove('selected');
          });
          this.classList.add('selected');
          
          // Update dropdown button
          const config = methodConfigs[method];
          selectedMethod.textContent = method === 'BANK' ? 'Bank Transfer' : 
                                      method === 'USDT TRC20' ? 'USDT (TRC20)' :
                                      method === 'USDT ERC20' ? 'USDT (ERC20)' : method;
          selectedDetails.textContent = config.details;
          selectedIcon.className = `method-icon ${config.bgColor} ${config.color}`;
          selectedIcon.innerHTML = `<i class="fab fa-${config.icon}"></i>`;
          
          // Update hidden input
          networkInput.value = method;
          
          // Update form fields
          updateMethodFields(method);
          
          // Close dropdown
          selectDropdown.classList.remove('show');
        });
      });
      
      // Update form fields based on selected method
      function updateMethodFields(method) {
        const config = methodConfigs[method];
        const fieldType = config.fieldType;
        
        // Hide all fields first
        document.getElementById('digitalWalletField').classList.add('hidden');
        document.getElementById('bankFields').classList.add('hidden');
        document.getElementById('cryptoFields').classList.add('hidden');
        document.getElementById('otherFields').classList.add('hidden');
        
        // Show appropriate field type
        if (fieldType === 'digitalWallet') {
          const field = document.getElementById('digitalWalletField');
          field.classList.remove('hidden');
          document.getElementById('walletLabel').textContent = config.label;
          document.getElementById('walletInput').placeholder = config.placeholder;
          document.getElementById('walletInput').name = method === 'CashApp' ? 'cashAppTag' : 
                                                       method === 'PayPal' ? 'paypalEmail' : 'venmoUsername';
        } else if (fieldType === 'bank') {
          document.getElementById('bankFields').classList.remove('hidden');
        } else if (fieldType === 'crypto') {
          const field = document.getElementById('cryptoFields');
          field.classList.remove('hidden');
          document.getElementById('cryptoLabel').textContent = config.label;
          document.getElementById('cryptoInput').placeholder = config.placeholder;
          document.getElementById('cryptoInput').name = 'cryptoAddress';
        } else if (fieldType === 'other') {
          const field = document.getElementById('otherFields');
          field.classList.remove('hidden');
          document.getElementById('otherLabel').textContent = config.label;
          document.getElementById('otherInput').placeholder = config.placeholder;
          document.getElementById('otherInput').name = 'otherDetails';
        }
      }
      
      // Quick amount buttons
      quickAmounts.forEach(btn => {
        btn.addEventListener('click', function() {
          amountInput.value = this.getAttribute('data-amount');
          amountInput.focus();
        });
      });
      
      // Max amount button
      maxAmountBtn.addEventListener('click', function() {
        amountInput.value = userBalance.toFixed(2);
        amountInput.focus();
      });
      
      // Withdraw all button
      withdrawAllBtn.addEventListener('click', function() {
        amountInput.value = userBalance.toFixed(2);
        amountInput.focus();
        Swal.fire({
          icon: 'info',
          title: 'Maximum Amount',
          text: `Set withdrawal amount to $${userBalance.toFixed(2)}`,
          timer: 1500,
          showConfirmButton: false
        });
      });
      
      // Form submission
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const amount = parseFloat(amountInput.value);
        const method = networkInput.value;
        
        // Basic validation
        if (isNaN(amount) || amount < 10) {
          Swal.fire({
            icon: 'error',
            title: 'Invalid Amount',
            text: 'Minimum withdrawal amount is $10.00',
            confirmButtonColor: '#3b82f6'
          });
          return;
        }
        
        if (amount > userBalance) {
          Swal.fire({
            icon: 'error',
            title: 'Insufficient Balance',
            text: `You cannot withdraw more than your available balance of $${userBalance.toFixed(2)}`,
            confirmButtonColor: '#3b82f6'
          });
          return;
        }
        
        // Check if method is available
        // if (!availableMethods.includes(method)) {
        //   Swal.fire({
        //     icon: 'info',
        //     title: 'Method Not Available',
        //     text: `The ${method} withdrawal method is not available at the moment. Please select an available method.`,
        //     confirmButtonColor: '#3b82f6'
        //   });
        //   return;
        // }
        
        // Calculate fees
        let fee = 0;
        let feeType = '';
        
        if (method === 'BANK') {
          fee = Math.max(3, amount * 0.02);
          feeType = 'Bank Transfer Fee';
        } else {
          fee = Math.max(1.5, amount * 0.015);
          feeType = 'Digital Wallet Fee';
        }
        
        const netAmount = amount - fee;
        
        // Confirmation modal
        Swal.fire({
          title: 'Confirm Withdrawal',
          html: `
            <div class="text-left text-sm">
              <div class="bg-slate-800/30 rounded-xl p-4 mb-4">
                <div class="flex items-center mb-3">
                  <div class="w-10 h-10 rounded-lg ${methodConfigs[method].bgColor} flex items-center justify-center mr-3">
                    <i class="fab fa-${methodConfigs[method].icon} ${methodConfigs[method].color}"></i>
                  </div>
                  <div>
                    <p class="font-bold">${method === 'BANK' ? 'Bank Transfer' : method}</p>
                    <p class="text-slate-400">Withdrawal Method</p>
                  </div>
                </div>
                
                <div class="space-y-2">
                  <div class="flex justify-between">
                    <span class="text-slate-400">Withdrawal Amount:</span>
                    <span class="font-bold">$${amount.toFixed(2)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-400">${feeType}:</span>
                    <span class="text-amber-400">-$${fee.toFixed(2)}</span>
                  </div>
                  <div class="border-t border-slate-700 pt-2 mt-2">
                    <div class="flex justify-between font-bold">
                      <span>You'll Receive:</span>
                      <span class="text-green-400">$${netAmount.toFixed(2)}</span>
                    </div>
                  </div>
                </div>
              </div>
              <p class="text-slate-400 text-xs">Processing usually takes 1-3 business days. You'll be notified when the transfer is complete.</p>
            </div>
          `,
          icon: 'question',
          showCancelButton: true,
          confirmButtonColor: '#3b82f6',
          cancelButtonColor: '#64748b',
          confirmButtonText: 'Confirm Withdrawal',
          cancelButtonText: 'Cancel',
          width: '500px'
        }).then((result) => {
          if (result.isConfirmed) {
            // Show processing message
            Swal.fire({
              title: 'Processing...',
              text: 'Submitting your withdrawal request',
              allowOutsideClick: false,
              didOpen: () => {
                Swal.showLoading();
              }
            });
            
            // Submit the form after a brief delay
            setTimeout(() => {
              form.submit();
            }, 1000);
          }
        });
      });
      
      // Close dropdown on escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          selectDropdown.classList.remove('show');
        }
      });
    });
  </script>
</body>
</html>