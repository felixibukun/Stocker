  <!-- Mobile menu -->
  <div class="mobile-menu lg:hidden" id="mobileMenu">
    <div class="p-6 space-y-2">
      <a href="#hero" class="flex items-center gap-3 text-lg font-medium text-white py-3"><i data-lucide="home"></i> Home</a>
      <a href="#markets" class="flex items-center gap-3 text-lg font-medium text-white py-3"><i data-lucide="trending-up"></i> Markets</a>
      <a href="#platform" class="flex items-center gap-3 text-lg font-medium text-white py-3"><i data-lucide="layout-dashboard"></i> Platform</a>
      <a href="#pricing" class="flex items-center gap-3 text-lg font-medium text-white py-3"><i data-lucide="credit-card"></i> Pricing</a>
      <a href="#education" class="flex items-center gap-3 text-lg font-medium text-white py-3"><i data-lucide="graduation-cap"></i> Education</a>
