                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Moving live ticker, anchored to bottom of hero -->
      <div class="ticker-bar" aria-label="Live cryptocurrency prices">
        <div class="max-w-[1600px] mx-auto flex items-stretch">
          <div class="hidden sm:flex items-center gap-2.5 px-6 border-r border-white/10 bg-ink-900/80">
            <span class="live-dot"></span>
            <span class="text-xs font-semibold tracking-[.18em] text-white whitespace-nowrap">LIVE</span>
          </div>
          <div class="ticker-viewport flex-1">
            <div class="ticker-track" id="tickerTrack"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= STATS ================= -->
    <section class="py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass px-6 py-10 md:px-12 grid grid-cols-2 lg:grid-cols-4 gap-8 reveal">
          <div class="text-center lg:text-left">
            <p class="mono text-4xl font-semibold text-white"><span data-count="1000" data-suffix="+">0</span></p>
            <p class="mt-1 text-sm text-slate-400">Tradable instruments</p>
          </div>
          <div class="text-center lg:text-left">
            <p class="mono text-4xl font-semibold text-white"><span data-count="10" data-suffix="k+">0</span></p>
            <p class="mt-1 text-sm text-slate-400">Active traders</p>
