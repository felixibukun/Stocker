                <div class="icon-chip green !w-11 !h-11"><i data-lucide="shield-check"></i></div>
                <div><p class="text-sm font-semibold text-white">Secure platform</p><p class="text-xs text-slate-500">Bank-level security</p></div>
              </div>
              <div class="flex items-center gap-3">
                <div class="icon-chip !w-11 !h-11"><i data-lucide="zap"></i></div>
                <div><p class="text-sm font-semibold text-white">Fast execution</p><p class="text-xs text-slate-500">Low-latency orders</p></div>
              </div>
              <div class="flex items-center gap-3">
                <div class="icon-chip !w-11 !h-11"><i data-lucide="award"></i></div>
