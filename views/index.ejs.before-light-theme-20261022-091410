      <a href="/about" class="flex items-center gap-3 text-lg font-medium text-white py-3"><i data-lucide="info"></i> About</a>
      <div class="pt-6 mt-4 border-t border-white/10 space-y-3">
        <a href="/login" class="btn-ghost w-full">Login to Account</a>
        <a href="/signup" class="btn-gold w-full">Create Account</a>
      </div>
    </div>
  </div>

  <main>
    <!-- ================= HERO ================= -->
    <section id="hero" class="relative pt-[4.25rem]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-14 md:pt-24 md:pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

          <!-- Copy -->
          <div class="lg:col-span-7">
            <div class="eyebrow reveal"><span class="live-dot"></span> Live markets &middot; Forex &middot; Crypto &middot; Stocks &middot; Indices</div>

            <h1 class="reveal d1 mt-6 text-[2.6rem] leading-[1.04] sm:text-6xl lg:text-[4.4rem] font-bold tracking-tight text-white">
              Trade global markets with
              <span class="gold-text block">institutional precision.</span>
            </h1>

            <p class="reveal d2 mt-6 text-lg text-slate-400 max-w-xl leading-relaxed">
              One platform for Forex, crypto, stocks and indices. Real-time pricing, transparent costs and professional-grade tools &mdash; built for traders who take execution seriously.
            </p>

            <div class="reveal d3 mt-9 flex flex-col sm:flex-row gap-3.5">
              <a href="/signup" class="btn-gold group text-[0.95rem]">
                Start Trading
                <i data-lucide="arrow-right" class="transition-transform group-hover:translate-x-1"></i>
