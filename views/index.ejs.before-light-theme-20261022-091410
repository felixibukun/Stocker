                <div class="mt-3 divide-y divide-white/5" id="panelRows"></div>

                <a href="/signup" class="mt-5 flex items-center justify-between rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-slate-300 hover:border-gold-500/40 hover:text-white transition-colors">
