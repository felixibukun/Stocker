    <div class="aurora a2"></div>
    <div class="aurora a3"></div>
    <div class="grain"></div>
  </div>

  <!-- Header -->
  <header class="site-header" id="siteHeader">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="h-[4.25rem] flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/temp/custom/img/logo.png" alt="Global Equinox Trade" class="h-8 w-auto transition-transform duration-300 group-hover:scale-105">
          <span class="hidden sm:block text-[0.95rem] font-semibold tracking-tight" style="color:#172033">Global Equinox Trade</span>
        </a>

        <nav class="hidden lg:flex items-center gap-8">
          <a href="/" class="nav-link">Home</a>
          <a href="/markets" class="nav-link">Markets</a>
          <a href="/platform" class="nav-link">Platform</a>
          <a href="/pricing" class="nav-link" aria-current="page">Pricing</a>
