<!DOCTYPE html> <html lang="en" class="dark h-full"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Copy Trader</title> <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"> <script src="https://cdn.tailwindcss.com"></script> <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script> <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script> <script> tailwind.config = { darkMode: 'class', theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] }, colors: { primary: { 600: '#4F46E5' } } } } } </script>

 </head> <body class="min-h-screen bg-slate-950 text-white"> <div class="min-h-screen flex flex-col">
<header class="h-16 border-b border-slate-800 bg-slate-950/80 backdrop-blur-xl flex items-center">
  <div class="w-full max-w-6xl mx-auto px-4 flex items-center justify-between">
    <p class="text-sm font-semibold">Copy Trader</p>
    <a href="/dashboard" class="text-xs text-slate-300 hover:text-white">Back</a>
  </div>
</header>

<main class="flex-1">
  <div class="max-w-6xl mx-auto px-4 py-8 space-y-6">

    <p class="text-xs text-slate-400">Select a trader and enter the amount</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

      <% traders.forEach(trader => { %>
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 shadow-lg space-y-3">

        <p class="text-sm font-semibold text-slate-100"><%= trader.name %></p>

        <div class="flex justify-between text-xs text-slate-400">
          <span>Win rate</span>
          <span class="text-slate-100"><%= trader.winrate %>%</span>
        </div>

        <div class="flex justify-between text-xs text-slate-400">
          <span>Total profit</span>
          <span class="text-slate-100">$<%= trader.profit %></span>
        </div>

        <div class="flex justify-between text-xs text-slate-400">
          <span>Minimum copy</span>
          <span class="text-slate-100">$<%= trader.minAmount %></span>
        </div>

        <form action="/copy-trader/follow" method="POST" class="mt-3 space-y-2">
          <input type="hidden" name="traderId" value="<%= trader.id %>">

          <input
            type="number"
            name="amount"
            required
            min="<%= trader.minAmount %>"
            placeholder="Enter amount"
            class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-sm text-white"
          >

          <button
            type="submit"
            class="w-full py-2 rounded-lg bg-primary-600 text-xs font-semibold">
            Copy Trader
          </button>
        </form>

      </div>
      <% }) %>

    </div>

  </div>
</main>

</div> <script> document.addEventListener('DOMContentLoaded', function () { if (typeof lucide !== 'undefined') { lucide.createIcons() } }) </script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>
 </body> </html>