  <style>
    .cookie-card {
      background: linear-gradient(145deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.7) 100%);
      border: 1px solid rgba(100, 116, 139, 0.3);
      border-radius: 12px;
      transition: all 0.3s ease;
    }
    
    .cookie-card:hover {
      border-color: rgba(139, 92, 246, 0.5);
      transform: translateY(-2px);
    }
    
    .cookie-icon {
      background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
    }
    
    .cookie-crumb {
      width: 6px;
      height: 6px;
      background: #f59e0b;
      border-radius: 50%;
      position: absolute;
      animation: float 3s infinite ease-in-out;
    }
    
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(180deg); }
    }
    
    .cookie-crumb:nth-child(1) { top: 20%; left: 30%; animation-delay: 0s; }
    .cookie-crumb:nth-child(2) { top: 60%; left: 20%; animation-delay: 0.5s; }
    .cookie-crumb:nth-child(3) { top: 40%; left: 70%; animation-delay: 1s; }
    .cookie-crumb:nth-child(4) { top: 70%; left: 60%; animation-delay: 1.5s; }
    .cookie-crumb:nth-child(5) { top: 30%; left: 50%; animation-delay: 2s; }
    
    .cookie-settings {
      background: linear-gradient(145deg, rgba(124, 58, 237, 0.1) 0%, rgba(30, 41, 59, 0.7) 100%);
      border: 1px solid rgba(139, 92, 246, 0.3);
    }
    
    .fade-in {
      animation: fadeIn 0.6s ease-out;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

