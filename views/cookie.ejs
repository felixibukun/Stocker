<script>
  // Set dates
  document.getElementById('currentDate').textContent = new Date().toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
  
  // Set last review date (30 days ago)
  const lastReview = new Date();
  lastReview.setDate(lastReview.getDate() - 30);
  document.getElementById('lastReviewDate').textContent = lastReview.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });

  // Cookie management functions
  function saveCookiePreferences() {
    const analytics = document.getElementById('analyticsToggle').checked;
    const marketing = document.getElementById('marketingToggle').checked;
    
    // In a real implementation, this would save to localStorage or send to server
    localStorage.setItem('cookiePreferences', JSON.stringify({
      analytics,
      marketing,
      saved: new Date().toISOString()
    }));
    
    // Show success message
    alert('Cookie preferences saved!');
  }

  function toggleAnalytics() {
    const toggle = document.getElementById('analyticsToggle');
    toggle.checked = !toggle.checked;
    toggle.parentElement.querySelector('.slider').classList.toggle('bg-purple-600', toggle.checked);
    toggle.parentElement.querySelector('.slider').classList.toggle('bg-slate-700', !toggle.checked);
    toggle.parentElement.querySelector('.dot').classList.toggle('left-5', toggle.checked);
    toggle.parentElement.querySelector('.dot').classList.toggle('left-1', !toggle.checked);
  }

  function toggleMarketing() {
    const toggle = document.getElementById('marketingToggle');
    toggle.checked = !toggle.checked;
    toggle.parentElement.querySelector('.slider').classList.toggle('bg-purple-600', toggle.checked);
    toggle.parentElement.querySelector('.slider').classList.toggle('bg-slate-700', !toggle.checked);
    toggle.parentElement.querySelector('.dot').classList.toggle('left-5', toggle.checked);
    toggle.parentElement.querySelector('.dot').classList.toggle('left-1', !toggle.checked);
  }

  function manageCookies() {
    // Scroll to management section
    document.getElementById('management').scrollIntoView({ behavior: 'smooth' });
  }

  function acceptAllCookies() {
    document.getElementById('analyticsToggle').checked = true;
    document.getElementById('marketingToggle').checked = true;
    saveCookiePreferences();
    document.getElementById('cookieConsent').style.display = 'none';
  }

  // Show cookie consent banner if not already accepted
  document.addEventListener('DOMContentLoaded', () => {
    const hasAccepted = localStorage.getItem('cookieConsent');
    if (!hasAccepted) {
      setTimeout(() => {
        document.getElementById('cookieConsent').style.display = 'block';
      }, 1000);
    }

    // Load saved preferences
    const saved = localStorage.getItem('cookiePreferences');
    if (saved) {
      const prefs = JSON.parse(saved);
      document.getElementById('analyticsToggle').checked = prefs.analytics;
      document.getElementById('marketingToggle').checked = prefs.marketing;
      
      // Update toggle positions
      document.querySelectorAll('input[type="checkbox"]').forEach(toggle => {
        const slider = toggle.parentElement.querySelector('.slider');
        const dot = toggle.parentElement.querySelector('.dot');
        if (slider && dot) {
          slider.classList.toggle('bg-purple-600', toggle.checked);
          slider.classList.toggle('bg-slate-700', !toggle.checked);
          dot.classList.toggle('left-5', toggle.checked);
          dot.classList.toggle('left-1', !toggle.checked);
        }
      });
    }

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        if (targetId === '#') return;
        
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          window.scrollTo({
            top: targetElement.offsetTop - 120,
            behavior: 'smooth'
          });
        }
      });
    });

    // Add animation delays
    document.querySelectorAll('.fade-in').forEach((el, index) => {
      el.style.animationDelay = `${index * 0.1}s`;
    });
  });
</script>
</body>
