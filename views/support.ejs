<!DOCTYPE html> <html lang="en" class="dark"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Support</title> <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"> <script src="https://cdn.tailwindcss.com"></script> <style> body { background: radial-gradient(circle at top, #0f172a, #020617); } </style> </head> <body class="text-white font-sans"> <header class="border-b border-slate-800 bg-slate-950/80 backdrop-blur-xl"> <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between"> <div class="flex items-center gap-2"> <i class="text-primary-400 text-xl">📩</i> <p class="text-sm font-semibold">Support Center</p> </div> <a href="/dashboard" class="text-xs text-slate-300 hover:text-white">Back</a> </div> </header> <main class="max-w-5xl mx-auto px-4 py-10">
<div class="bg-slate-900/70 border border-slate-800 rounded-2xl shadow-xl p-6 md:p-8">

  <div class="mb-6">
    <p class="text-xl font-semibold text-slate-100">Submit a Ticket</p>
    <p class="text-xs text-slate-400 mt-1">Support replies within 24 hours.</p>
  </div>

  <form action="/support" method="POST" class="space-y-5">

    <div>
      <label class="text-xs text-slate-300 mb-1 block">Subject</label>
      <input
        name="subject"
        placeholder="Short title of your request"
        required
        class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-xl text-sm focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600"
      >
    </div>

    <div>
      <label class="text-xs text-slate-300 mb-1 block">Message</label>
      <textarea
        name="message"
        rows="5"
        placeholder="Describe your issue clearly"
        required
        class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-xl text-sm focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600"
      ></textarea>
    </div>

    <button class="w-full py-3 rounded-xl bg-primary-600 text-xs font-semibold hover:bg-primary-500 transition">
      Submit Ticket
    </button>

  </form>

</div>

</main> <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>

<script> Swal.fire({ icon: '<%= toast.type %>', title: '<%= toast.message %>', toast: true, position: 'top', showConfirmButton: false, timer: 2500 }) </script>

<% } %>

</body> </html>