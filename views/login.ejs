<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif']
          },
          colors: {
            primary: {
              600: '#4F46E5'
            }
          }
        }
      }
    }
  </script>

  <style>
    body { overflow-x: hidden; }
  </style>

</head>

<body class="min-h-screen bg-slate-950 text-white flex items-center justify-center px-4">

  <!-- Background FX -->
  <div class="fixed inset-0 pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900"></div>
    <div class="absolute -top-28 -left-20 w-72 h-72 bg-primary-600/30 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-cyan-500/20 rounded-full blur-3xl"></div>
  </div>

  <!-- Login Card -->
  <div class="relative w-full max-w-md bg-slate-900/70 border border-slate-700 backdrop-blur-xl shadow-xl rounded-3xl p-8">

    <div class="flex flex-col items-center mb-6">
      <img src="/temp/custom/img/logo.png" class="h-12 mb-3" alt="Logo">
      <h1 class="text-2xl font-semibold">Welcome Back</h1>
      <p class="text-slate-400 text-sm mt-1">Login to your trading dashboard</p>
    </div>

    <form action="/login" method="POST" class="space-y-6">

      <div>
        <label class="text-sm text-slate-300">Username</label>
        <input 
          type="text" 
          name="username"
          required
          class="w-full mt-2 bg-slate-900/80 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-primary-600 focus:border-primary-600"
          placeholder="Enter your username">
      </div>

      <div>
        <label class="text-sm text-slate-300">Password</label>
        <input 
          type="password" 
          name="password"
          required
          class="w-full mt-2 bg-slate-900/80 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-primary-600 focus:border-primary-600"
          placeholder="Enter your password">
      </div>

      <button 
        type="submit"
        class="w-full py-3 bg-primary-600 rounded-xl font-semibold text-white mt-2 hover:bg-primary-600/90 transition">
        Login
      </button>

    </form>

    <p class="text-center text-sm text-slate-400 mt-6">
      Don’t have an account?
      <a href="/signup" class="text-primary-600 font-semibold">Register</a>
    </p>

  </div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

</body>
</html>