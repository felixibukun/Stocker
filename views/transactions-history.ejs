<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Transactions History</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-950 text-white">

<header class="h-16 border-b border-slate-800 bg-slate-950/80 backdrop-blur-xl flex items-center">
  <div class="max-w-5xl mx-auto w-full px-4 flex justify-between">
    <p class="text-sm font-semibold">Transactions History</p>
    <a href="/dashboard" class="text-xs text-slate-300 hover:text-white">Back</a>
  </div>
</header>

<main class="max-w-5xl mx-auto px-4 py-8">

  <div class="bg-slate-900/80 rounded-2xl border border-slate-800 p-6">

    <p class="text-sm font-semibold mb-4 text-slate-100">All Transactions</p>

    <% if (!transactions || transactions.length === 0) { %>

      <p class="text-xs text-slate-400 mb-4">No transactions yet</p>

      <div class="text-center text-slate-600 text-xs">
        Deposits and withdrawals will appear here.
      </div>

    <% } else { %>

      <div class="space-y-3 text-xs">
        <% transactions.forEach(t => { %>

          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">

            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Type</span>
              <span class="text-slate-200 capitalize"><%= t.type %></span>
            </div>

            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Amount</span>
              <span class="text-slate-100">$<%= Number(t.amount).toFixed(2) %></span>
            </div>

            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Status</span>

              <% if (t.status === 'approved' || t.status === 'profit') { %>
                <span class="text-emerald-400 font-semibold"><%= t.status %></span>
              <% } else if (t.status === 'pending') { %>
                <span class="text-amber-400 font-semibold">Pending</span>
              <% } else { %>
                <span class="text-red-400 font-semibold"><%= t.status %></span>
              <% } %>

            </div>

            <div class="flex justify-between">
              <span class="text-slate-400">Date</span>
              <span class="text-slate-500"><%= new Date(t.date).toLocaleString() %></span>
            </div>

          </div>

        <% }) %>
      </div>

    <% } %>

  </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

</body>
</html>
