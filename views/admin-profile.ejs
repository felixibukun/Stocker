<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Admin Profile</title> <script src="https://cdn.tailwindcss.com"></script>
 </head> <body class="bg-slate-950 text-white min-h-screen"> <div class="w-full bg-slate-900 border-b border-slate-800 p-4 flex items-center justify-between"> <div> <p class="text-sm font-semibold">Admin profile</p> <p class="text-xs text-slate-400">Update your login details</p> </div>
<a href="/admin" class="bg-slate-800 px-4 py-2 rounded text-sm">
  Back to dashboard
</a>

</div> <div class="max-w-lg mx-auto mt-8 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
<p class="text-lg font-semibold mb-4">Login details</p>

<form action="/admin/profile" method="POST" class="space-y-4">

  <div>
    <label class="block text-xs text-slate-400 mb-1">Username</label>
    <input
      type="text"
      name="username"
      value="<%= adminUser.username %>"
      required
      class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-sm outline-none"
    >
  </div>

<div class="relative">
  <label class="block text-xs text-slate-400 mb-1">Current password</label>
  <div class="relative">
    <input 
      type="password" 
      name="currentPassword" 
      placeholder="Enter current admin password" 
      class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-sm outline-none pr-10"
      id="currentPassword"
    >
    <button 
      type="button" 
      class="absolute right-3 top-1/2 transform -translate-y-1/2 text-slate-400 hover:text-slate-300 focus:outline-none"
      onclick="togglePassword('currentPassword')"
      aria-label="Toggle password visibility"
    >
      <svg class="w-5 h-5" id="currentPasswordIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
    </button>
  </div>
</div>

<div class="relative mt-4">
  <label class="block text-xs text-slate-400 mb-1">New password</label>
  <div class="relative">
    <input 
      type="password" 
      name="newPassword" 
      placeholder="Enter new admin password" 
      class="w-full px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-sm outline-none pr-10"
      id="newPassword"
    >
    <button 
      type="button" 
      class="absolute right-3 top-1/2 transform -translate-y-1/2 text-slate-400 hover:text-slate-300 focus:outline-none"
      onclick="togglePassword('newPassword')"
      aria-label="Toggle password visibility"
    >
      <svg class="w-5 h-5" id="newPasswordIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
    </button>
  </div>
</div>

<script>
function togglePassword(inputId) {
  const passwordInput = document.getElementById(inputId);
  const icon = document.getElementById(inputId + 'Icon');
  
  if (passwordInput.type === 'password') {
    passwordInput.type = 'text';
    // Eye-off icon (hidden password)
    icon.innerHTML = `
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L6.59 6.59m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
    `;
  } else {
    passwordInput.type = 'password';
    // Eye icon (visible password)
    icon.innerHTML = `
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
    `;
  }
}
</script>
  <button
    type="submit"
    class="w-full py-2.5 rounded-lg bg-blue-600 text-sm font-semibold">
    Save changes
  </button>

</form>

</div> 
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>
</body> </html>