<!doctype html>
<html lang="en" class="dark">
<head>
    <link rel="icon" type="image/png" href="/temp/custom/img/logo.png?v=3">
<meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="Understand the markets, the instruments, and the risks before making a trading decision. Explore Forex, Stocks, Indices, Commodities and Crypto on Global Equinox Trade.">
  <title>Explore Global Markets | Global Equinox Trade</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['DM Sans', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace', 'monospace']
          },
          colors: {
            ink: { 950: '#05080f', 900: '#070b14', 850: '#0a101c', 800: '#0e1626', 700: '#16213a' },
            gold: { 300: '#f1d99a', 400: '#e6c36a', 500: '#d4af37', 600: '#b8932a' },
            up: '#2ee6a6',
            down: '#ff6b81'
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script>
  <link rel="stylesheet" href="/css/global-equinox-gold.css?v=pages20261023">

  <style>
    :root {
      --gold: #d4af37;
      --gold-soft: #e6c36a;
      --up: #2ee6a6;
      --down: #ff6b81;
      --line: rgba(255,255,255,.08);
      --header-h: 4.25rem;
    }
    * { -webkit-tap-highlight-color: transparent; }
    html { scroll-behavior: smooth; }
    body {
      background: #f7f8fc;
      color: #172033;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      font-feature-settings: "ss01", "cv11";
    }
    ::selection { background: rgba(212,175,55,.35); color: #172033; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: linear-gradient(#d4af37, #8a6d1c); border-radius: 4px; }

    i[data-lucide] { width: 18px; height: 18px; stroke-width: 1.6; display: inline-block; vertical-align: middle; }
    .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

    /* ---------- Background ---------- */
    .bg-stage { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; background: #f7f8fc; }
    .bg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(15,23,42,.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15,23,42,.045) 1px, transparent 1px);
      background-size: 56px 56px;
      -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 30%, transparent 75%);
              mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 30%, transparent 75%);
    }
    .aurora { position: absolute; border-radius: 9999px; filter: blur(110px); opacity: .16; will-change: transform; }
    .aurora.a1 { width: 620px; height: 620px; top: -220px; left: 8%; background: radial-gradient(circle, rgba(212,175,55,.32), transparent 65%); animation: drift1 22s ease-in-out infinite; }
    .aurora.a2 { width: 560px; height: 560px; top: 8%; right: -140px; background: radial-gradient(circle, rgba(46,230,166,.18), transparent 65%); animation: drift2 26s ease-in-out infinite; }
    .aurora.a3 { width: 700px; height: 700px; bottom: -300px; left: -160px; background: radial-gradient(circle, rgba(79,70,229,.2), transparent 65%); animation: drift1 30s ease-in-out infinite reverse; }
    @keyframes drift1 { 0%,100% { transform: translate(0,0) } 50% { transform: translate(60px,40px) } }
    @keyframes drift2 { 0%,100% { transform: translate(0,0) } 50% { transform: translate(-50px,60px) } }
    .grain {
      position: absolute; inset: 0; opacity: .025; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    /* ---------- Header ---------- */
    .site-header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      backdrop-filter: blur(16px) saturate(140%);
      -webkit-backdrop-filter: blur(16px) saturate(140%);
      background: rgba(255,255,255,.94);
      border-bottom: 1px solid #e5e7eb;
      transition: transform .35s ease, background .3s ease;
    }
    .site-header.is-hidden { transform: translateY(-100%); }
    .nav-link { position: relative; font-size: .875rem; font-weight: 500; color: #475569; transition: color .2s; padding: .25rem 0; }
    .nav-link::after { content: ""; position: absolute; left: 0; bottom: -4px; height: 1px; width: 0; background: linear-gradient(90deg, var(--gold), transparent); transition: width .3s ease; }
    .nav-link:hover { color: #111827; }
    .nav-link:hover::after { width: 100%; }
    .nav-link[aria-current="page"] { color: #8a6815; font-weight: 600; }
    .nav-link[aria-current="page"]::after { width: 100%; }

    .mobile-menu {
      position: fixed; top: var(--header-h); left: 0; right: 0; bottom: 0; z-index: 999;
      background: rgba(255,255,255,.98); backdrop-filter: blur(20px);
      transform: translateX(100%); transition: transform .3s cubic-bezier(.4,0,.2,1);
      overflow-y: auto;
    }
    .mobile-menu.open { transform: translateX(0); }
    .mobile-menu a { color: #172033; }

    /* ---------- Buttons ---------- */
    .btn-gold {
      position: relative; display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
      padding: .85rem 1.6rem; border-radius: 14px; font-weight: 600; color: #1a1405 !important;
      background: linear-gradient(135deg, #f1d99a 0%, #d4af37 55%, #b8932a 100%);
      box-shadow: 0 8px 30px -8px rgba(212,175,55,.55), inset 0 1px 0 rgba(255,255,255,.5);
      transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 14px 40px -8px rgba(212,175,55,.7), inset 0 1px 0 rgba(255,255,255,.5); filter: brightness(1.05); }
    .btn-ghost {
      display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
      padding: .85rem 1.6rem; border-radius: 14px; font-weight: 500; color: #172033 !important;
      background: #fff; border: 1px solid #dbe2ea;
      transition: background .25s ease, border-color .25s ease, transform .25s ease;
    }
    .btn-ghost:hover { background: #f1f5f9; border-color: #cbd5e1; transform: translateY(-2px); }

    /* ---------- Cards ---------- */
    .glass {
      background: linear-gradient(145deg,#fff,#f8fafc);
      border: 1px solid #e2e8f0;
      box-shadow: 0 16px 44px rgba(15,23,42,.07);
      backdrop-filter: blur(12px);
      border-radius: 24px;
    }
    .spot { position: relative; overflow: hidden; transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease; }
    .spot::before {
      content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .35s ease;
      background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(212,175,55,.13), transparent 45%);
    }
    .spot:hover { transform: translateY(-4px); border-color: rgba(212,175,55,.35); box-shadow: 0 22px 48px rgba(15,23,42,.11); }
    .spot:hover::before { opacity: 1; }

    .icon-chip {
      width: 46px; height: 46px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(145deg, rgba(212,175,55,.18), rgba(212,175,55,.04));
      border: 1px solid rgba(212,175,55,.28); color: #987015;
    }
    .icon-chip.green { background: linear-gradient(145deg, rgba(46,230,166,.16), rgba(46,230,166,.03)); border-color: rgba(46,230,166,.26); color: #047857; }

    .eyebrow {
      display: inline-flex; align-items: center; gap: .5rem; padding: .4rem .9rem; border-radius: 9999px;
      font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
      color: #8a6815; background: #fff9e8; border: 1px solid #ead9a5;
    }
    .gold-text {
      background: linear-gradient(120deg, #f6e7b8 0%, #e6c36a 35%, #d4af37 60%, #f1d99a 100%);
      background-size: 200% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
      animation: sheen 6s linear infinite;
    }
    @keyframes sheen { to { background-position: 200% center; } }

    /* ---------- Reveal ---------- */
    .reveal { opacity: 0; transform: translateY(26px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); }
    .reveal.visible { opacity: 1; transform: none; }
    .d1 { transition-delay: .08s } .d2 { transition-delay: .16s } .d3 { transition-delay: .24s } .d4 { transition-delay: .32s }

    /* ---------- Ticker / live ---------- */
    .live-dot { width: 8px; height: 8px; border-radius: 9999px; background: #059669; position: relative; display: inline-block; }
    .live-dot::after { content: ""; position: absolute; inset: -4px; border-radius: 9999px; border: 1px solid #059669; animation: ping 1.8s cubic-bezier(0,0,.2,1) infinite; }
    @keyframes ping { 0% { transform: scale(.6); opacity: .9 } 100% { transform: scale(1.8); opacity: 0 } }

    .ticker-bar {
      position: relative; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;
      background: #fff;
      backdrop-filter: blur(14px);
    }
    .ticker-viewport {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
              mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    }
    .ticker-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
    .ticker-bar:hover .ticker-track { animation-play-state: paused; }
    @keyframes marquee { to { transform: translateX(-50%); } }
    .ticker-set { display: flex; flex-shrink: 0; }
    .ticker-item { display: flex; align-items: center; gap: .85rem; padding: 1rem 1.6rem; white-space: nowrap; border-right: 1px solid #e2e8f0; }
    .coin-badge { width: 30px; height: 30px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-size: .8rem; font-weight: 700; color: #fff; flex-shrink: 0; }
    .chg { font-size: .75rem; font-weight: 600; padding: .15rem .5rem; border-radius: 8px; background: #f1f5f9; color: #475569; }
    .chg.is-up { color: #047857; background: #d1fae5; }
    .chg.is-down { color: #be123c; background: #ffe4e6; }
    .flash-up { animation: flashUp .9s ease; }
    .flash-down { animation: flashDown .9s ease; }
    @keyframes flashUp { 0% { color: #059669; text-shadow: 0 0 14px rgba(46,230,166,.7); } 100% { color: inherit; text-shadow: none; } }
    @keyframes flashDown { 0% { color: #e11d48; text-shadow: 0 0 14px rgba(255,107,129,.7); } 100% { color: inherit; text-shadow: none; } }
    .spark { width: 84px; height: 28px; overflow: visible; }
    .spark polyline { fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }

    /* ---------- Misc ---------- */
    .divider-glow { height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,.4), transparent); }
    .step-num {
      font-family: 'JetBrains Mono', monospace; font-size: .8rem; font-weight: 600; color: #987015;
      width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
      border: 1px solid rgba(212,175,55,.3); background: rgba(212,175,55,.08);
    }
    .field {
      width: 100%; padding: .85rem 1rem; border-radius: 14px; color: #172033;
      background: #fff; border: 1px solid #cbd5e1; outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .field::placeholder { color: #94a3b8; }
    .field:focus { border-color: rgba(212,175,55,.6); box-shadow: 0 0 0 3px rgba(212,175,55,.14); }
    .chip { display: inline-flex; padding: .25rem .65rem; border-radius: 9999px; font-size: .72rem; font-weight: 500; color: #334155; background: #f1f5f9; border: 1px solid #e2e8f0; }
    .price-ring { position: relative; }
    .price-ring::before {
      content: ""; position: absolute; inset: 0; padding: 1px; border-radius: inherit;
      background: linear-gradient(160deg, rgba(212,175,55,.7), rgba(212,175,55,.05) 40%, rgba(46,230,166,.25));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
              mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      pointer-events: none; opacity: .55;
    }

    /* ---------- Market category cards ---------- */
    .market-card {
      background: linear-gradient(145deg,#fff,#f8fafc);
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 26px;
      box-shadow: 0 12px 32px rgba(15,23,42,.06);
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
      position: relative;
      overflow: hidden;
    }
    .market-card::before {
      content:""; position:absolute; inset:0; pointer-events:none; opacity:0; transition:opacity .35s ease;
      background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(212,175,55,.12), transparent 45%);
    }
    .market-card:hover { transform: translateY(-5px); border-color: rgba(212,175,55,.4); box-shadow: 0 20px 46px rgba(15,23,42,.11); }
    .market-card:hover::before { opacity: 1; }
    .market-card .m-icon {
      width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(145deg, rgba(212,175,55,.18), rgba(212,175,55,.04));
      border: 1px solid rgba(212,175,55,.28); color: #987015; margin-bottom: 18px;
    }
    .market-card h3 { font-size: 1.15rem; font-weight: 700; color: #172033; margin: 0 0 .5rem; }
    .market-card p { font-size: .9rem; line-height: 1.7; color: #596579; margin: 0; }
    .market-card .m-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }

    /* ---------- Comparison table ---------- */
    .cmp-wrap { overflow-x: auto; border-radius: 18px; border: 1px solid #e2e8f0; background: #fff; box-shadow: 0 12px 32px rgba(15,23,42,.06); }
    .cmp-table { width: 100%; border-collapse: collapse; min-width: 720px; font-size: .88rem; }
    .cmp-table th, .cmp-table td { padding: 16px 18px; text-align: left; border-bottom: 1px solid #eef2f7; }
    .cmp-table thead th { background: #f8fafc; color: #475569; font-weight: 700; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
    .cmp-table tbody td:first-child { font-weight: 600; color: #172033; }
    .cmp-table tbody tr:last-child td { border-bottom: 0; }
    .cmp-table tbody tr:hover td { background: #fcfaf3; }
    .cmp-table .mono { color: #475569; }

    /* ---------- Accordion ---------- */
    .acc-item { border: 1px solid #e2e8f0; border-radius: 16px; background: #fff; box-shadow: 0 8px 24px rgba(15,23,42,.04); overflow: hidden; }
    .acc-item + .acc-item { margin-top: 12px; }
    .acc-trigger {
      width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
      padding: 18px 22px; background: #fff; border: 0; cursor: pointer; font-weight: 600; font-size: 1rem; color: #172033;
      text-align: left; transition: background .2s ease;
    }
    .acc-trigger:hover { background: #fcfaf3; }
    .acc-trigger .acc-ico { transition: transform .3s ease; color: #987015; flex-shrink: 0; }
    .acc-item.open .acc-trigger .acc-ico { transform: rotate(180deg); }
    .acc-panel { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
    .acc-panel-inner { padding: 0 22px 20px; color: #596579; font-size: .92rem; line-height: 1.75; }
    .acc-item.open .acc-panel { max-height: 500px; }

    /* ---------- Instrument tabs ---------- */
    .tab-btn {
      display: inline-flex; align-items: center; gap: .45rem; padding: .55rem 1.1rem; border-radius: 9999px;
      font-size: .82rem; font-weight: 600; color: #475569; background: #fff; border: 1px solid #e2e8f0;
      cursor: pointer; transition: all .2s ease; white-space: nowrap;
    }
    .tab-btn:hover { border-color: rgba(212,175,55,.5); color: #8a6815; }
    .tab-btn.active { background: linear-gradient(135deg, #f1d99a, #d4af37); color: #1a1405; border-color: transparent; box-shadow: 0 6px 20px -6px rgba(212,175,55,.6); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; animation: fadeIn .35s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

    /* ---------- Risk callout ---------- */
    .risk-callout {
      background: linear-gradient(135deg, #fffbef, #fff7e0);
      border: 1px solid #ead9a5; border-radius: 20px;
      padding: 28px 30px;
    }

    @media (max-width: 640px) {
      .ticker-item { padding: .8rem 1.1rem; }
      .spark { width: 64px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ticker-track, .aurora, .gold-text { animation: none !important; }
      .reveal { opacity: 1; transform: none; transition: none; }
    }
  </style>
</head>

<body class="font-sans antialiased">
  <div class="bg-stage" aria-hidden="true">
    <div class="bg-grid"></div>
    <div class="aurora a1"></div>
    <div class="aurora a2"></div>
    <div class="aurora a3"></div>
    <div class="grain"></div>
  </div>

  <!-- Header -->
  <header class="site-header" id="siteHeader">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="h-[4.25rem] flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/temp/custom/img/logo.png" alt="Global Equinox Trade" class="h-8 w-auto transition-transform duration-300 group-hover:scale-105">
          <span class="hidden sm:block text-[0.95rem] font-semibold tracking-tight text-white" style="color:#172033">Global Equinox Trade</span>
        </a>

        <nav class="hidden lg:flex items-center gap-8">
          <a href="/" class="nav-link">Home</a>
          <a href="/markets" class="nav-link" aria-current="page">Markets</a>
          <a href="/platform" class="nav-link">Platform</a>
          <a href="/pricing" class="nav-link">Pricing</a>
          <a href="/education" class="nav-link">Education</a>
          <a href="/FAQ" class="nav-link">FAQ</a>
          <a href="/about" class="nav-link">About</a>
        </nav>

        <div class="hidden lg:flex items-center gap-3">
          <a href="/login" class="btn-ghost !py-2 !px-5 text-sm">Login</a>
          <a href="/signup" class="btn-gold !py-2 !px-5 text-sm">Start Trading</a>
        </div>

        <button id="menuBtn" aria-label="Toggle menu" class="lg:hidden h-10 w-10 rounded-xl border border-white/10 bg-white/5 flex items-center justify-center hover:bg-white/10 transition-colors" style="border-color:#e2e8f0;background:#f8fafc;color:#172033">
          <i data-lucide="menu" id="menuIcon"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile menu -->
  <div class="mobile-menu lg:hidden" id="mobileMenu">
    <div class="p-6 space-y-2">
      <a href="/" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="home"></i> Home</a>
      <a href="/markets" class="flex items-center gap-3 text-lg font-medium py-3" style="color:#8a6815"><i data-lucide="trending-up"></i> Markets</a>
      <a href="/platform" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="layout-dashboard"></i> Platform</a>
      <a href="/pricing" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="credit-card"></i> Pricing</a>
      <a href="/education" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="graduation-cap"></i> Education</a>
      <a href="/FAQ" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="help-circle"></i> FAQ</a>
      <a href="/about" class="flex items-center gap-3 text-lg font-medium py-3"><i data-lucide="info"></i> About</a>
      <div class="pt-6 mt-4 border-t border-white/10 space-y-3" style="border-color:#e2e8f0">
        <a href="/login" class="btn-ghost w-full">Login to Account</a>
        <a href="/signup" class="btn-gold w-full">Create Account</a>
      </div>
    </div>
  </div>

  <main>
    <!-- ================= HERO ================= -->
    <section id="hero" class="relative pt-[4.25rem]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-12 md:pt-20 md:pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7">
            <div class="eyebrow reveal"><span class="live-dot"></span> Global Financial Markets</div>
            <h1 class="reveal d1 mt-6 text-[2.4rem] leading-[1.06] sm:text-5xl lg:text-[3.8rem] font-bold tracking-tight" style="color:#172033">
              Explore global markets.<br>
              <span class="gold-text">Knowledge. Clarity. Preparation.</span>
            </h1>
            <p class="reveal d2 mt-6 text-lg max-w-xl leading-relaxed" style="color:#475569">
              Understand the markets, the instruments, and the risks before making a trading decision. Build familiarity with each asset class, review live prices, and compare the features that matter.
            </p>
            <div class="reveal d3 mt-8 flex flex-col sm:flex-row gap-3.5">
              <a href="/signup" class="btn-gold group text-[0.95rem]">
                Create Account
                <i data-lucide="arrow-right" class="transition-transform group-hover:translate-x-1"></i>
              </a>
              <a href="/risk-disclosure" class="btn-ghost text-[0.95rem]">
                <i data-lucide="shield-alert"></i> Read Risk Disclosure
