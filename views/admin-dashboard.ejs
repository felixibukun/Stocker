<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Admin Dashboard</title> <script src="https://cdn.tailwindcss.com"></script> <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script> <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script> <script> tailwind.config = { theme: { extend: { colors: { primary: '#4F46E5' } } } } </script>

 </head> <body class="bg-slate-950 text-white" x-data="{ open: true }"> <!-- SIDEBAR --> <aside class="fixed inset-y-0 left-0 bg-slate-950/95 border-r border-slate-800 backdrop-blur-xl transition-all duration-300 flex flex-col" :class="open ? 'w-64' : 'w-20'">
<!-- Brand -->
<div class="flex items-center gap-3 px-5 py-5 border-b border-slate-800">
  <img src="/temp/custom/img/logo1.png" class="h-9 w-auto">

  <div class="flex-1" x-show="open" x-transition>
    <p class="text-sm font-semibold">Admin Panel</p>
    <p class="text-[11px] text-slate-400">Global Equinox Trade</p>
  </div>

  <button
    class="h-9 w-9 flex items-center justify-center rounded-xl bg-slate-900 border border-slate-700"
    @click="open = !open">
    <i data-lucide="panel-left" class="w-4 h-4"></i>
  </button>
</div>

<!-- Menu -->
<nav class="mt-4 flex-1 px-2 space-y-1 text-sm">

  <a href="/admin"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-100 bg-primary/10 border border-primary/40">
    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Dashboard</span>
  </a>

  <a href="/admin/users"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
    <i data-lucide="users" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Users</span>
  </a>

  <a href="/admin/deposits"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
    <i data-lucide="wallet" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Deposits</span>
  </a>

  <a href="/admin/deposit/add"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
    <i data-lucide="plus-circle" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Add Deposit</span>
  </a>

  <a href="/admin/withdrawals"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
    <i data-lucide="banknote" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Withdrawals</span>
  </a>

  <a href="/admin/packages"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
    <i data-lucide="gift" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Packages</span>
  </a>
  <a href="/admin/profile"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
    <i data-lucide="settings" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Profile</span>
  </a>

</nav>

<!-- Bottom -->
<div class="px-4 py-4 border-t border-slate-800">
  <a href="/admin-logout"
     class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-red-600 text-sm font-semibold justify-center">
    <i data-lucide="log-out" class="w-4 h-4"></i>
    <span x-show="open" x-transition>Logout</span>
  </a>
</div>

</aside> <!-- MAIN CONTENT --> <div class="min-h-screen transition-all duration-300" :class="open ? 'ml-64' : 'ml-20'">
<!-- Top bar -->
<header class="h-16 border-b border-slate-800 bg-slate-950/90 backdrop-blur-xl flex items-center">
  <div class="max-w-6xl mx-auto w-full px-6 flex items-center justify-between">

    <div class="space-y-0.5">
      <p class="text-xs text-slate-400">Admin dashboard</p>
      <p class="text-sm font-semibold text-slate-100">
        Welcome
        <span class="text-primary">
          <%= admin && admin.username ? admin.username : 'Admin' %>
        </span>
      </p>
    </div>

    <div class="hidden sm:flex flex-col items-end text-xs">
      <span class="text-slate-400">Total users</span>
      <span class="text-slate-100 font-semibold"><%= users.length %></span>
    </div>

  </div>
</header>

<!-- Page body -->
<main class="max-w-6xl mx-auto w-full px-6 py-8 space-y-8">

  <!-- Big stats row -->
  <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">

<a href="/admin/users" class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg hover:border-primary/60 hover:bg-slate-900 transition">
<p class="text-xs text-slate-400 mb-2">Users</p>
<p class="text-3xl font-semibold mb-1"><%= users.length %></p>
<p class="text-xs text-slate-500">Total registered accounts</p>
</a>

<a href="/admin/withdrawals" class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg hover:border-primary/60 hover:bg-slate-900 transition">
<p class="text-xs text-slate-400 mb-2">Withdrawals</p>
<p class="text-3xl font-semibold mb-1">
<%= withdrawals.filter(w => w.status === 'pending').length %>
</p>
<p class="text-xs text-slate-500">Pending requests</p>
</a>

<a href="/admin/deposits" class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg hover:border-primary/60 hover:bg-slate-900 transition">
<p class="text-xs text-slate-400 mb-2">Deposits</p>
<p class="text-3xl font-semibold mb-1"><%= deposits.length %></p>
<p class="text-xs text-slate-500">Total deposit records</p>
</a>

<a href="/admin/kyc" class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg hover:border-primary/60 hover:bg-slate-900 transition">
<p class="text-xs text-slate-400 mb-2">KYC</p>
<p class="text-3xl font-semibold mb-1">
<%= kycRequests.filter(r => r.status === 'pending').length %>
</p>
<p class="text-xs text-slate-500">Pending verifications</p>
</a>

</section>

  <!-- Secondary row -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Quick actions -->
    <div class="lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg">
      <p class="text-sm font-semibold mb-4">Quick actions</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">

        <a href="/admin/deposit/add"
           class="flex items-center gap-3 px-4 py-3 rounded-xl bg-primary/10 border border-primary/40 hover:bg-primary/20">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>Manual deposit</span>
        </a>

        <a href="/admin/withdrawals"
           class="flex items-center gap-3 px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 hover:bg-slate-800">
          <i data-lucide="banknote" class="w-4 h-4"></i>
          <span>Review withdrawals</span>
        </a>
        <a href="/admin/deposit-methods" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
<i data-lucide="sliders" class="w-4 h-4"></i>
<span x-show="open" x-transition>Deposit methods</span>
</a>
<a href="/admin/payment-settings" class="flex items-center gap-3 px-4 py-2 hover:bg-gray-800 rounded">
  <i data-lucide="wallet"></i>
  <span>Payment Settings</span>
</a>

        <a href="/admin/kyc" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-slate-300 hover:bg-slate-900 hover:text-white">
<i data-lucide="id-card" class="w-4 h-4"></i>
<span x-show="open" x-transition>KYC</span>
</a>
        <a href="/admin/users"
           class="flex items-center gap-3 px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 hover:bg-slate-800">
          <i data-lucide="user-cog" class="w-4 h-4"></i>
          <span>Manage users</span>
        </a>

      </div>
    </div>

    <!-- Snapshot -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg space-y-3 text-xs">
      <p class="text-sm font-semibold mb-2">Snapshot</p>

      <div class="flex justify-between">
        <span class="text-slate-400">Users</span>
        <span class="text-slate-100 font-medium"><%= users.length %></span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-400">Pending withdrawals</span>
        <span class="text-amber-400 font-medium">
          <%= withdrawals.filter(w => w.status === 'pending').length %>
        </span>
      </div>

      <div class="flex justify-between">
        <span class="text-slate-400">Total deposits</span>
        <span class="text-emerald-400 font-medium">
          $<%= deposits.reduce((sum, d) => sum + (d.amount || 0), 0).toFixed(2) %>
        </span>
      </div>

    </div>

  </section>

</main>

</div> <script> document.addEventListener('DOMContentLoaded', function () { if (typeof lucide !== 'undefined') { lucide.createIcons() } }) </script> 
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>
</body> </html>