<!DOCTYPE html>
<html lang="en" x-data="{ sidebarOpen: false, currentTheme: 'dark' }">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Admin Nexus • Global Equinox Trade</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#6366F1',
            'primary-dark': '#4F46E5',
            'primary-glow': 'rgba(99, 102, 241, 0.2)'
          },
          fontFamily: {
            'sans': ['Inter', 'system-ui', 'ui-sans-serif', 'sans-serif']
          },
          animation: {
            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'glow': 'glow 2s ease-in-out infinite alternate',
            'slide-in': 'slideIn 0.2s ease-out'
          },
          keyframes: {
            glow: {
              '0%': { boxShadow: '0 0 2px rgba(99,102,241,0.3)' },
              '100%': { boxShadow: '0 0 12px rgba(99,102,241,0.6)' }
            },
            slideIn: {
              '0%': { opacity: '0', transform: 'translateY(4px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' }
            }
          },
          backdropBlur: {
            xs: '2px',
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap');
    * {
      font-family: 'Inter', system-ui, sans-serif;
    }
    .scrollbar-thin::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
      background: #0f172a;
      border-radius: 8px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 8px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
      background: #4f46e5;
    }
    .sidebar-transition {
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), width 0.25s ease;
    }
    .card-hover {
      transition: all 0.2s ease;
    }
    .card-hover:hover {
      transform: translateY(-2px);
      border-color: rgba(99, 102, 241, 0.3);
      box-shadow: 0 12px 20px -12px rgba(0, 0, 0, 0.5);
    }
    body {
      background: radial-gradient(circle at 10% 20%, rgba(15, 23, 42, 1) 0%, #020617 100%);
      overflow-x: hidden;
    }
    .glass-header {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(51, 65, 85, 0.5);
    }
    .stat-glow {
      position: relative;
    }
    .stat-glow::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 30% 20%, rgba(99,102,241,0.1), transparent 70%);
      pointer-events: none;
    }
    @media (max-width: 1024px) {
      .sidebar-closed-mobile {
        transform: translateX(-100%);
      }
    }
  </style>
</head>
<body class="text-white antialiased">

  <!-- Main layout -->
  <div class="flex min-h-screen relative">
    
    <!-- SIDEBAR (enhanced micro-interactions) -->
    <aside class="fixed lg:relative z-40 bg-slate-900/95 backdrop-blur-md border-r border-slate-800/80 h-screen flex flex-col sidebar-transition shadow-2xl"
           :class="sidebarOpen ? 'w-72 translate-x-0' : '-translate-x-full lg:translate-x-0 lg:w-24'">
      
      <!-- Brand area with logo animation -->
      <div class="flex items-center px-5 py-5 border-b border-slate-800/70 h-18">
        <div class="flex items-center gap-3 w-full">
          <div class="h-11 w-11 rounded-2xl bg-gradient-to-tr from-primary to-indigo-600 flex items-center justify-center flex-shrink-0 shadow-lg shadow-primary/20">
            <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
          </div>
          <div class="overflow-hidden" x-show="sidebarOpen" x-transition.duration.200ms>
            <p class="text-md font-bold tracking-tight bg-gradient-to-r from-white to-indigo-200 bg-clip-text text-transparent">Nexus Admin</p>
            <p class="text-[10px] text-slate-400 tracking-wide uppercase font-semibold">Global Equinox Trade</p>
          </div>
        </div>
      </div>
      
      <!-- navigation refined with tooltips for collapsed mode -->
      <nav class="mt-6 flex-1 px-3 space-y-1.5 overflow-y-auto scrollbar-thin">
        <a href="/admin" class="group flex items-center gap-3 px-3 py-3 rounded-xl text-white bg-primary/25 border border-primary/50 shadow-sm transition-all duration-200">
          <i data-lucide="layout-dashboard" class="w-5 h-5 flex-shrink-0"></i>
          <span class="whitespace-nowrap font-medium" x-show="sidebarOpen" x-transition>Dashboard</span>
          <span class="hidden lg:inline-block text-[11px] font-mono text-primary-300 opacity-0 group-hover:opacity-100 transition" x-show="!sidebarOpen">🏠</span>
        </a>

        <a href="/admin/users" class="group flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:bg-slate-800/70 hover:text-white transition-all hover:border hover:border-slate-700">
          <i data-lucide="users" class="w-5 h-5 flex-shrink-0"></i>
          <span class="whitespace-nowrap" x-show="sidebarOpen" x-transition>Users</span>
        </a>

        <a href="/admin/deposits" class="group flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:bg-slate-800/70 hover:text-white transition-all">
          <i data-lucide="wallet" class="w-5 h-5 flex-shrink-0"></i>
          <span class="whitespace-nowrap" x-show="sidebarOpen" x-transition>Deposits</span>
        </a>

        <a href="/admin/deposit/add" class="group flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:bg-slate-800/70 hover:text-white transition-all">
          <i data-lucide="plus-circle" class="w-5 h-5 flex-shrink-0"></i>
          <span class="whitespace-nowrap" x-show="sidebarOpen" x-transition>Add Deposit</span>
        </a>

        <a href="/admin/withdrawals" class="group flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:bg-slate-800/70 hover:text-white transition-all">
          <i data-lucide="banknote" class="w-5 h-5 flex-shrink-0"></i>
          <span class="whitespace-nowrap" x-show="sidebarOpen" x-transition>Withdrawals</span>
        </a>

        <a href="/admin/packages" class="group flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:bg-slate-800/70 hover:text-white transition-all">
          <i data-lucide="gift" class="w-5 h-5 flex-shrink-0"></i>
          <span class="whitespace-nowrap" x-show="sidebarOpen" x-transition>Packages</span>
        </a>

        <a href="/admin/profile" class="group flex items-center gap-3 px-3 py-3 rounded-xl text-slate-300 hover:bg-slate-800/70 hover:text-white transition-all">
          <i data-lucide="settings" class="w-5 h-5 flex-shrink-0"></i>
          <span class="whitespace-nowrap" x-show="sidebarOpen" x-transition>Profile</span>
        </a>
      </nav>
      
      <!-- logout area + extra vibe -->
      <div class="px-3 py-5 border-t border-slate-800/70 mt-auto">
        <a href="/admin-logout" 
           class="flex items-center gap-3 px-3 py-3 rounded-xl bg-gradient-to-r from-red-600/90 to-rose-600/90 text-sm font-semibold justify-center hover:from-red-700 hover:to-rose-700 transition-all shadow-md">
          <i data-lucide="log-out" class="w-4 h-4 flex-shrink-0"></i>
          <span class="whitespace-nowrap" x-show="sidebarOpen" x-transition>Secure logout</span>
        </a>
      </div>
    </aside>
    
    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 flex flex-col min-h-screen w-full transition-all duration-300">
      
      <!-- Premium Header with micro-interactions -->
      <header class="sticky top-0 z-30 h-16 glass-header flex items-center px-5 lg:px-7 shadow-sm">
        <div class="w-full flex items-center justify-between">
          <div class="flex items-center gap-4">
            <!-- Toggle buttons with microfeedback -->
            <button @click="sidebarOpen = !sidebarOpen"
                    class="lg:hidden h-10 w-10 flex items-center justify-center rounded-xl bg-slate-800/70 border border-slate-700 hover:bg-primary/30 hover:border-primary/40 transition-all">
              <i data-lucide="menu" class="w-5 h-5"></i>
            </button>
            
            <button @click="sidebarOpen = !sidebarOpen"
                    class="hidden lg:flex h-10 w-10 items-center justify-center rounded-xl bg-slate-800/50 border border-slate-700 hover:bg-primary/20 hover:border-primary/40 transition-all group">
              <i data-lucide="panel-left" class="w-5 h-5 transition-transform duration-300" :class="sidebarOpen ? 'rotate-180' : ''"></i>
            </button>
            
            <div class="space-y-0.5 border-l border-slate-800 pl-4 hidden sm:block">
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono text-primary-400 uppercase tracking-wider">✨ executive zone</span>
              </div>
              <p class="text-xs text-slate-300 font-medium">Welcome back, <span class="text-primary font-semibold">Administrator</span></p>
            </div>
          </div>
          
          <!-- Right side: live clock + stats badges -->
          <div class="flex items-center gap-5">
            <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-800/50 border border-slate-700/80 backdrop-blur-sm">
              <i data-lucide="cloud-sun" class="w-4 h-4 text-amber-300"></i>
              <span class="text-xs font-medium tracking-wide">🌤️ 27°C · Singapore</span>
            </div>
            
            <div class="hidden sm:flex items-center gap-5 bg-slate-900/40 px-3 py-1.5 rounded-2xl border border-slate-800/50">
              <div class="flex items-center gap-2">
                <div class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></div>
                <span class="text-xs text-slate-300">Live</span>
              </div>
              <div class="flex items-center gap-2 text-right">
                <i data-lucide="users" class="w-3.5 h-3.5 text-primary"></i>
                <span class="text-xs font-semibold"><%= users.length %></span>
              </div>
              <div class="w-px h-4 bg-slate-700"></div>
              <div class="flex items-center gap-2">
                <i data-lucide="bell-dot" class="w-3.5 h-3.5 text-amber-400"></i>
                <span class="text-xs font-semibold"><%= withdrawals.filter(w => w.status === 'pending').length %></span>
              </div>
            </div>
            
            <!-- avatar micro -->
            <div class="h-9 w-9 rounded-full bg-gradient-to-tr from-primary/30 to-indigo-600/30 flex items-center justify-center border border-primary/40">
              <i data-lucide="user-circle" class="w-5 h-5 text-primary"></i>
            </div>
          </div>
        </div>
      </header>
      
      <!-- MAIN DYNAMIC CONTENT with animations -->
      <main class="flex-1 p-5 lg:p-8 w-full space-y-8">
        
        <!-- Stats Grid with glassmorphism + hover effect -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-7 animate-slideIn">
          <!-- Users Card -->
          <div class="relative overflow-hidden bg-gradient-to-br from-slate-900/90 to-slate-950/90 backdrop-blur-sm border border-slate-800/60 rounded-2xl p-5 card-hover transition-all">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-3xl -z-0"></div>
            <div class="flex items-center justify-between mb-4">
              <div class="p-2.5 rounded-xl bg-primary/15 border border-primary/20">
                <i data-lucide="users" class="w-5 h-5 text-primary"></i>
              </div>
              <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/25 font-medium">+12%</span>
            </div>
            <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Total users</p>
            <p class="text-3xl lg:text-4xl font-bold tracking-tight"><%= users.length %></p>
            <p class="text-[11px] text-slate-500 mt-2 flex items-center gap-1"><i data-lucide="trending-up" class="w-3 h-3"></i> Active ecosystem</p>
          </div>
          
          <!-- Withdrawals Card -->
          <div class="relative overflow-hidden bg-gradient-to-br from-slate-900/90 to-slate-950/90 border border-slate-800/60 rounded-2xl p-5 card-hover">
            <div class="flex items-center justify-between mb-4">
              <div class="p-2.5 rounded-xl bg-amber-500/15">
                <i data-lucide="banknote" class="w-5 h-5 text-amber-400"></i>
              </div>
              <span class="text-xs px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/25">pending</span>
            </div>
            <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Withdrawals pending</p>
            <p class="text-3xl lg:text-4xl font-bold tracking-tight"><%= withdrawals.filter(w => w.status === 'pending').length %></p>
            <p class="text-[11px] text-slate-500 mt-2">awaiting approval</p>
          </div>
          
          <!-- Deposits Card -->
          <div class="relative overflow-hidden bg-gradient-to-br from-slate-900/90 to-slate-950/90 border border-slate-800/60 rounded-2xl p-5 card-hover">
            <div class="flex items-center justify-between mb-4">
              <div class="p-2.5 rounded-xl bg-emerald-500/15">
                <i data-lucide="wallet" class="w-5 h-5 text-emerald-400"></i>
              </div>
              <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-300">volume</span>
            </div>
            <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Deposit records</p>
            <p class="text-3xl lg:text-4xl font-bold tracking-tight"><%= deposits.length %></p>
            <p class="text-[11px] text-slate-500 mt-2">total transactions</p>
          </div>
          
          <!-- KYC Card -->
          <div class="relative overflow-hidden bg-gradient-to-br from-slate-900/90 to-slate-950/90 border border-slate-800/60 rounded-2xl p-5 card-hover">
            <div class="flex items-center justify-between mb-4">
              <div class="p-2.5 rounded-xl bg-sky-500/15">
                <i data-lucide="shield-check" class="w-5 h-5 text-sky-400"></i>
              </div>
              <span class="text-xs px-2.5 py-1 rounded-full bg-sky-500/15 text-sky-300">verification</span>
            </div>
            <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">KYC pending</p>
            <p class="text-3xl lg:text-4xl font-bold tracking-tight"><%= kycRequests.filter(k => k.status === 'pending').length %></p>
            <p class="text-[11px] text-slate-500 mt-2">need review</p>
          </div>
        </div>
        
        <!-- Charts & activity row (new visual upgrade) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Mini performance chart -->
          <div class="lg:col-span-2 bg-slate-900/70 backdrop-blur-sm border border-slate-800/70 rounded-2xl p-5 shadow-xl">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-semibold flex items-center gap-2"><i data-lucide="chart-line" class="w-4 h-4 text-primary"></i> Weekly activity trend</h3>
              <span class="text-[10px] text-slate-500">last 7 days</span>
            </div>
            <canvas id="activityChart" width="400" height="180" style="max-height: 200px; width: 100%"></canvas>
          </div>
          
          <!-- Recent Snapshot with live status -->
          <div class="bg-slate-900/70 backdrop-blur-sm border border-slate-800/70 rounded-2xl p-5">
            <h3 class="text-sm font-semibold flex items-center gap-2 mb-5"><i data-lucide="activity" class="w-4 h-4 text-primary"></i> Real-time snapshot</h3>
            <div class="space-y-5">
              <div class="flex items-center justify-between group p-2 rounded-xl hover:bg-slate-800/40 transition">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-lg bg-primary/10"><i data-lucide="users" class="w-3.5 h-3.5 text-primary"></i></div>
                  <span class="text-sm text-slate-200">Total registrations</span>
                </div>
                <span class="text-lg font-bold text-primary"><%= users.length %></span>
              </div>
              <div class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-800/40">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-lg bg-amber-500/10"><i data-lucide="clock" class="w-3.5 h-3.5 text-amber-400"></i></div>
                  <span class="text-sm text-slate-200">Pending withdrawals</span>
                </div>
                <span class="text-lg font-bold text-amber-400"><%= withdrawals.filter(w => w.status === 'pending').length %></span>
              </div>
              <div class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-800/40">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-lg bg-emerald-500/10"><i data-lucide="coins" class="w-3.5 h-3.5 text-emerald-400"></i></div>
                  <span class="text-sm text-slate-200">Deposit volume</span>
                </div>
                <span class="text-lg font-bold text-emerald-400">$<%= deposits.reduce((sum, d) => sum + Number(d.amount || 0), 0).toLocaleString() %></span>
              </div>
              <div class="border-t border-slate-800/50 my-2"></div>
              <div class="flex justify-between text-xs text-slate-400">
                <span>⚡ Last sync: just now</span>
                <span class="text-primary">✓ live</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Enhanced Quick Actions Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 bg-slate-900/60 backdrop-blur-sm border border-slate-800/60 rounded-2xl p-5">
            <div class="flex justify-between items-center mb-5">
              <h3 class="text-sm font-semibold flex items-center gap-2"><i data-lucide="zap" class="w-4 h-4 text-amber-400"></i> Command center</h3>
              <span class="text-[10px] text-slate-500">quick actions</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <a href="/admin/deposit/add" class="group block">
                <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-4 hover:border-primary/40 hover:bg-slate-800/70 transition-all">
                  <div class="flex items-center gap-3 mb-2">
                    <div class="p-2 rounded-lg bg-primary/20"><i data-lucide="plus-circle" class="w-4 h-4 text-primary"></i></div>
                    <span class="text-sm font-medium">Manual deposit</span>
                  </div>
                  <p class="text-xs text-slate-400">Instant credit</p>
                </div>
              </a>
              <a href="/admin/withdrawals" class="group block">
                <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-4 hover:border-amber-500/40 transition-all">
                  <div class="flex items-center gap-3 mb-2">
                    <div class="p-2 rounded-lg bg-amber-500/20"><i data-lucide="banknote" class="w-4 h-4 text-amber-400"></i></div>
                    <span class="text-sm font-medium">Review payouts</span>
                  </div>
                  <p class="text-xs text-slate-400">process pending</p>
                </div>
              </a>
              <a href="/admin/kyc" class="group block">
                <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-4 hover:border-sky-500/40 transition-all">
                  <div class="flex items-center gap-3 mb-2">
                    <div class="p-2 rounded-lg bg-sky-500/20"><i data-lucide="id-card" class="w-4 h-4 text-sky-400"></i></div>
                    <span class="text-sm font-medium">KYC checks</span>
                  </div>
                  <p class="text-xs text-slate-400"><%= kycRequests.filter(k => k.status === 'pending').length %> pending</p>
                </div>
              </a>
              <a href="/admin/payment-settings" class="group block">
                <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-4 hover:border-purple-500/40 transition-all">
                  <div class="flex items-center gap-3 mb-2"><div class="p-2 rounded-lg bg-purple-500/20"><i data-lucide="credit-card" class="w-4 h-4 text-purple-400"></i></div><span class="text-sm font-medium">Payment gateway</span></div>
                  <p class="text-xs text-slate-400">configure methods</p>
                </div>
              </a>
              <a href="/admin/users" class="group block">
                <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-4 hover:border-primary/40 transition-all">
                  <div class="flex items-center gap-3 mb-2"><div class="p-2 rounded-lg bg-primary/20"><i data-lucide="user-cog" class="w-4 h-4 text-primary"></i></div><span class="text-sm font-medium">User management</span></div>
                  <p class="text-xs text-slate-400">edit & view</p>
                </div>
              </a>
              <a href="/admin/deposit-methods" class="group block">
                <div class="bg-slate-800/40 border border-slate-700 rounded-xl p-4 hover:border-emerald-500/40 transition-all">
                  <div class="flex items-center gap-3 mb-2"><div class="p-2 rounded-lg bg-emerald-500/20"><i data-lucide="sliders" class="w-4 h-4 text-emerald-400"></i></div><span class="text-sm font-medium">Deposit methods</span></div>
                  <p class="text-xs text-slate-400">crypto & wire</p>
                </div>
              </a>
            </div>
          </div>
          
          <!-- mini upgrade: system health widget -->
          <div class="bg-gradient-to-br from-indigo-950/40 to-slate-900/70 border border-indigo-800/40 rounded-2xl p-5 backdrop-blur-sm">
            <h3 class="text-sm font-semibold flex items-center gap-2"><i data-lucide="server" class="w-4 h-4 text-indigo-400"></i> System health</h3>
            <div class="mt-4 space-y-3">
              <div class="flex justify-between text-xs"><span>API latency</span><span class="text-emerald-400">24ms</span></div>
              <div class="h-1.5 bg-slate-700 rounded-full overflow-hidden"><div class="w-3/4 h-full bg-emerald-500 rounded-full"></div></div>
              <div class="flex justify-between text-xs mt-2"><span>Database</span><span class="text-emerald-400">operational</span></div>
              <div class="h-1.5 bg-slate-700 rounded-full"><div class="w-full h-full bg-primary rounded-full"></div></div>
              <div class="flex justify-between text-xs mt-2"><span>Queue (withdrawals)</span><span class="text-amber-400"><%= withdrawals.filter(w => w.status === 'pending').length %></span></div>
              <div class="h-1.5 bg-slate-700 rounded-full"><div class="w-2/5 h-full bg-amber-500 rounded-full"></div></div>
            </div>
            <div class="mt-5 pt-3 border-t border-slate-800/60 text-[11px] text-slate-400 flex justify-between"><span>🔒 Encrypted tunnel</span><i data-lucide="shield" class="w-3 h-3"></i></div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof lucide !== 'undefined') lucide.createIcons();
      
      // Enhanced chart rendering
      const ctx = document.getElementById('activityChart')?.getContext('2d');
      if (ctx && typeof Chart !== 'undefined') {
        new Chart(ctx, {
          type: 'line',
          data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [{
              label: 'Transactions',
              data: [12, 19, 15, 22, 34, 28, 42],
              borderColor: '#6366F1',
              backgroundColor: 'rgba(99, 102, 241, 0.05)',
              borderWidth: 2,
              pointBackgroundColor: '#818CF8',
              pointBorderColor: '#1E293B',
              pointRadius: 3,
              pointHoverRadius: 6,
              tension: 0.3,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: { legend: { labels: { color: '#94A3B8', font: { size: 10 } } } },
            scales: { y: { grid: { color: '#1E293B' }, ticks: { color: '#CBD5E1' } }, x: { ticks: { color: '#94A3B8' } } }
          }
        });
      }
      
      // save sidebar state persistence (optional)
      const sidebarState = Alpine.reactive({ sidebarOpen: false });
      const saved = localStorage.getItem('adminSidebarUpgraded');
      if (saved !== null) sidebarState.sidebarOpen = saved === 'true';
      Alpine.effect(() => localStorage.setItem('adminSidebarUpgraded', sidebarState.sidebarOpen));
      
      // click outside for mobile
      document.addEventListener('click', (e) => {
        const sidebar = document.querySelector('aside');
        const toggleBtn = document.querySelector('button.lg\\:hidden');
        if (window.innerWidth < 1024 && sidebar && toggleBtn && !sidebar.contains(e.target) && !toggleBtn.contains(e.target)) {
          if (Alpine.store && Alpine.store('sidebar')) Alpine.store('sidebar', false);
          else if (window.Alpine && Alpine.reactive) sidebarState.sidebarOpen = false;
        }
      });
    });
  </script>
</body>
</html>