  <!-- PORTFOLIO TAB -->
  <div x-show="activeTab === 'portfolio'" class="space-y-6">

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

      <!-- TOTAL VALUE -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-12 w-12 rounded-lg bg-slate-800 flex items-center justify-center">
            <i data-lucide="dollar-sign" class="w-6 h-6 text-emerald-400"></i>
          </div>
          <div>
            <p class="text-sm text-slate-400">Total Value</p>
            <p class="text-2xl font-bold text-white">
              $<%= Number(user.balance * 1.5).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %>
            </p>
          </div>
        </div>
      </div>

      <!-- TODAY GAIN -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-12 w-12 rounded-lg bg-slate-800 flex items-center justify-center">
            <i data-lucide="trending-up" class="w-6 h-6 text-emerald-400"></i>
          </div>
          <div>
            <p class="text-sm text-slate-400">Today's Gain</p>
            <p class="text-2xl font-bold text-emerald-400">+$<%= (todayPL || 0).toFixed(2) %></p>
          </div>
        </div>
      </div>

      <!-- ALL TIME PNL -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-12 w-12 rounded-lg bg-slate-800 flex items-center justify-center">
            <i data-lucide="bar-chart-2" class="w-6 h-6 text-blue-400"></i>
          </div>
          <div>
            <p class="text-sm text-slate-400">All Time P&L</p>
            <p class="text-2xl font-bold <%= (totalPL || 0) >= 0 ? 'text-emerald-400' : 'text-red-400' %>">
              $<%= Math.abs(totalPL || 0).toFixed(2) %>
            </p>
          </div>
        </div>
      </div>

      <!-- WIN RATE -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="h-12 w-12 rounded-lg bg-slate-800 flex items-center justify-center">
            <i data-lucide="target" class="w-6 h-6 text-purple-400"></i>
          </div>
          <div>
            <p class="text-sm text-slate-400">Win Rate</p>
            <p class="text-2xl font-bold text-emerald-400"><%= winRate || 65 %>%</p>
          </div>
        </div>
      </div>

    </div>

    <!-- ALLOCATION + METRICS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
  <h3 class="text-lg font-semibold text-white mb-4">Stock Holdings</h3>

  <% if (!holdings || holdings.length === 0) { %>
    <p class="text-slate-400">No stocks held.</p>
  <% } else { %>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-800">
          <tr>
            <th class="text-left py-2">Stock</th>
            <th class="text-right py-2">Quantity</th>
            <th class="text-right py-2">Avg Price</th>
            <th class="text-right py-2">Value</th>
          </tr>
        </thead>

        <tbody>
          <% holdings.forEach(h => { %>
            <tr class="border-b border-slate-800/50">
              <td class="py-3 font-medium"><%= h.stockName %></td>
              <td class="py-3 text-right"><%= h.quantity %></td>
              <td class="py-3 text-right">$<%= Number(h.avgPrice).toFixed(2) %></td>
              <td class="py-3 text-right">
                $<%= (h.quantity * h.avgPrice).toFixed(2) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } %>
</div>

      <!-- PORTFOLIO ALLOCATION -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-semibold text-white mb-6">Portfolio Allocation</h3>

        <div class="space-y-4">
          <% const allocations = [
            { asset: 'Cryptocurrency', value: 65, color: 'bg-emerald-500' },
            { asset: 'Stocks', value: 25, color: 'bg-blue-500' },
            { asset: 'Forex', value: 8, color: 'bg-purple-500' },
            { asset: 'Commodities', value: 2, color: 'bg-amber-500' }
          ]; %>

          <% allocations.forEach(a => { %>

            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm text-slate-300"><%= a.asset %></span>
                <span class="text-sm font-medium text-white"><%= a.value %>%</span>
              </div>

              <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
                <div class="h-full <%= a.color %> rounded-full"
                     style="width: <%= a.value %>%;"></div>
              </div>
            </div>

          <% }) %>
        </div>
      </div>

      <!-- PERFORMANCE METRICS -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-lg font-semibold text-white mb-6">Performance Metrics</h3>

        <div class="space-y-6">

          <!-- SHARPE RATIO -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm text-slate-400">Sharpe Ratio</span>
              <span class="text-sm font-medium text-emerald-400">1.85</span>
            </div>
            <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 rounded-full" style="width:65%"></div>
            </div>
          </div>

          <!-- MAX DRAWDOWN -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm text-slate-400">Max Drawdown</span>
              <span class="text-sm font-medium text-amber-400">-8.5%</span>
            </div>
            <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-amber-500 rounded-full" style="width:42%"></div>
            </div>
          </div>

          <!-- VOLATILITY -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm text-slate-400">Volatility</span>
              <span class="text-sm font-medium text-blue-400">Medium</span>
            </div>
            <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-blue-500 rounded-full" style="width:55%"></div>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div> <!-- END PORTFOLIO TAB -->

</div> <!-- end max-w-7xl -->
</main>

<footer class="mt-8 py-6 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">

      <div class="text-sm text-slate-500">
        © 2015 Trader Panel. All rights reserved.
      </div>

      <div class="flex items-center gap-6 text-xs text-slate-500">
        <a href="/support" class="hover:text-slate-300">Support</a>
        <a href="/account" class="hover:text-slate-300">Privacy</a>
        <a href="/account" class="hover:text-slate-300">Terms</a>
        <a href="/account" class="hover:text-slate-300">Risk Disclosure</a>
      </div>

    </div>
  </div>
</footer>

</div> <!-- end main-content -->
</div> <!-- end full wrapper -->

<!-- QUICK TRADE MODAL -->
<div x-show="showTradeModal"
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm"
     style="display:none">

  <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6"
       @click.outside="showTradeModal = false">

    <div class="flex items-center justify-between mb-6">
      <h3 class="text-lg font-semibold text-white">Quick Trade</h3>
      <button @click="showTradeModal = false" class="text-slate-400 hover:text-white">
        <i data-lucide="x"></i>
      </button>
    </div>

    <form action="/trade/execute" method="POST" class="space-y-4">

      <div>
        <label class="block text-sm text-slate-400 mb-2">Symbol</label>
        <select x-model="quickTrade.symbol" name="symbol"
                class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg">
          <option value="BTC/USD">BTC/USD</option>
          <option value="ETH/USD">ETH/USD</option>
          <option value="AAPL">AAPL</option>
          <option value="TSLA">TSLA</option>
        </select>
      </div>

      <div>
        <label class="block text-sm text-slate-400 mb-2">Trade Side</label>
        <div class="flex gap-2">

          <label class="flex-1">
            <input type="radio" x-model="quickTrade.side" value="buy" name="side" class="peer hidden">
            <div class="p-3 text-center rounded-lg bg-slate-800 border border-slate-700
                        peer-checked:bg-emerald-500/20 peer-checked:border-emerald-500 cursor-pointer">
              <span class="text-sm text-white font-medium">Buy/Long</span>
            </div>
          </label>

          <label class="flex-1">
            <input type="radio" x-model="quickTrade.side" value="sell" name="side" class="peer hidden">
            <div class="p-3 text-center rounded-lg bg-slate-800 border border-slate-700
                        peer-checked:bg-red-500/20 peer-checked:border-red-500 cursor-pointer">
              <span class="text-sm text-white font-medium">Sell/Short</span>
            </div>
          </label>

        </div>
      </div>

      <div>
        <label class="block text-sm text-slate-400 mb-2">Amount ($)</label>
        <input type="number" x-model="quickTrade.amount" name="amount" min="10" step="10"
               class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg">
      </div>

      <div>
        <label class="block text-sm text-slate-400 mb-2">Order Type</label>

        <div class="flex gap-2">

          <label class="flex-1">
            <input type="radio" x-model="quickTrade.type" value="market" name="orderType" class="peer hidden">
            <div class="p-3 text-center rounded-lg bg-slate-800 border border-slate-700
                        peer-checked:bg-primary-500/20 peer-checked:border-primary-500 cursor-pointer">
              <span class="text-sm text-white font-medium">Market</span>
            </div>
          </label>

          <label class="flex-1">
            <input type="radio" x-model="quickTrade.type" value="limit" name="orderType" class="peer hidden">
            <div class="p-3 text-center rounded-lg bg-slate-800 border border-slate-700
                        peer-checked:bg-primary-500/20 peer-checked:border-primary-500 cursor-pointer">
              <span class="text-sm text-white font-medium">Limit</span>
            </div>
          </label>

        </div>
      </div>

      <button type="submit"
              class="w-full py-3 rounded-lg font-semibold text-white"
              :class="quickTrade.side === 'buy'
                      ? 'bg-emerald-600 hover:bg-emerald-700'
                      : 'bg-red-600 hover:bg-red-700'">

        <span x-text="quickTrade.side === 'buy' ? 'Execute Buy Order' : 'Execute Sell Order'"></span>
      </button>

    </form>

  </div>
</div>

<!-- ICONS INIT -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
</script>

<!-- SWEETALERT -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top-end',
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    background: '#0f172a',
    color: '#f8fafc'
  });
</script>
<% } %>

<!-- TRADINGVIEW WIDGET -->
<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script>
  new TradingView.widget({
    autosize: true,
    symbol: "BTCUSD",
    interval: "60",
    timezone: "Etc/UTC",
    theme: "dark",
    style: "1",
    locale: "en",
    toolbar_bg: "#0f172a",
    enable_publishing: false,
    hide_top_toolbar: false,
    hide_legend: false,
    container_id: "tradingview_chart"
  });
</script>

<!-- MARKET PRICE RANDOMIZER -->
<script>
function updatePrices() {
  document.querySelectorAll('.market-row').forEach(row => {
    const changeElement = row.querySelector('.px-2.py-1');
    if (!changeElement) return;

    const current = parseFloat(changeElement.textContent);
    const randomMove = (Math.random() - 0.5) * 0.2;
    const updated = current + randomMove;

    changeElement.textContent = (updated >= 0 ? '+' : '') + updated.toFixed(2) + '%';
    changeElement.className = `px-2 py-1 rounded-full text-xs font-medium ${
      updated >= 0 ? 'price-up' : 'price-down'
    }`;
  });
}

setInterval(updatePrices, 5000);
</script>

<!-- ORDER CONFIRMATION POPUP -->
<script>
document.addEventListener('submit', e => {

  if (
    e.target.matches('form[action="/trade/execute"]') ||
    e.target.matches('form[action="/trade/quick"]')
  ) {
    const data = new FormData(e.target);
    const side = data.get('side');
    const symbol = data.get('symbol');
    const amount = data.get('amount');

    Swal.fire({
      title: 'Order Executed',
      text: side.toUpperCase() + ' ' + amount + ' of ' + symbol + ' was placed',
      icon: 'success',
      confirmButtonText: 'OK',
      background: '#0f172a',
      color: '#f8fafc'
    });
  }
});
</script>

</body>
</html>