<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <title>Users</title> <script src="https://cdn.tailwindcss.com"></script> <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

 </head> <body class="bg-gray-900 text-white min-h-screen"> <div class="w-full bg-gray-800 p-4 flex items-center justify-between shadow"> <h1 class="text-xl font-semibold">Users</h1> <a href="/admin" class="bg-blue-600 px-4 py-2 rounded">Back</a> </div> <div class="p-6"> <h2 class="text-2xl font-semibold mb-6">All Users</h2>
<div class="overflow-x-auto">
  <table class="w-full text-left bg-gray-800 rounded-lg overflow-hidden">
    <thead class="bg-gray-700">
  <tr>
    <th class="px-4 py-3">Name</th>
    <th class="px-4 py-3">Username</th>
    <th class="px-4 py-3">Email</th>
    <th class="px-4 py-3">Phone</th>
    <th class="px-4 py-3">Country</th>
    <th class="px-4 py-3">Balance</th>
    <th class="px-4 py-3">Action</th>
  </tr>
</thead>

<tbody>
  <% users.forEach(u => { %>
    <tr class="border-b border-gray-700">
      <td class="px-4 py-3"><%= u.name %></td>
      <td class="px-4 py-3"><%= u.username %></td>
      <td class="px-4 py-3"><%= u.email %></td>

      <td class="px-4 py-3">
        <%= u.phone || 'N/A' %>
      </td>

      <td class="px-4 py-3"><%= u.country %></td>

      <td class="px-4 py-3">
        $<%= Number(u.balance || 0).toFixed(2) %>
      </td>

      <td class="px-4 py-3">
        <div class="flex items-center gap-2">

          <a href="/admin/user/<%= u.id %>/balance"
             class="bg-yellow-600 px-3 py-1 rounded text-xs">
            Edit Balance
          </a>

          <form
            action="/admin/user/<%= u.id %>/delete"
            method="POST"
            onsubmit="return confirm('Delete this user and all related data?')">
            <button
              type="submit"
              class="p-2 rounded bg-red-600 hover:bg-red-700 flex items-center justify-center"
              title="Delete user">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </form>

        </div>
      </td>
    </tr>
  <% }) %>
</tbody>
  </table>
</div>

</div> <script> document.addEventListener('DOMContentLoaded', function () { if (typeof lucide !== 'undefined') { lucide.createIcons() } }) </script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

</body> </html>