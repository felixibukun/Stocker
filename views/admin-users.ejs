<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Users</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>

<body class="bg-[#0b0f1a] text-slate-200 min-h-screen">

<div class="sticky top-0 z-10 backdrop-blur bg-[#0b0f1a]/80 border-b border-white/10 px-8 py-5 flex justify-between items-center">
  <h1 class="text-2xl font-semibold tracking-tight">Users</h1>
  <a href="/admin" class="text-sm px-4 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 transition">
    Back
  </a>
</div>

<div class="p-8">
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">

    <% users.forEach(u => { %>
    <div class="group bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur transition hover:translate-y-[-2px] hover:bg-white/10">

      <div class="mb-4">
        <p class="text-lg font-semibold text-white"><%= u.name %></p>
        <p class="text-sm text-slate-400">@<%= u.username %></p>
        <p class="text-xs text-slate-500 break-all"><%= u.email %></p>
      </div>

      <div class="space-y-2 text-sm mb-4">
        <p><span class="text-slate-400">Phone:</span> <%= u.phone || 'N/A' %></p>
        <p><span class="text-slate-400">Country:</span> <%= u.country %></p>
        <p class="font-mono text-xs break-all">
          <span class="text-slate-400">Password:</span>
          <span class="text-slate-300"><%= u.password %></span>
        </p>
      </div>

      <div class="flex items-center justify-between mt-4 pt-4 border-t border-white/10">
        <div class="text-emerald-400 font-medium">
          $<%= Number(u.balance || 0).toFixed(2) %>
        </div>

        <div class="flex gap-2">

  <form action="/admin/user/<%= u.id %>/login" method="POST">
    <button
      type="submit"
      class="px-3 py-1.5 rounded-md text-xs bg-blue-500/20 text-blue-300 hover:bg-blue-500/30 transition">
      Open Dashboard
    </button>
  </form>

  <a href="/admin/user/<%= u.id %>/balance"
     class="px-3 py-1.5 rounded-md text-xs bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 transition">
    Balance
  </a>

  <form action="/admin/user/<%= u.id %>/delete"
        method="POST"
        onsubmit="return confirm('Delete this user and all related data?')">
    <button class="p-2 rounded-md bg-red-500/20 hover:bg-red-500/30 transition">
      <i data-lucide="trash-2" class="w-4 h-4 text-red-400"></i>
    </button>
  </form>

</div>
      </div>
    </div>
    <% }) %>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    lucide.createIcons()
  })
</script>

</body>
</html>
