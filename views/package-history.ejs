<!DOCTYPE html>
<html class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Package History</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-950 text-white">

<header class="h-16 border-b border-slate-800 bg-slate-950/80 backdrop-blur-xl flex items-center">
  <div class="max-w-5xl mx-auto w-full px-4 flex justify-between">
    <p class="text-sm font-semibold">Package History</p>
    <a href="/dashboard" class="text-xs text-slate-300 hover:text-white">Back</a>
  </div>
</header>

<main class="max-w-5xl mx-auto px-4 py-8">
  <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5">
    <p class="text-sm font-semibold mb-4">Your Subscriptions</p>

    <% if (subs.length === 0) { %>
      <p class="text-xs text-slate-400">No subscriptions yet.</p>
    <% } else { %>

      <div class="space-y-3">
        <% subs.forEach(s => { %>
          <div class="border-b border-slate-800 pb-3 text-sm">
            <p class="text-slate-200"><%= s.package %></p>
            <p class="text-slate-400 text-xs">Price: $<%= s.price %></p>
            <p class="text-slate-500 text-xs">
              Subscribed: <%= new Date(s.subscribedAt).toLocaleString() %>
            </p>
          </div>
        <% }) %>
      </div>

    <% } %>
  </div>
</main>

</body>
</html>
