  <main class="relative">
    <!-- FAQ Hero Section -->
    <section class="relative pt-28 pb-16 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 rounded-full bg-primary-500/10 border border-primary-500/20 px-4 py-1.5 mb-6">
            <i data-lucide="help-circle" class="w-4 h-4 text-primary-400"></i>
            <span class="text-sm font-medium text-primary-300">Help Center</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            Frequently Asked <span class="gradient-text">Questions</span>
          </h1>
          <p class="text-lg text-slate-400 mb-8 max-w-2xl mx-auto">
            Find quick answers to common questions about trading, accounts, deposits, withdrawals, and more.
          </p>
          
          <!-- Search Bar -->
          <div class="faq-search relative max-w-2xl mx-auto mb-8">
            <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input type="text" placeholder="Search for answers..." id="faqSearch">
          </div>
          
          <!-- Quick Stats -->
          <div class="flex flex-wrap justify-center gap-6">
            <div class="flex items-center gap-2">
              <i data-lucide="check-circle" class="w-5 h-5 text-emerald-400"></i>
              <span class="text-slate-300">150+ Questions Answered</span>
            </div>
            <div class="flex items-center gap-2">
              <i data-lucide="clock" class="w-5 h-5 text-primary-400"></i>
              <span class="text-slate-300">Updated Daily</span>
            </div>
            <div class="flex items-center gap-2">
              <i data-lucide="headphones" class="w-5 h-5 text-slate-400"></i>
              <span class="text-slate-300">24/7 Support Available</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Categories & Content -->
    <section class="py-12 fade-section">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Category Tabs -->
        <div class="flex flex-wrap justify-center gap-3 mb-12">
          <div class="category-tab active" data-category="all">All Questions</div>
          <div class="category-tab" data-category="account">Account & Registration</div>
          <div class="category-tab" data-category="deposit">Deposits & Withdrawals</div>
          <div class="category-tab" data-category="trading">Trading Questions</div>
          <div class="category-tab" data-category="security">Security & Regulation</div>
          <div class="category-tab" data-category="technical">Technical Support</div>
        </div>
        
        <!-- FAQ Accordion -->
        <div class="faq-accordion" id="faqAccordion">
          
          <!-- Account & Registration -->
          <div class="faq-category" data-category="account">
            <div class="faq-item">
              <div class="faq-question">
                <h5>How do I open a trading account with Global Equinox Trade?</h5>
                <div class="faq-icon">
                  <i class="fas fa-chevron-down"></i>
                </div>
              </div>
              <div class="faq-answer">
                <p>Opening an account is quick and easy:</p>
                <ol class="list-decimal pl-5 space-y-1 mb-3">
                  <li>Click "Start Trading" in the top navigation</li>
                  <li>Fill in your personal details (name, email, phone)</li>
                  <li>Complete the trading experience questionnaire</li>
                  <li>Verify your email address</li>
                  <li>Upload required identification documents</li>
                  <li>Make your first deposit</li>
                  <li>Start trading!</li>
                </ol>
                <p>The entire process typically takes 10-15 minutes. Account verification is usually completed within 24 hours.</p>
              </div>
            </div>
            
            <div class="faq-item">
              <div class="faq-question">
                <h5>What documents do I need to verify my account?</h5>
                <div class="faq-icon">
                  <i class="fas fa-chevron-down"></i>
                </div>
              </div>
              <div class="faq-answer">
                <p>For account verification, we require:</p>
                <ul class="list-disc pl-5 space-y-1 mb-3">
                  <li><strong>Proof of Identity:</strong> Valid passport, driver's license, or national ID card</li>
                  <li><strong>Proof of Address:</strong> Recent utility bill, bank statement, or government letter (not older than 3 months)</li>
                  <li><strong>Proof of Payment:</strong> Copy of your credit/debit card (first 6 and last 4 digits visible) or bank account statement</li>
                </ul>
                <p>All documents must be clear, colored copies showing all four corners. For security reasons, we cannot accept screenshots of documents.</p>
              </div>
            </div>
            
            <div class="faq-item">
              <div class="faq-question">
                <h5>What is the minimum deposit required to start trading?</h5>
                <div class="faq-icon">
                  <i class="fas fa-chevron-down"></i>
                </div>
              </div>
              <div class="faq-answer">
                <p>The minimum deposit depends on your chosen account plan:</p>
                <ul class="list-disc pl-5 space-y-1 mb-3">
                  <li><strong>Starter Plan:</strong> $500 minimum deposit</li>
                  <li><strong>Advanced Plan:</strong> $5,000 minimum deposit</li>
                  <li><strong>Elite Plan:</strong> $50,000 minimum deposit</li>
                </ul>
                <p>We recommend starting with an amount you're comfortable with. You can always upgrade your account later as your trading grows.</p>
              </div>
            </div>
            
            <div class="faq-item">
              <div class="faq-question">
                <h5>Can I practice before trading with larger funds?</h5>
                <div class="faq-icon">
                  <i class="fas fa-chevron-down"></i>
                </div>
              </div>
              <div class="faq-answer">
                <p>Yes. New users can start with smaller position sizes and platform education before increasing activity. Practice mode guidance:</p>
                <ul class="list-disc pl-5 space-y-1 mb-3">
                  <li>Mirrors real market conditions</li>
                  <li>Includes all trading instruments</li>
                  <li>Provides access to all platform features</li>
                  <li>Helps users understand order flow before larger trades</li>
                  <li>Requires no deposit or commitment</li>
                </ul>
                <p>To begin, create an account and use the platform guides before funding your account.</p>
              </div>
            </div>
          </div>
          
          <!-- Deposits & Withdrawals -->
          <div class="faq-category" data-category="deposit">
            <div class="faq-item">
              <div class="faq-question">
                <h5>What payment methods do you accept for deposits?</h5>
                <div class="faq-icon">
                  <i class="fas fa-chevron-down"></i>
                </div>
              </div>
              <div class="faq-answer">
                <p>We accept multiple payment methods for your convenience:</p>
                <ul class="list-disc pl-5 space-y-1 mb-3">
                  <li><strong>Credit/Debit Cards:</strong> Visa, Mastercard, Maestro</li>
                  <li><strong>Bank Wire Transfer:</strong> Domestic and international transfers</li>
                  <li><strong>E-Wallets:</strong> Skrill, Neteller, PayPal, WebMoney</li>
                  <li><strong>Crypto Payments:</strong> Bitcoin, Ethereum, USDT, USDC</li>
                  <li><strong>Local Payment Methods:</strong> Available based on your region</li>
                </ul>
                <p>Most deposits are processed instantly (except bank wires which take 1-3 business days).</p>
              </div>
            </div>
            
            <div class="faq-item">
              <div class="faq-question">
                <h5>How long do withdrawals take to process?</h5>
                <div class="faq-icon">
                  <i class="fas fa-chevron-down"></i>
                </div>
              </div>
              <div class="faq-answer">
