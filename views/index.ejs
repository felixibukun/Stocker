  background-image: linear-gradient(120deg,#987015,#c49a25,#8a6815) !important;
}
.icon-chip { color: #987015 !important; }
.icon-chip.green { color: #047857 !important; }

.ticker-bar {
  background: #fff !important;
  border-color: #e2e8f0 !important;
}
.ticker-bar .border-white\/10,
.ticker-bar .bg-ink-900\/80 {
  background: #f1f5f9 !important;
  border-color: #e2e8f0 !important;
}
.ticker-item { border-color: #e2e8f0 !important; }
.chg { background: #f1f5f9 !important; color: #475569 !important; }
.chg.is-up { color: #047857 !important; background: #d1fae5 !important; }
.chg.is-down { color: #be123c !important; background: #ffe4e6 !important; }

.field {
  background: #fff !important;
  color: #172033 !important;
  border-color: #cbd5e1 !important;
}
.field::placeholder { color: #94a3b8 !important; }
.chip {
  color: #334155 !important;
  background: #f1f5f9 !important;
  border-color: #e2e8f0 !important;
}
.price-ring::before { opacity: .55; }

.light-image-section {
  display: grid;
  grid-template-columns: minmax(0,1fr) minmax(0,1fr);
  gap: 2rem;
  align-items: center;
  padding: 2rem;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  box-shadow: 0 16px 44px rgba(15,23,42,.06);
}
.light-image-section img {
  display: block;
  width: 100%;
  height: 330px;
  object-fit: cover;
  border-radius: 18px;
}
.light-image-section h2 { color: #172033; }
.light-image-section p { color: #475569; line-height: 1.8; }
@media(max-width:700px) {
  .light-image-section {
    grid-template-columns: 1fr;
    padding: 1.25rem;
  }
  .light-image-section img { height: 240px; }
}

/* ===== Image gallery ===== */
.gallery-card {
  overflow: hidden;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  box-shadow: 0 12px 32px rgba(15,23,42,.07);
  transition: transform .25s ease, box-shadow .25s ease;
}
.gallery-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 40px rgba(15,23,42,.12);
}
.gallery-card img {
  display: block;
  width: 100%;
  height: 245px;
  object-fit: cover;
  background: #eef2f7;
}
.gallery-caption { padding: 1.25rem; }
.gallery-caption h3 {
  color: #172033;
  font-size: 1.15rem;
  font-weight: 700;
}
.gallery-caption p {
  margin-top: .5rem;
  color: #475569;
  line-height: 1.7;
}

/* ===== Bitcoin, Gold and Forex image cards ===== */
.asset-photo-card {
  position: relative;
  overflow: hidden;
  min-height: 300px;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 12px 32px rgba(15,23,42,.08);
  transition: transform .25s ease, box-shadow .25s ease;
}
.asset-photo-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 42px rgba(15,23,42,.13);
}
.asset-photo-card img {
  display: block;
  width: 100%;
  height: 210px;
  object-fit: cover;
  background: #f1f5f9;
}
.asset-photo-card .asset-info { padding: 20px; }
.asset-photo-card h3 {
  color: #172033;
  font-size: 1.2rem;
  font-weight: 700;
}
.asset-photo-card p {
  margin-top: 7px;
  color: #64748b;
  line-height: 1.65;
}
.asset-photo-card .asset-label {
  display: inline-block;
  margin-bottom: 10px;
  padding: 5px 10px;
  border-radius: 999px;
  background: #fff7df;
  color: #8a6815;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

/* ===== Contact section ===== */
.contact-section {
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  color: #172033;
}
.contact-heading {
  max-width: 760px;
  margin: 0 auto 42px;
  text-align: center;
}
.contact-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 9px 14px;
  border: 1px solid #ead9a5;
  border-radius: 999px;
  color: #8a6815;
  background: #fff9e8;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
}
.contact-eyebrow svg { width: 16px; height: 16px; }
.contact-heading h2 {
  margin-top: 20px;
  color: #172033;
  font-size: clamp(2rem, 4vw, 3.25rem);
  line-height: 1.12;
  font-weight: 800;
  letter-spacing: -.035em;
}
.contact-heading > p {
  margin-top: 18px;
  color: #64748b;
  font-size: 17px;
  line-height: 1.8;
}
.contact-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}
.contact-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 28px;
  border: 1px solid #e2e8f0;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 12px 32px rgba(15,23,42,.055);
  transition: transform .25s ease, box-shadow .25s ease;
}
.contact-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(15,23,42,.10);
}
.contact-icon {
  display: flex;
  width: 52px;
  height: 52px;
  align-items: center;
  justify-content: center;
  border: 1px solid #f0dfae;
  border-radius: 15px;
  background: #fff8e6;
  color: #987015;
}
.contact-icon svg { width: 24px; height: 24px; }
.contact-card h3 {
  margin-top: 22px;
  color: #172033;
  font-size: 20px;
  font-weight: 700;
}
.contact-card > p {
  margin-top: 10px;
  color: #64748b;
  line-height: 1.8;
}
.contact-note {
  margin-top: 18px;
  color: #64748b;
  font-size: 13px;
}
.contact-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  margin-top: 22px;
  padding: 12px 18px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: linear-gradient(135deg, #f1d99a, #d4af37);
  color: #1a1405 !important;
  font-weight: 700;
  text-decoration: none;
  transition: filter .2s ease, transform .2s ease;
}
.contact-button:hover { filter: brightness(1.04); transform: translateY(-1px); }
.contact-button svg { width: 17px; height: 17px; }
.contact-button-outline {
  border-color: #e2e8f0;
  background: #fff;
  color: #172033 !important;
}
.contact-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
