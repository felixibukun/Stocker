  <!-- Back to top -->
  <button id="backToTop" aria-label="Back to top" style="color:#fff;background:#0e1626" class="fixed bottom-6 left-6 z-50 h-11 w-11 rounded-full border border-white/10 backdrop-blur flex items-center justify-center hover:border-gold-500/50 transition-all opacity-0 invisible">
    <i data-lucide="chevron-up"></i>
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const icons = () => { if (window.lucide) lucide.createIcons(); };
      icons();
      window.addEventListener('load', icons);

      document.getElementById('currentYear').textContent = new Date().getFullYear();

      /* ---------- Mobile menu ---------- */
      const menuBtn = document.getElementById('menuBtn');
      const menu = document.getElementById('mobileMenu');
      const menuIcon = document.getElementById('menuIcon');
      const setMenu = (open) => {
        menu.classList.toggle('open', open);
        menuIcon.setAttribute('data-lucide', open ? 'x' : 'menu');
        icons();
      };
      menuBtn.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
      menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); });

      /* ---------- Header hide/show + back-to-top ---------- */
      const header = document.getElementById('siteHeader');
      const toTop = document.getElementById('backToTop');
      let lastY = 0;
      window.addEventListener('scroll', () => {
        const y = window.pageYOffset || document.documentElement.scrollTop;
        header.classList.toggle('is-hidden', y > 120 && y > lastY);
        lastY = y;
        const show = y > 400;
        toTop.style.opacity = show ? '1' : '0';
        toTop.style.visibility = show ? 'visible' : 'hidden';
      }, { passive: true });
      toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      /* ---------- Smooth anchor offset ---------- */
      document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', function (e) {
          const id = this.getAttribute('href');
          if (id === '#') return;
          const el = document.querySelector(id);
          if (!el) return;
          e.preventDefault();
          window.scrollTo({ top: el.getBoundingClientRect().top + window.pageYOffset - 72, behavior: 'smooth' });
        });
      });

      /* ---------- Reveal on scroll ---------- */
      const io = new IntersectionObserver((entries) => {
        entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add('visible'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));

      /* ---------- Count-up ---------- */
      const co = new IntersectionObserver((entries) => {
        entries.forEach(en => {
          if (!en.isIntersecting) return;
          const el = en.target; co.unobserve(el);
          const target = parseFloat(el.dataset.count);
          const dec = parseInt(el.dataset.decimals || '0', 10);
          const suffix = el.dataset.suffix || '';
          const t0 = performance.now(), dur = 1400;
          const tick = (now) => {
            const p = Math.min(1, (now - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = (target * eased).toFixed(dec) + (p === 1 ? suffix : '');
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach(el => co.observe(el));

      /* ---------- Spotlight hover ---------- */
      document.querySelectorAll('.spot').forEach(card => {
        card.addEventListener('pointermove', e => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          card.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });

      /* ======================================================
         LIVE CRYPTO — moving ticker + hero panel
         Data: /api/crypto-ticker -> { prices: [{symbol, price, changePercent}] }
         Fallback: Binance public API (only if your endpoint fails)
         ====================================================== */
      const COINS = [
        { sym: 'BTC/USD', name: 'Bitcoin',  bn: 'BTCUSDT', icon: '₿', bg: 'linear-gradient(135deg,#f7931a,#c26a00)' },
        { sym: 'ETH/USD', name: 'Ethereum', bn: 'ETHUSDT', icon: 'Ξ', bg: 'linear-gradient(135deg,#7c8cff,#4455d6)' },
        { sym: 'BNB/USD', name: 'BNB',      bn: 'BNBUSDT', icon: '◆', bg: 'linear-gradient(135deg,#f3ba2f,#b88611)' },
        { sym: 'SOL/USD', name: 'Solana',   bn: 'SOLUSDT', icon: '◎', bg: 'linear-gradient(135deg,#9945ff,#14f195)' },
        { sym: 'XRP/USD', name: 'XRP',      bn: 'XRPUSDT', icon: '✕', bg: 'linear-gradient(135deg,#5b6578,#2a3244)' }
      ];
      const MAX_POINTS = 48;
      const state = {};
      COINS.forEach(c => state[c.sym] = { price: null, change: null, hist: [] });

      const fmt = (v) => {
        const d = v >= 1000 ? 2 : v >= 1 ? 3 : 4;
        return '$' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: d });
      };

      /* Build ticker (two identical sets for seamless loop) */
      const track = document.getElementById('tickerTrack');
      const itemHTML = (c) => `
        <div class="ticker-item" data-sym="${c.sym}">
          <div class="coin-badge" style="background:${c.bg}">${c.icon}</div>
          <div class="flex flex-col leading-tight">
            <span class="text-[0.8rem] font-semibold text-white">${c.name}</span>
            <span class="mono text-[0.68rem] text-slate-500">${c.sym}</span>
          </div>
          <span class="mono text-[0.95rem] font-semibold text-white" data-price>--</span>
          <span class="chg mono" data-change>--</span>
          <svg class="spark hidden sm:block" viewBox="0 0 100 32" preserveAspectRatio="none" data-spark><polyline points="0,16 100,16" stroke="rgba(15,23,42,.18)"/></svg>
        </div>`;
      const setHTML = COINS.map(itemHTML).join('');
      track.innerHTML = `<div class="ticker-set">${setHTML}</div><div class="ticker-set" aria-hidden="true">${setHTML}</div>`;

      /* Hero panel rows (all coins except BTC, which is featured) */
      document.getElementById('panelRows').innerHTML = COINS.slice(1).map(c => `
        <div class="flex items-center justify-between py-3" data-sym="${c.sym}">
          <div class="flex items-center gap-3 min-w-0">
            <div class="coin-badge !w-8 !h-8" style="background:${c.bg}">${c.icon}</div>
            <div class="min-w-0">
              <p class="text-sm font-medium text-white leading-tight">${c.name}</p>
              <p class="mono text-[0.68rem] text-slate-500">${c.sym}</p>
            </div>
          </div>
          <svg class="spark !w-16 mx-2 hidden sm:block" viewBox="0 0 100 32" preserveAspectRatio="none" data-spark><polyline points="0,16 100,16" stroke="rgba(15,23,42,.18)"/></svg>
          <div class="text-right">
            <p class="mono text-sm font-semibold text-white" data-price>--</p>
            <span class="chg mono inline-block mt-0.5" data-change>--</span>
          </div>
        </div>`).join('');

      const drawSpark = (svg, hist, up) => {
        if (!svg || hist.length < 2) return;
        const min = Math.min(...hist), max = Math.max(...hist), span = (max - min) || 1;
        const pts = hist.map((v, i) => {
          const x = (i / (hist.length - 1)) * 100;
          const y = 30 - ((v - min) / span) * 28;
          return x.toFixed(2) + ',' + y.toFixed(2);
        }).join(' ');
        svg.innerHTML = `<polyline points="${pts}" stroke="${up ? '#059669' : '#e11d48'}"/>`;
      };

      const render = (sym, prev) => {
        const s = state[sym];
        if (s.price == null) return;
        const up = s.change == null ? true : s.change >= 0;
        document.querySelectorAll(`[data-sym="${sym}"]`).forEach(row => {
          const p = row.querySelector('[data-price]');
          const ch = row.querySelector('[data-change]');
          const sp = row.querySelector('[data-spark]');
          if (p) {
            p.textContent = fmt(s.price);
            if (prev != null && prev !== s.price) {
              const cls = s.price > prev ? 'flash-up' : 'flash-down';
              p.classList.remove('flash-up', 'flash-down');
              void p.offsetWidth;
              p.classList.add(cls);
            }
          }
          if (ch && s.change != null) {
            ch.textContent = (s.change > 0 ? '+' : '') + s.change.toFixed(2) + '%';
            ch.classList.toggle('is-up', s.change >= 0);
            ch.classList.toggle('is-down', s.change < 0);
            ch.setAttribute('aria-label', '24-hour change ' + s.change.toFixed(2) + ' percent');
          }
          drawSpark(sp, s.hist, up);
        });
      };

      /* Data sources */
      const fromOwnApi = async () => {
        const r = await fetch('/api/crypto-ticker', { cache: 'no-store', headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error('ticker api ' + r.status);
        const j = await r.json();
        if (!Array.isArray(j.prices)) throw new Error('bad ticker data');
        return j.prices.map(p => ({ symbol: p.symbol, price: Number(p.price), change: Number(p.changePercent) }));
      };
      const fromBinance = async () => {
        const list = encodeURIComponent(JSON.stringify(COINS.map(c => c.bn)));
        const r = await fetch('https://api.binance.com/api/v3/ticker/24hr?symbols=' + list, { cache: 'no-store' });
        if (!r.ok) throw new Error('binance ' + r.status);
        const j = await r.json();
        return j.map(t => {
          const c = COINS.find(x => x.bn === t.symbol);
          return c ? { symbol: c.sym, price: Number(t.lastPrice), change: Number(t.priceChangePercent) } : null;
        }).filter(Boolean);
      };

      let lastOk = 0;
      const stamp = document.getElementById('lastUpdated');

      async function refresh() {
        let rows;
        try { rows = await fromOwnApi(); }
        catch (e1) {
          try { rows = await fromBinance(); }
          catch (e2) { console.warn('Live prices unavailable:', e2.message); return; }
        }
        rows.forEach(r => {
          const s = state[r.symbol];
          if (!s || !Number.isFinite(r.price)) return;
          const prev = s.price;
          s.price = r.price;
          if (Number.isFinite(r.change)) s.change = r.change;
          s.hist.push(r.price);
          if (s.hist.length > MAX_POINTS) s.hist.shift();
          render(r.symbol, prev);
        });
        lastOk = Date.now();
        stamp.textContent = 'Updated ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }

      /* Seed sparklines with the last 24 hourly closes (best-effort, silent on failure) */
      async function seedHistory() {
        await Promise.allSettled(COINS.map(async c => {
          const r = await fetch(`https://api.binance.com/api/v3/klines?symbol=${c.bn}&interval=1h&limit=24`);
          if (!r.ok) return;
          const k = await r.json();
          state[c.sym].hist = k.map(x => Number(x[4])).filter(Number.isFinite);
        }));
      }

      seedHistory().finally(refresh);
      setInterval(refresh, 15000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden && Date.now() - lastOk > 15000) refresh(); });
    });
  </script>

