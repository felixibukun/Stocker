.glass {
  background: linear-gradient(145deg,#fff,#f8fafc) !important;
  border: 1px solid #e2e8f0 !important;
  box-shadow: 0 16px 44px rgba(15,23,42,.07) !important;
  backdrop-filter: blur(12px);
}
.text-white { color: #172033 !important; }
.text-slate-300 { color: #334155 !important; }
.text-slate-400 { color: #475569 !important; }
.text-slate-500 { color: #64748b !important; }
.text-slate-600 { color: #475569 !important; }

.coin-badge { color: #fff !important; }
.btn-gold { color: #1a1405 !important; }
.btn-ghost {
  color: #172033 !important;
