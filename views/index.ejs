  <title>Global Equinox Trade | Professional Forex, Crypto & Stocks Trading</title>
  <meta name="description" content="Trade global markets with confidence. Professional trading platform for Forex, Cryptocurrency, Stocks, and Indices with transparent pricing and real-time analytics.">
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif']
          },
          colors: {
            primary: {
              50: '#f0f2ff',
              100: '#e0e7ff',
              400: '#818cf8',
              500: '#6366F1',
              600: '#4F46E5',
              700: '#4338CA',
              800: '#3730a3'
            },
            success: {
              400: '#34d399',
              500: '#10b981',
              600: '#059669'
            },
            warning: {
              400: '#fbbf24',
              500: '#f59e0b'
            },
            danger: {
              400: '#f87171',
              500: '#ef4444'
            }
          },
          backgroundImage: {
            'gradient-radial': 'radial-gradient(var(--tw-gradient-stops))',
            'grid-slate': 'radial-gradient(circle at 1px 1px, rgba(148,163,184,0.15) 1px, transparent 0)',
            'gradient-primary': 'linear-gradient(135deg, #4F46E5 0%, #7c3aed 100%)',
            'gradient-success': 'linear-gradient(135deg, #10b981 0%, #34d399 100%)'
          },
          animation: {
            'fade-in': 'fadeIn 0.8s ease-out',
            'slide-up': 'slideUp 0.6s ease-out',
            'slide-in-left': 'slideInLeft 0.7s ease-out',
            'slide-in-right': 'slideInRight 0.7s ease-out',
            'pulse-subtle': 'pulseSubtle 2s ease-in-out infinite',
            'float': 'float 3s ease-in-out infinite',
            'gradient-shift': 'gradientShift 3s ease infinite',
            'typing': 'typing 3.5s steps(40, end)',
            'blink-caret': 'blinkCaret .75s step-end infinite',
            'marquee': 'marquee 25s linear infinite',
            'spin-slow': 'spin 3s linear infinite'
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0' },
              '100%': { opacity: '1' }
            },
            slideUp: {
              '0%': { transform: 'translateY(30px)', opacity: '0' },
              '100%': { transform: 'translateY(0)', opacity: '1' }
            },
            slideInLeft: {
              '0%': { transform: 'translateX(-30px)', opacity: '0' },
              '100%': { transform: 'translateX(0)', opacity: '1' }
            },
            slideInRight: {
              '0%': { transform: 'translateX(30px)', opacity: '0' },
              '100%': { transform: 'translateX(0)', opacity: '1' }
            },
            pulseSubtle: {
              '0%, 100%': { opacity: '1' },
              '50%': { opacity: '0.8' }
            },
            float: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-10px)' }
            },
            gradientShift: {
              '0%, 100%': { backgroundPosition: '0% 50%' },
              '50%': { backgroundPosition: '100% 50%' }
            },
            typing: {
              'from': { width: '0' },
              'to': { width: '100%' }
            },
            blinkCaret: {
              'from, to': { borderColor: 'transparent' },
              '50%': { borderColor: 'currentColor' }
            },
            marquee: {
              '0%': { transform: 'translateX(0)' },
              '100%': { transform: 'translateX(-50%)' }
            }
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js" defer></script>
  <style>
    /* Custom Styles */
    :root {
      --header-height: 4rem;
    }
    
    * {
      -webkit-tap-highlight-color: transparent;
    }
    
    body {
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      background: #0f172a;
    }
    
    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    
    ::-webkit-scrollbar-track {
      background: rgba(30, 41, 59, 0.4);
      border-radius: 4px;
    }
    
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #4F46E5, #7c3aed);
      border-radius: 4px;
    }
    
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, #4338CA, #6d28d9);
    }
    
    /* Lucide icons */
    i[data-lucide] {
      width: 16px;
      height: 16px;
      stroke-width: 1.7;
      display: inline-block;
      vertical-align: middle;
    }
    
    /* Hover effects */
    .card-hover {
      transition: all 0.3s ease;
    }
    
    .card-hover:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.3);
    }
    
    /* Gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #4F46E5 0%, #7c3aed 50%, #34d399 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradientShift 3s ease infinite;
    }
    
    /* Glow effects */
    .glow-primary {
      box-shadow: 0 0 40px rgba(79, 70, 229, 0.4);
    }
    
    .glow-success {
      box-shadow: 0 0 40px rgba(16, 185, 129, 0.4);
    }
    
    /* Section animations */
    .fade-section {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    
    .fade-section.visible {
      opacity: 1;
      transform: translateY(0);
    }
    
    /* Button animations */
    .btn-pulse {
      animation: pulseSubtle 2s infinite;
    }
    
    /* Sticky header */
    .sticky-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      backdrop-filter: blur(12px);
      background: rgba(15, 23, 42, 0.92);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      transform: translateY(0);
      transition: transform 0.3s ease;
    }
    
    .sticky-header.hidden {
      transform: translateY(-100%);
    }
    
    /* Mobile menu */
    .mobile-menu {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(15, 23, 42, 0.98);
      backdrop-filter: blur(20px);
      z-index: 999;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .mobile-menu.open {
      transform: translateX(0);
    }
    
    /* Market ticker */
    .ticker-container {
      mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    }
    
    /* Testimonial carousel */
    .testimonial-track {
      display: flex;
      animation: scrollTestimonials 30s linear infinite;
    }
    
    @keyframes scrollTestimonials {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-100% - 1rem));
      }
    }
    
    /* Loading skeleton */
    .skeleton {
      background: linear-gradient(90deg, #1e293b 25%, #334155 50%, #1e293b 75%);
      background-size: 200% 100%;
      animation: skeleton-loading 1.5s infinite;
    }
    
    @keyframes skeleton-loading {
      0% {
        background-position: 200% 0;
      }
      100% {
        background-position: -200% 0;
      }
    }
    
    /* Noise texture */
    .noise-overlay {
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.15'/%3E%3C/svg%3E");
      opacity: 0.1;
      pointer-events: none;
      mix-blend-mode: overlay;
    }
    
    section {
      padding-bottom: 40px;
    }
    
    /* Chart styles */
    .chart-container {
      height: 200px;
      background: linear-gradient(180deg, rgba(79, 70, 229, 0.1) 0%, transparent 100%);
    }
    
    /* Trading terminal styles */
    .order-book {
      max-height: 300px;
      overflow-y: auto;
    }
    
    .order-book::-webkit-scrollbar {
      width: 4px;
    }
    
    .order-book::-webkit-scrollbar-thumb {
      background: rgba(79, 70, 229, 0.5);
      border-radius: 2px;
    }
    
    /* TradingView widget wrapper */
    .tradingview-widget {
      min-height: 400px;
      border-radius: 12px;
      overflow: hidden;
    }
    
    /* Trading pair badges */
    .pair-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 500;
    }
    
    /* Live price indicator */
    .price-update {
      animation: pricePulse 1s ease-in-out;
    }
    
    @keyframes pricePulse {
      0% { background-color: transparent; }
      50% { background-color: rgba(16, 185, 129, 0.2); }
      100% { background-color: transparent; }
    }
    
    /* Trading levels */
    .support-level {
      border-left: 2px solid #10b981;
      padding-left: 8px;
    }
    
    .resistance-level {
      border-left: 2px solid #ef4444;
      padding-left: 8px;
    }
    
    /* Trading tools grid */
    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
    }
    
    /* Market sentiment indicator */
    .sentiment-meter {
      height: 6px;
      background: linear-gradient(to right, #ef4444 0%, #f59e0b 50%, #10b981 100%);
      border-radius: 3px;
      position: relative;
    }
    
    .sentiment-indicator {
      position: absolute;
      top: -4px;
      width: 14px;
      height: 14px;
      background: white;
      border-radius: 50%;
      transform: translateX(-50%);
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
    }
  </style>
</head>
