            <li><a href="#markets" class="text-slate-400 hover:text-white transition-colors">Cryptocurrency</a></li>
            <li><a href="#markets" class="text-slate-400 hover:text-white transition-colors">Stocks</a></li>
            <li><a href="#markets" class="text-slate-400 hover:text-white transition-colors">Indices</a></li>
