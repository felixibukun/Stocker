<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Global Equinox Trade | Professional Forex, Crypto & Stocks Trading</title>
  <meta name="description" content="Trade global markets with confidence. Professional trading platform for Forex, Cryptocurrency, Stocks, and Indices with transparent pricing and real-time analytics.">
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['DM Sans', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace', 'monospace']
          },
          colors: {
            ink: { 950: '#05080f', 900: '#070b14', 850: '#0a101c', 800: '#0e1626', 700: '#16213a' },
            gold: { 300: '#f1d99a', 400: '#e6c36a', 500: '#d4af37', 600: '#b8932a' },
            up: '#2ee6a6',
            down: '#ff6b81'
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script>

  <style>
    :root {
      --gold: #d4af37;
      --gold-soft: #e6c36a;
      --up: #2ee6a6;
      --down: #ff6b81;
      --line: rgba(255,255,255,.08);
      --header-h: 4.25rem;
    }
    * { -webkit-tap-highlight-color: transparent; }
    html { scroll-behavior: smooth; }
    body {
      background: #05080f;
      color: #e8ecf5;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      font-feature-settings: "ss01", "cv11";
    }
    ::selection { background: rgba(212,175,55,.35); color: #fff; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #070b14; }
    ::-webkit-scrollbar-thumb { background: linear-gradient(#d4af37, #8a6d1c); border-radius: 4px; }

    i[data-lucide] { width: 18px; height: 18px; stroke-width: 1.6; display: inline-block; vertical-align: middle; }

    .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

    /* ---------- Background ---------- */
    .bg-stage { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; background: #05080f; }
    .bg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
      background-size: 56px 56px;
      -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 30%, transparent 75%);
              mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, #000 30%, transparent 75%);
    }
    .aurora { position: absolute; border-radius: 9999px; filter: blur(110px); opacity: .55; will-change: transform; }
    .aurora.a1 { width: 620px; height: 620px; top: -220px; left: 8%; background: radial-gradient(circle, rgba(212,175,55,.32), transparent 65%); animation: drift1 22s ease-in-out infinite; }
    .aurora.a2 { width: 560px; height: 560px; top: 8%; right: -140px; background: radial-gradient(circle, rgba(46,230,166,.18), transparent 65%); animation: drift2 26s ease-in-out infinite; }
    .aurora.a3 { width: 700px; height: 700px; bottom: -300px; left: -160px; background: radial-gradient(circle, rgba(79,70,229,.2), transparent 65%); animation: drift1 30s ease-in-out infinite reverse; }
    @keyframes drift1 { 0%,100% { transform: translate(0,0) } 50% { transform: translate(60px,40px) } }
    @keyframes drift2 { 0%,100% { transform: translate(0,0) } 50% { transform: translate(-50px,60px) } }
    .grain {
      position: absolute; inset: 0; opacity: .07; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }

    /* ---------- Header ---------- */
    .site-header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      backdrop-filter: blur(16px) saturate(140%);
      -webkit-backdrop-filter: blur(16px) saturate(140%);
      background: rgba(5,8,15,.65);
      border-bottom: 1px solid var(--line);
      transition: transform .35s ease, background .3s ease;
    }
    .site-header.is-hidden { transform: translateY(-100%); }
    .nav-link { position: relative; font-size: .875rem; font-weight: 500; color: #a7b0c4; transition: color .2s; padding: .25rem 0; }
    .nav-link::after { content: ""; position: absolute; left: 0; bottom: -4px; height: 1px; width: 0; background: linear-gradient(90deg, var(--gold), transparent); transition: width .3s ease; }
    .nav-link:hover { color: #fff; }
    .nav-link:hover::after { width: 100%; }

    .mobile-menu {
      position: fixed; top: var(--header-h); left: 0; right: 0; bottom: 0; z-index: 999;
      background: rgba(5,8,15,.97); backdrop-filter: blur(20px);
      transform: translateX(100%); transition: transform .3s cubic-bezier(.4,0,.2,1);
      overflow-y: auto;
    }
    .mobile-menu.open { transform: translateX(0); }

    /* ---------- Buttons ---------- */
    .btn-gold {
      position: relative; display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
      padding: .85rem 1.6rem; border-radius: 14px; font-weight: 600; color: #1a1405;
      background: linear-gradient(135deg, #f1d99a 0%, #d4af37 55%, #b8932a 100%);
      box-shadow: 0 8px 30px -8px rgba(212,175,55,.55), inset 0 1px 0 rgba(255,255,255,.5);
      transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 14px 40px -8px rgba(212,175,55,.7), inset 0 1px 0 rgba(255,255,255,.5); filter: brightness(1.05); }
    .btn-ghost {
      display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
      padding: .85rem 1.6rem; border-radius: 14px; font-weight: 500; color: #e8ecf5;
      background: rgba(255,255,255,.04); border: 1px solid var(--line);
      transition: background .25s ease, border-color .25s ease, transform .25s ease;
    }
    .btn-ghost:hover { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.18); transform: translateY(-2px); }

    /* ---------- Cards ---------- */
    .glass {
      background: linear-gradient(160deg, rgba(255,255,255,.055), rgba(255,255,255,.015));
      border: 1px solid var(--line);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      border-radius: 24px;
    }
    .spot { position: relative; overflow: hidden; transition: transform .35s ease, border-color .35s ease; }
    .spot::before {
      content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .35s ease;
      background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(212,175,55,.13), transparent 45%);
    }
    .spot:hover { transform: translateY(-4px); border-color: rgba(212,175,55,.35); }
    .spot:hover::before { opacity: 1; }

    .icon-chip {
      width: 46px; height: 46px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(145deg, rgba(212,175,55,.18), rgba(212,175,55,.04));
      border: 1px solid rgba(212,175,55,.28); color: var(--gold-soft);
    }
    .icon-chip.green { background: linear-gradient(145deg, rgba(46,230,166,.16), rgba(46,230,166,.03)); border-color: rgba(46,230,166,.26); color: var(--up); }

    .eyebrow {
      display: inline-flex; align-items: center; gap: .5rem; padding: .4rem .9rem; border-radius: 9999px;
      font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
      color: var(--gold-soft); background: rgba(212,175,55,.08); border: 1px solid rgba(212,175,55,.22);
    }
    .gold-text {
      background: linear-gradient(120deg, #f6e7b8 0%, #e6c36a 35%, #d4af37 60%, #f1d99a 100%);
      background-size: 200% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
      animation: sheen 6s linear infinite;
    }
    @keyframes sheen { to { background-position: 200% center; } }

    /* ---------- Reveal ---------- */
    .reveal { opacity: 0; transform: translateY(26px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); }
    .reveal.visible { opacity: 1; transform: none; }
    .d1 { transition-delay: .08s } .d2 { transition-delay: .16s } .d3 { transition-delay: .24s } .d4 { transition-delay: .32s }

    /* ---------- Live markets ---------- */
    .live-dot { width: 8px; height: 8px; border-radius: 9999px; background: var(--up); position: relative; display: inline-block; }
    .live-dot::after { content: ""; position: absolute; inset: -4px; border-radius: 9999px; border: 1px solid var(--up); animation: ping 1.8s cubic-bezier(0,0,.2,1) infinite; }
    @keyframes ping { 0% { transform: scale(.6); opacity: .9 } 100% { transform: scale(1.8); opacity: 0 } }

    .ticker-bar {
      position: relative; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
      background: linear-gradient(90deg, rgba(10,16,28,.9), rgba(14,22,38,.75), rgba(10,16,28,.9));
      backdrop-filter: blur(14px);
    }
    .ticker-viewport {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
              mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    }
    .ticker-track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
    .ticker-bar:hover .ticker-track { animation-play-state: paused; }
    @keyframes marquee { to { transform: translateX(-50%); } }
    .ticker-set { display: flex; flex-shrink: 0; }
    .ticker-item {
      display: flex; align-items: center; gap: .85rem; padding: 1rem 1.6rem; white-space: nowrap;
      border-right: 1px solid var(--line);
    }
    .coin-badge {
      width: 30px; height: 30px; border-radius: 9999px; display: flex; align-items: center; justify-content: center;
      font-size: .8rem; font-weight: 700; color: #fff; flex-shrink: 0;
    }
    .chg { font-size: .75rem; font-weight: 600; padding: .15rem .5rem; border-radius: 8px; background: rgba(255,255,255,.06); color: #a7b0c4; }
    .chg.is-up { color: var(--up); background: rgba(46,230,166,.12); }
    .chg.is-down { color: var(--down); background: rgba(255,107,129,.12); }
    .flash-up { animation: flashUp .9s ease; }
    .flash-down { animation: flashDown .9s ease; }
    @keyframes flashUp { 0% { color: var(--up); text-shadow: 0 0 14px rgba(46,230,166,.7); } 100% { color: inherit; text-shadow: none; } }
    @keyframes flashDown { 0% { color: var(--down); text-shadow: 0 0 14px rgba(255,107,129,.7); } 100% { color: inherit; text-shadow: none; } }
    .spark { width: 84px; height: 28px; overflow: visible; }
    .spark polyline { fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
    .spark-lg { width: 100%; height: 72px; }

    .float-y { animation: floaty 6s ease-in-out infinite; }
    @keyframes floaty { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-8px) } }

    /* ---------- Misc ---------- */
    .divider-glow { height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,.4), transparent); }
    .step-num {
      font-family: 'JetBrains Mono', monospace; font-size: .8rem; font-weight: 600; color: var(--gold-soft);
      width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
      border: 1px solid rgba(212,175,55,.3); background: rgba(212,175,55,.08);
    }
    .field {
      width: 100%; padding: .85rem 1rem; border-radius: 14px; color: #fff;
      background: rgba(5,8,15,.7); border: 1px solid var(--line); outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .field::placeholder { color: #5d677d; }
    .field:focus { border-color: rgba(212,175,55,.6); box-shadow: 0 0 0 3px rgba(212,175,55,.14); }
    .chip { display: inline-flex; padding: .25rem .65rem; border-radius: 9999px; font-size: .72rem; font-weight: 500; color: #b9c1d3; background: rgba(255,255,255,.05); border: 1px solid var(--line); }
    .price-ring { position: relative; }
    .price-ring::before {
      content: ""; position: absolute; inset: 0; padding: 1px; border-radius: inherit;
      background: linear-gradient(160deg, rgba(212,175,55,.7), rgba(212,175,55,.05) 40%, rgba(46,230,166,.25));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
              mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      pointer-events: none;
    }

    @media (max-width: 640px) {
      .ticker-item { padding: .8rem 1.1rem; }
      .spark { width: 64px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ticker-track, .aurora, .float-y, .gold-text { animation: none !important; }
      .reveal { opacity: 1; transform: none; transition: none; }
    }

/* ===== Light theme refresh ===== */
html, body {
  background: #f7f8fc !important;
  color: #172033 !important;
}
.bg-stage {
  background: #f7f8fc !important;
}
.bg-grid {
  background-image:
    linear-gradient(rgba(15,23,42,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15,23,42,.045) 1px, transparent 1px) !important;
}
.aurora { opacity: .16 !important; }
.grain { opacity: .025 !important; }

.site-header {
  background: rgba(255,255,255,.94) !important;
  border-bottom: 1px solid #e5e7eb !important;
}
.nav-link { color: #475569 !important; }
