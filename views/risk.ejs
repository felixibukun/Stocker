<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Risk Disclosure | Global Equinox Trade</title>
  <link rel="icon" type="image/png" href="/temp/custom/img/logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .risk-card {
      background: linear-gradient(145deg, rgba(120, 53, 15, 0.1) 0%, rgba(30, 41, 59, 0.7) 100%);
      border: 1px solid rgba(251, 146, 60, 0.2);
      border-radius: 12px;
      transition: all 0.3s ease;
    }
    
    .risk-card:hover {
      border-color: rgba(251, 146, 60, 0.4);
      transform: translateY(-2px);
    }
    
    .critical-card {
      background: linear-gradient(145deg, rgba(185, 28, 28, 0.15) 0%, rgba(30, 41, 59, 0.7) 100%);
      border: 2px solid rgba(239, 68, 68, 0.3);
    }
    
    .warning-pulse {
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }
    
    .risk-meter {
      height: 8px;
      background: linear-gradient(90deg, #10b981 0%, #f59e0b 50%, #ef4444 100%);
      border-radius: 4px;
      position: relative;
    }
    
    .risk-meter::after {
      content: '';
      position: absolute;
      width: 16px;
      height: 16px;
      background: white;
      border: 2px solid #ef4444;
      border-radius: 50%;
      top: -4px;
      right: 20%;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    }
    
    .fade-in {
      animation: fadeIn 0.6s ease-out;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body class="bg-slate-950 text-slate-200 font-sans min-h-screen flex flex-col">

