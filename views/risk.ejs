                  <th class="text-left py-3 px-4 text-slate-400 font-medium">1% Move For</th>
                  <th class="text-left py-3 px-4 text-slate-400 font-medium">1% Move Against</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800">
                <tr>
                  <td class="py-3 px-4 font-medium text-white">1:10</td>
