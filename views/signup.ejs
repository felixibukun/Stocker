<option>Vietnam</option>
<option>Yemen</option>
<option>Zambia</option>
<option>Zimbabwe</option>

            </select>
          </div>

          <!-- STEP 3 -->
          <div x-show="currentStep === 2" x-transition>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

              <div>
                <label class="text-xs text-slate-300">Password</label>
                <input type="password" name="password" required minlength="8"
                       class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-3 py-2.5 text-sm focus:ring-primary-600 focus:border-primary-600"
                       placeholder="At least 8 characters">
              </div>

              <div>
                <label class="text-xs text-slate-300">Confirm Password</label>
                <input type="password" name="password_confirmation" required
                       class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-3 py-2.5 text-sm focus:ring-primary-600 focus:border-primary-600"
                       placeholder="Repeat password">
              </div>

            </div>

            <div class="flex items-start gap-3 mt-4">
              <input type="checkbox" required class="h-4 w-4 mt-1">
              <p class="text-xs text-slate-300">I agree to the Terms and Policy</p>
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex justify-between mt-8">
            <button type="button"
                    x-show="currentStep > 0"
                    @click="previousStep()"
                    class="px-5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm">
              Back
            </button>

            <button type="button"
                    x-show="currentStep < steps.length - 1"
                    @click="nextStep()"
                    class="px-7 py-2.5 rounded-xl bg-primary-600 text-sm font-semibold text-white">
              Continue
            </button>

            <button type="submit"
                    x-show="currentStep === steps.length - 1"
                    class="px-7 py-2.5 rounded-xl bg-emerald-600 text-sm font-semibold text-white">
              Create Account
            </button>
          </div>

        </form>

        <!-- Footer -->
        <p class="text-center text-sm text-slate-400 mt-6">
          Already have an account?
          <a href="/login" class="text-primary-600 font-semibold">Login</a>
        </p>

      </div>
    </div>
  </div>

  <script>
    function signupForm() {
      return {
        currentStep: 0,
        steps: [
          { label: 'Details' },
          { label: 'Location' },
          { label: 'Security' }
        ],
        nextStep() {
          if (this.currentStep < this.steps.length - 1) {
            this.currentStep++;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        },
        previousStep() {
          if (this.currentStep > 0) {
            this.currentStep--;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        }
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
    });

    document.addEventListener('alpine:updated', () => {
      lucide.createIcons();
    });
  </script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (toast) { %>
<script>
  Swal.fire({
    icon: '<%= toast.type %>',
    title: '<%= toast.message %>',
    toast: true,
    position: 'top',
    showConfirmButton: false,
    timer: 2500
  })
</script>
<% } %>

</body>
</html>
