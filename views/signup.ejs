<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: true }" :class="{ 'dark': darkMode }" class="dark h-full">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create Trading Account</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            primary: {
              600: '#4F46E5'
            }
          }
        }
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <style>
    body { overflow-x: hidden; }
    [x-cloak] { display: none !important; }
  </style>
</head>

<body class="min-h-screen bg-slate-950 text-white font-sans">

  <!-- Background Effects -->
  <div class="fixed inset-0 pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900"></div>
    <div class="absolute -top-32 -left-32 w-72 h-72 bg-primary-600/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -right-10 w-80 h-80 bg-cyan-500/25 rounded-full blur-3xl"></div>
  </div>

  <!-- Main Container -->
  <div class="relative min-h-screen flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-3xl">

      <!-- Glass Card -->
      <div class="relative rounded-3xl bg-slate-900/70 border border-slate-700 backdrop-blur-xl shadow-xl px-6 sm:px-10 py-10"
           x-data="signupForm()" x-cloak>

        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <div class="flex items-center gap-3">
            <img src="temp/custom/img/logo.png" class="h-10 w-auto" alt="Logo">
            <div>
              <p class="text-xs text-slate-400">Broker Registration</p>
              <h1 class="text-xl font-semibold">Create Your Account</h1>
            </div>
          </div>
        </div>

        <!-- Steps -->
        <div class="grid grid-cols-3 gap-4 mb-10">
          <template x-for="(step, index) in steps" :key="index">
            <div class="flex flex-col items-center">
              <div class="h-9 w-9 rounded-full flex items-center justify-center text-xs font-bold border transition-all"
                   :class="{
                     'bg-primary-600 text-white border-primary-600': currentStep === index,
                     'bg-emerald-600 text-white border-emerald-600': currentStep > index,
                     'bg-slate-800 border-slate-600 text-slate-400': currentStep < index
                   }">
                <span x-show="currentStep <= index" x-text="index + 1"></span>
                <i data-lucide='check' x-show="currentStep > index" class="w-4 h-4"></i>
              </div>
              <p class="text-xs mt-2" x-text="step.label"></p>
            </div>
          </template>
        </div>

        <!-- Form -->
        <form action="/signup" method="POST" class="space-y-6">

          <!-- STEP 1 -->
          <div x-show="currentStep === 0" x-transition>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

              <div>
                <label class="text-xs text-slate-300">Username</label>
                <div class="mt-1 relative">
                  <input type="text" name="username" required
                         class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-3 py-2.5 text-sm focus:ring-primary-600 focus:border-primary-600"
                         placeholder="trader007">
                </div>
              </div>

              <div>
                <label class="text-xs text-slate-300">Full Name</label>
                <div class="mt-1 relative">
                  <input type="text" name="name" required
                         class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-3 py-2.5 text-sm focus:ring-primary-600 focus:border-primary-600"
                         placeholder="Your full name">
                </div>
              </div>

              <div>
                <label class="text-xs text-slate-300">Email</label>
                <div class="mt-1 relative">
                  <input type="email" name="email" required
                         class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-3 py-2.5 text-sm focus:ring-primary-600 focus:border-primary-600"
              placeholder="you@company.com">
                </div>
              </div>

              <div>
                <label class="text-xs text-slate-300">Phone</label>
                <div class="mt-1 relative">
                  <input type="tel" name="phone" required
                         class="w-full bg-slate-900/80 border border-slate-700 rounded-xl px-3 py-2.5 text-sm focus:ring-primary-600 focus:border-primary-600"
                         placeholder="+1 (555) 123-4567">
                </div>
              </div>

            </div>
          </div>

          <!-- STEP 2 -->
          <div x-show="currentStep === 1" x-transition>
            <label class="text-xs text-slate-300">Country</label>
            <select name="country" required
                    class="w-full mt-1 bg-slate-900/80 border border-slate-700 rounded-xl px-3 py-2.5 text-sm focus:ring-primary-600 focus:border-primary-600">
              <option value="" disabled selected>Select country</option>
              <option>Afghanistan</option>
<option>Albania</option>
